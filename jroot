CEOF
    # -std=gnu11 and no _FORTIFY_SOURCE keep the symbol requirements old: this
    # .so is built against the HOST libc but loaded inside the JAIL, so a single
    # modern symbol (glibc >= 2.38 redirects strtol to __isoc23_strtol) makes
    # every jail with an older libc fail to exec anything at all.
    # Keeping DT_NEEDED libdl.so.2 matters for the same reason: on jails older
    # than glibc 2.34 that is where dlsym lives (on newer ones it is a stub).
    local cflags="-shared -fPIC -O2 -std=gnu11 -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0"
    # Link attempts, in order: keep DT_NEEDED libdl (glibc 2.34+), plain -ldl
    # (older glibc), then nothing at all (musl has dlsym in libc and no libdl).
    if gcc $cflags -o "$PORT_SHIM" "$src" -Wl,--no-as-needed -l:libdl.so.2 2>/dev/null \
       || gcc $cflags -o "$PORT_SHIM" "$src" -ldl 2>/dev/null \
       || gcc $cflags -o "$PORT_SHIM" "$src" 2>/dev/null; then
        log "Built port shim: $PORT_SHIM"
        shim_glibc_floor_warn
        return 0
    fi
    warn "Failed to build port shim. 'jroot port', 'jroot net' and /proc hiding will not work."
    return 1
}

# Highest GLIBC_x.y the built shim needs. Jails older than this cannot preload
# it, and jroot falls back to building the shim inside the jail instead.
shim_glibc_max() {
    command -v objdump >/dev/null 2>&1 || return 1
    objdump -p "$PORT_SHIM" 2>/dev/null \
        | sed -n 's/.*GLIBC_\([0-9][0-9.]*\).*/\1/p' \
        | sort -t. -k1,1n -k2,2n -k3,3n | tail -n1
}

shim_glibc_floor_warn() {
    local v
    v="$(shim_glibc_max 2>/dev/null || true)"
    [ -n "$v" ] || return 0
    # 2.17 is the floor that still covers Ubuntu 16.04 jails; anything higher
    # means the host toolchain leaked a newer symbol into the shim.
    case "$v" in
        2.[0-9]|2.1[0-7]) return 0 ;;
    esac
    warn "Shim needs glibc >= $v; jails older than that will build their own copy instead."
}

# ---------------------------------------------------------------------------
# Which shim does a jail get?
#
# libjroot.so is compiled on the HOST but dlopen'd by the JAIL's dynamic loader
# through LD_PRELOAD, so the two libcs have to agree. A host newer than the jail
# (glibc 2.39 host, 22.04 jail) means the host-built shim cannot load, and
# preloading it anyway breaks every command in the jail:
#   /bin/bash: libc.so.6: version `GLIBC_2.38' not found (required by libjroot.so)
# The shim is deliberately built against an old symbol set (see build_port_shim)
# so one copy covers Ubuntu 16.04 through 26.04, and in practice musl jails too -
# but that is verified per jail at runtime rather than assumed.
#
# Resolution order, cached per jail in ~/.jroot/.shim.<name>:
#   1. a shim built inside the jail (always ABI-correct)
#   2. the host shim, if it actually loads there (probed once)
#   3. build one inside the jail with its own gcc
#   4. no shim: the jail still works, minus per-jail address / ports / /proc hiding
# ---------------------------------------------------------------------------
jail_local_shim() {
    printf '%s' "$ROOTS_DIR/$1/usr/local/lib/libjroot.so"
}

# Can the jail's loader preload the host-built shim, and does it actually take
# effect there? Exit status alone is not enough: a loader that fails to bind the
# preload can still run the command, leaving the shim silently inert. So the
# probe checks an observable side effect - the shim hides directory entries named
# ".jroot" - using nothing but `ls`, which every image has.
# Runs proot directly (not run_in_jail) to stay out of the resolution path.
shim_probe() {
    local name="$1"
    local rootfs="$ROOTS_DIR/$name"
    local out rc=0 dir
    [ -x "$PROOT_BIN" ] || return 1
    [ -x "$PORT_SHIM" ] || return 1
    dir="$rootfs/tmp/.jroot-shimprobe"
    rm -rf "$dir" 2>/dev/null
    mkdir -p "$dir/.jroot" 2>/dev/null || return 1
    : > "$dir/canary" 2>/dev/null
    out="$("$PROOT_BIN" -k "$PROOT_KERNEL_RELEASE" -0 -w / -r "$rootfs" \
        -b /dev -b /proc -b /sys -b "$PORT_SHIM:/usr/local/lib/libjroot.so" \
        /usr/bin/env LD_PRELOAD=/usr/local/lib/libjroot.so \
        /bin/ls -a1 /tmp/.jroot-shimprobe 2>&1)" || rc=1
    rm -rf "$dir" 2>/dev/null
    [ "$rc" = 0 ] || return 1
    case "$out" in
        *"not found"*|*"cannot open shared object"*|*"undefined symbol"*|\
        *"Error relocating"*|*"Error loading"*|*"unsupported relocation"*) return 1 ;;
    esac
    # The listing must have worked at all...
    printf '%s\n' "$out" | grep -qFx 'canary' || return 1
    # ...and the shim must have hidden the .jroot entry.
    printf '%s\n' "$out" | grep -qFx '.jroot' && return 1
    return 0
}

# Compile the shim with the jail's own toolchain. Fixes both the old-glibc case
# and musl, when the jail has gcc (build_essential, or build-base on Alpine).
build_shim_in_jail() {
    local name="$1"
    local rootfs="$ROOTS_DIR/$name"
    local so
    so="$(jail_local_shim "$name")"
    [ -f "$PORT_SHIM_SRC" ] || return 1
    SHIM_RESOLVING=1 run_in_jail --root "$name" /bin/sh -c \
        'command -v gcc >/dev/null 2>&1' >/dev/null 2>&1 || return 1
    mkdir -p "$rootfs/tmp" "$rootfs/usr/local/lib" 2>/dev/null || true
    cp "$PORT_SHIM_SRC" "$rootfs/tmp/libjroot.c" 2>/dev/null || return 1
    log "Building the jroot shim inside '$name' (its libc differs from the host's)..."
    SHIM_RESOLVING=1 run_in_jail --root "$name" /bin/sh -c \
        'CF="-shared -fPIC -O2 -std=gnu11 -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0"
         OUT=/usr/local/lib/libjroot.so
         gcc $CF -o $OUT /tmp/libjroot.c -Wl,--no-as-needed -l:libdl.so.2 2>/dev/null \
             || gcc $CF -o $OUT /tmp/libjroot.c -ldl 2>/dev/null \
             || gcc $CF -o $OUT /tmp/libjroot.c' >/dev/null 2>&1 || {
        rm -f "$rootfs/tmp/libjroot.c"
        return 1
    }
    rm -f "$rootfs/tmp/libjroot.c"
    [ -s "$so" ] || return 1
    log "Shim built inside '$name'."
    return 0
}

# Read-only view of the shim decision for a jail: local | host | none | unknown.
# Never probes and never builds, so it is safe for `jroot doctor` and `list`.
shim_status() {
    local name="$1" so marker
    so="$(jail_local_shim "$name")"
    if [ -s "$so" ] && grep -qa "$SHIM_VERSION" "$so" 2>/dev/null; then
        printf 'local'
        return 0
    fi
    marker="$JROOT_HOME/.shim.$name"
    if [ -f "$marker" ] && [ "$marker" -nt "$PORT_SHIM" ]; then
        cat "$marker" 2>/dev/null
        return 0
    fi
    printf 'unknown'
}

# Decide which shim a jail gets and publish it in the global SHIM_MODE
# ("local", "host", or empty). A global rather than stdout on purpose: this
# function logs and warns, and capturing its output would fold those messages
# into the value.
resolve_jail_shim() {
    local name="$1" so marker verdict
    SHIM_MODE=""
    so="$(jail_local_shim "$name")"
    marker="$JROOT_HOME/.shim.$name"

    if [ -s "$so" ] && grep -qa "$SHIM_VERSION" "$so" 2>/dev/null; then
        SHIM_MODE="local"
        return 0
    fi
    [ -x "$PORT_SHIM" ] || return 0

    if [ -f "$marker" ] && [ "$marker" -nt "$PORT_SHIM" ]; then
        verdict="$(cat "$marker" 2>/dev/null || true)"
        case "$verdict" in
            host) SHIM_MODE="host"; return 0 ;;
            none) return 0 ;;
        esac
    fi

    if shim_probe "$name"; then
        printf 'host' > "$marker" 2>/dev/null || true
        SHIM_MODE="host"
        return 0
    fi

    if build_shim_in_jail "$name"; then
        printf 'local' > "$marker" 2>/dev/null || true
        SHIM_MODE="local"
        return 0
    fi

    printf 'none' > "$marker" 2>/dev/null || true
    warn "Jail '$name': the shim cannot load here (its libc is too old for the host build, or incompatible) and the jail has no gcc to build its own."
    warn "  Consequences: no per-jail loopback address, 'jroot port' has no effect, host processes stay visible in /proc, ro mounts rely on Landlock only."
    warn "  Fix: jroot install $name gcc   (Alpine: jroot install $name build-base), then re-enter."
    return 0
}

# ---------------------------------------------------------------------------
# proot (static binary, no root needed)
# ---------------------------------------------------------------------------
install_proot() {
    if [ -x "$PROOT_BIN" ] && "$PROOT_BIN" --version >/dev/null 2>&1; then
        return
    fi
    if command -v proot >/dev/null 2>&1; then
        log "Using system proot: $(command -v proot)"
        cp "$(command -v proot)" "$PROOT_BIN"
        return
    fi
    log "Downloading proot $PROOT_VERSION static binary..."
    local url
    for url in \
        "https://github.com/proot-me/proot/releases/download/v${PROOT_VERSION}/proot-v${PROOT_VERSION}-${ARCH_STR}-static" \
        "https://github.com/proot-me/proot/releases/download/v${PROOT_VERSION}/proot-${ARCH_STR}-static"; do
        if curl -fsSL --connect-timeout 15 -o "$PROOT_BIN" "$url"; then
            log "Downloaded proot from: $url"
            break
        fi
    done
    chmod +x "$PROOT_BIN"
    "$PROOT_BIN" --version >/dev/null 2>&1 || err "proot binary failed to run (corrupt download?)."
}

# ---------------------------------------------------------------------------
# Rootfs download + extract
# ---------------------------------------------------------------------------
# 22.04 publishes "ubuntu-base-22.04-base-<arch>.tar.gz", but 24.04+ uses the
# point release in the name ("ubuntu-base-24.04.4-base-<arch>.tar.gz"). Try
# the exact version first, then parse the release directory listing.
rootfs_url() {
    local version="$1"
    local base="https://cdimage.ubuntu.com/ubuntu-base/releases/${version}/release"
    local url="$base/ubuntu-base-${version}-base-${ROOTFS_ARCH}.tar.gz"
    if curl -fsSI --connect-timeout 10 "$url" >/dev/null 2>&1; then
        echo "$url"
        return 0
    fi
    local name
    name="$(curl -fsSL --connect-timeout 15 "$base/" 2>/dev/null \
        | grep -oE "ubuntu-base-[0-9.]+-base-${ROOTFS_ARCH}\.tar\.gz" \
        | sort -Vu | tail -n1 || true)"
    if [ -n "$name" ]; then
        echo "$base/$name"
        return 0
    fi
    return 1
}

get_ubuntu() {
    local name="$1" version="$2"
    local rootfs="$ROOTS_DIR/$name"

    if [ -f "$rootfs/etc/os-release" ] && { [ -e "$rootfs/bin/sh" ] || [ -L "$rootfs/bin/sh" ]; }; then
        log "Rootfs already present for '$name'"
        return
    fi
    if [ -d "$rootfs" ]; then
        warn "Incomplete rootfs found for '$name', removing and re-downloading..."
        rm -rf "$rootfs"
    fi
    mkdir -p "$rootfs"

    local tarball="$CACHE_DIR/ubuntu-base-${version}-${ROOTFS_ARCH}.tar.gz"
    if [ ! -f "$tarball" ]; then
        local url
        url="$(rootfs_url "$version")" || err "Failed to find a base rootfs download URL for Ubuntu ${version}"
        log "Downloading Ubuntu ${version} base rootfs..."
        curl -fsSL --connect-timeout 15 -o "$tarball" "$url" \
            || err "Failed to download Ubuntu ${version} rootfs"
    fi
    log "Extracting rootfs..."
    tar -xzf "$tarball" -C "$rootfs"
    [ -e "$rootfs/bin/sh" ] || [ -L "$rootfs/bin/sh" ] || err "Rootfs extraction failed - /bin/sh not found"
    log "Rootfs extracted to $rootfs"
}

get_alpine() {
    local name="$1" version="$2"
    local rootfs="$ROOTS_DIR/$name"

    if [ -f "$rootfs/etc/os-release" ] && { [ -e "$rootfs/bin/sh" ] || [ -L "$rootfs/bin/sh" ]; }; then
        log "Rootfs already present for '$name'"
        return
    fi
    if [ -d "$rootfs" ]; then
        warn "Incomplete rootfs found for '$name', removing and re-downloading..."
        rm -rf "$rootfs"
    fi
    mkdir -p "$rootfs"

    local alpine_arch
    case "$ROOTFS_ARCH" in
        amd64)  alpine_arch="x86_64" ;;
        arm64)  alpine_arch="aarch64" ;;
        *)      err "Unsupported Alpine arch: $ROOTFS_ARCH" ;;
    esac

    if [ "$version" = "edge" ]; then
        local url="https://dl-cdn.alpinelinux.org/alpine/edge/releases/${alpine_arch}/alpine-minirootfs-${version}-${alpine_arch}.tar.gz"
        local tarball="$CACHE_DIR/alpine-${version}-${alpine_arch}.tar.gz"
        if [ ! -f "$tarball" ]; then
            log "Downloading Alpine edge rootfs..."
            curl -fsSL --connect-timeout 15 -o "$tarball" "$url" \
                || err "Failed to download Alpine edge rootfs"
        fi
        log "Extracting rootfs..."
        tar -xzf "$tarball" -C "$rootfs"
    else
        # Alpine tarballs include patch version (e.g., 3.20.3, 3.20.8, 3.20.9)
        # Try to discover the latest patch version by listing the directory
        local base_url="https://dl-cdn.alpinelinux.org/alpine/v${version}/releases/${alpine_arch}/"
        local tarball_name
        tarball_name="$(curl -fsSL --connect-timeout 15 "$base_url" 2>/dev/null \
            | grep -oE "alpine-minirootfs-${version}\.[0-9]+-${alpine_arch}\.tar\.gz" \
            | sort -Vu | tail -n1 || true)"
        
        if [ -z "$tarball_name" ]; then
            # Fallback: try common patch versions
            for patch in 9 8 7 6 5 4 3 2 1 0; do
                if curl -fsSI --connect-timeout 10 "${base_url}alpine-minirootfs-${version}.${patch}-${alpine_arch}.tar.gz" >/dev/null 2>&1; then
                    tarball_name="alpine-minirootfs-${version}.${patch}-${alpine_arch}.tar.gz"
                    break
                fi
            done
        fi
        
        [ -n "$tarball_name" ] || err "Failed to find a minirootfs tarball for Alpine ${version} (${alpine_arch})"
        
        local url="${base_url}${tarball_name}"
        local tarball="$CACHE_DIR/${tarball_name}"
        if [ ! -f "$tarball" ]; then
            log "Downloading Alpine ${version} rootfs: ${tarball_name}..."
            curl -fsSL --connect-timeout 15 -o "$tarball" "$url" \
                || err "Failed to download Alpine ${version} rootfs"
        fi
        log "Extracting rootfs..."
        tar -xzf "$tarball" -C "$rootfs"
    fi
    [ -e "$rootfs/bin/sh" ] || [ -L "$rootfs/bin/sh" ] || err "Rootfs extraction failed - /bin/sh not found"
    log "Rootfs extracted to $rootfs"
}

# ---------------------------------------------------------------------------
# apt config: HTTPS repos (port 80 often blocked) + proot-safe dpkg/apt
# ---------------------------------------------------------------------------
config_apt() {
    local name="$1" codename="$2"
    local rootfs="$ROOTS_DIR/$name"

    mkdir -p "$rootfs/etc/apt" "$rootfs/etc/apt/apt.conf.d" "$rootfs/etc/apt/trusted.gpg.d" "$rootfs/usr/local/bin"

    cat > "$rootfs/etc/apt/sources.list" << EOF
deb [arch=${ROOTFS_ARCH} trusted=yes] https://mirrors.mit.edu/ubuntu/ ${codename} main restricted universe multiverse
deb [arch=${ROOTFS_ARCH} trusted=yes] https://mirrors.mit.edu/ubuntu/ ${codename}-updates main restricted universe multiverse
deb [arch=${ROOTFS_ARCH} trusted=yes] https://mirrors.mit.edu/ubuntu/ ${codename}-security main restricted universe multiverse
EOF

    # deadsnakes PPA (python3.11/3.12/3.13). trusted=yes avoids the
    # proot-unreadable keyring entirely.
    if [ "$codename" = "focal" ] || [ "$codename" = "jammy" ]; then
        mkdir -p "$rootfs/etc/apt/sources.list.d"
        cat > "$rootfs/etc/apt/sources.list.d/deadsnakes.list" << EOF
deb [arch=${ROOTFS_ARCH} trusted=yes] https://ppa.launchpadcontent.net/deadsnakes/ppa/ubuntu/ ${codename} main
EOF
    fi

    cat > "$rootfs/etc/apt/apt.conf.d/99fixes" << 'EOF'
APT::Sandbox::User "root";
Acquire::Languages "none";
Acquire::ForceIPv4 "true";
Acquire::AllowInsecureRepositories "true";
APT::Get::AllowUnauthenticated "true";
APT::Key::gpgvcommand "/usr/local/bin/fakegpgv";
Dpkg::Options:: "--force-confold";
EOF

    # The .gpg keyrings can't be read under proot's fake root -> remove them.
    rm -f "$rootfs"/etc/apt/trusted.gpg.d/*.gpg 2>/dev/null || true

    # gpgv shim: apt's gpgv method reads status from fd 3; emit a valid
    # signature line so signature verification passes silently.
    cat > "$rootfs/usr/local/bin/fakegpgv" << 'EOF'
#!/bin/sh
for arg in "$@"; do
    case "$arg" in
        *.gpg|*.asc|*.keyring)
            echo "[GNUPG:] NEWSIG" >&3
            echo "[GNUPG:] GOODSIG 871920D1991BC93C Ubuntu Archive Automatic Signing Key (2018) <ftpmaster@ubuntu.com>" >&3
            echo "[GNUPG:] VALIDSIG F6ECB3762474EDA9D21B7022871920D1991BC93C 2024-01-01 1704067200 1704153600 4 0 1 8 00 0 F6ECB3762474EDA9D21B7022871920D1991BC93C" >&3
            echo "[GNUPG:] TRUST_ULTIMATE" >&3
            ;;
    esac
done
exit 0
EOF
    chmod +x "$rootfs/usr/local/bin/fakegpgv"

    # CA certs for HTTPS - COPY into rootfs (read-only binds break dpkg).
    rm -rf "$rootfs/etc/ssl" "$rootfs/etc/ca-certificates" 2>/dev/null || true
    if [ -d /etc/ssl ]; then
        mkdir -p "$rootfs/etc/ssl"
        cp -rL /etc/ssl/certs "$rootfs/etc/ssl/" 2>/dev/null || true
        [ -f /etc/ssl/certs/ca-certificates.crt ] && cp -f /etc/ssl/certs/ca-certificates.crt "$rootfs/etc/ssl/certs/" 2>/dev/null || true
        cp -f /etc/ssl/openssl.cnf "$rootfs/etc/ssl/" 2>/dev/null || true
    fi
    if [ -d /etc/ca-certificates ]; then
        cp -r /etc/ca-certificates "$rootfs/etc/" 2>/dev/null || true
    fi
    cp /etc/resolv.conf "$rootfs/etc/resolv.conf" 2>/dev/null || true

    sync_jail_hosts "$name"
}

config_apk() {
    local name="$1" version="$2"
    local rootfs="$ROOTS_DIR/$name"

    mkdir -p "$rootfs/etc/apk"
    
    if [ "$version" = "edge" ]; then
        cat > "$rootfs/etc/apk/repositories" << EOF
https://dl-cdn.alpinelinux.org/alpine/edge/main
https://dl-cdn.alpinelinux.org/alpine/edge/community
https://dl-cdn.alpinelinux.org/alpine/edge/testing
EOF
    else
        cat > "$rootfs/etc/apk/repositories" << EOF
https://dl-cdn.alpinelinux.org/alpine/v${version}/main
https://dl-cdn.alpinelinux.org/alpine/v${version}/community
EOF
    fi

    cp /etc/resolv.conf "$rootfs/etc/resolv.conf" 2>/dev/null || true

    sync_jail_hosts "$name"
}

# ---------------------------------------------------------------------------
# Rootfs niceties: custom prompt, group mirroring, sudo logging off
# ---------------------------------------------------------------------------

# The name a jailed process gets from gethostname(2). proot cannot change the
# UTS namespace, so this is always the HOST's kernel hostname, no matter what
# /etc/hostname or the prompt say inside the jail.
host_kernel_name() {
    local n=""
    n="$(uname -n 2>/dev/null || true)"
    [ -n "$n" ] || n="$(hostname 2>/dev/null || true)"
    [ -n "$n" ] || n="localhost"
    printf '%s' "$n"
}

# True when $2 is already a name field in the hosts file $1. Compares whole
# fields, not substrings: "SoloA" must not count as present just because
# "SoloA.lan" is there - a hosts lookup matches names exactly, so the short
# form needs its own entry.
hosts_has_name() {
    awk -v n="$2" '
        { sub(/#.*/, ""); for (i = 2; i <= NF; i++) if ($i == n) { found = 1; exit } }
        END { exit !found }
    ' "$1" 2>/dev/null
}

# Make sure a jail's /etc/hosts resolves BOTH its own name and the host kernel
# name. Anything that resolves its own hostname - sudo above all - fails with
#   sudo: unable to resolve host <hostname>: Name or service not known
# when gethostname(2) returns a name /etc/hosts has never heard of. The jail
# name alone is not enough precisely because the jail never really owns it.
# Idempotent and additive: entries added inside the jail are left alone.
sync_jail_hosts() {
    local name="$1"
    local rootfs="$ROOTS_DIR/$name"
    local hosts="$rootfs/etc/hosts"
    [ -d "$rootfs/etc" ] && [ -w "$rootfs/etc" ] || return 0
    if [ ! -f "$hosts" ]; then
        cat > "$hosts" << 'EOF' 2>/dev/null || return 0
127.0.0.1 localhost
::1 localhost ip6-localhost ip6-loopback
EOF
    fi
    local kname short n
    kname="$(host_kernel_name)"
    short="${kname%%.*}"
    for n in "$name" "$kname" "$short"; do
        [ -n "$n" ] || continue
        hosts_has_name "$hosts" "$n" && continue
        printf '127.0.1.1\t%s\n' "$n" >> "$hosts" 2>/dev/null || true
    done
}

write_rootfs_niceties() {
    local name="$1"
    local rootfs="$ROOTS_DIR/$name"

    mkdir -p "$rootfs/root" 2>/dev/null || true
    cat > "$rootfs/root/.bashrc" << 'EOF'
get_prompt_username() {
    local user="$(whoami 2>/dev/null)"
    [[ -z "$user" || "$user" == "I have no name!" || "$user" == "nobody" ]] \
        && echo "jail" || echo "$user"
}
PS1="\[\033[01;32m\]\$(get_prompt_username)@\$(cat /etc/jailname 2>/dev/null || echo \h)\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]$ "
EOF
    chmod 644 "$rootfs/root/.bashrc" 2>/dev/null || true

    # Alpine's /root/.profile doesn't source .bashrc by default. Fix that.
    cat > "$rootfs/root/.profile" << 'EOF'
# ~/.profile: executed by Bourne-compatible login shells.
if [ -n "$BASH" ] && [ -f ~/.bashrc ]; then
    . ~/.bashrc
fi
EOF
    chmod 644 "$rootfs/root/.profile" 2>/dev/null || true

    # Also set up .profile for /home/jail if it exists (unroot mode)
    if [ -d "$rootfs/home/jail" ]; then
        cat > "$rootfs/home/jail/.profile" << 'EOF'
# ~/.profile: executed by Bourne-compatible login shells.
if [ -n "$BASH" ] && [ -f ~/.bashrc ]; then
    . ~/.bashrc
fi
EOF
        chmod 644 "$rootfs/home/jail/.profile" 2>/dev/null || true
    fi

    # Present the jail by its own name, not the host's hostname.
    printf '%s\n' "$name" > "$rootfs/etc/jailname" 2>/dev/null || true
    printf '%s\n' "$name" > "$rootfs/etc/hostname" 2>/dev/null || true
    # /etc/hosts keeps BOTH names: the jail's, and the host kernel name that
    # gethostname(2) actually returns inside the jail. Dropping the latter is
    # what used to break sudo.
    sync_jail_hosts "$name"
    mkdir -p "$rootfs/usr/local/bin"
    cat > "$rootfs/usr/local/bin/hostname" << 'EOF'
#!/bin/sh
name="$(cat /etc/jailname 2>/dev/null || cat /etc/hostname 2>/dev/null || true)"
case "$1" in
    "")
        if [ -n "$name" ]; then printf '%s\n' "$name"; else exec /usr/bin/hostname; fi
        ;;
    -h|--help|-v|--version|-V)
        exec /usr/bin/hostname "$@"
        ;;
    -f|-F|-d|-i|-I|-s|-y|-a|-A|-b|-m|-n|-p|-D|-o|-V|-fidn|*)
        exec /usr/bin/hostname "$@"
        ;;
esac
EOF
    chmod 755 "$rootfs/usr/local/bin/hostname" 2>/dev/null || true

    # Mirror host groups so "groups: cannot find name for group ID" goes away.
    if [ -f /etc/group ]; then
        local gname gpass ggid gmembers host_gid host_grp
        while IFS=: read -r gname gpass ggid gmembers; do
            if ! grep -q "^$gname:" "$rootfs/etc/group" 2>/dev/null; then
                echo "$gname:x:$ggid:$gmembers" >> "$rootfs/etc/group" 2>/dev/null || true
            fi
        done < /etc/group
        host_gid="$(id -g 2>/dev/null)"
        host_grp="$(getent group "$host_gid" 2>/dev/null | cut -d: -f1)"
        [ -n "$host_grp" ] || host_grp="jail"
        if ! grep -q "^$host_grp:" "$rootfs/etc/group" 2>/dev/null; then
            echo "$host_grp:x:$host_gid:" >> "$rootfs/etc/group" 2>/dev/null || true
        fi
    fi

    write_policy_rcd "$name"
}

write_sudoers() {
    local name="$1"
    local rootfs="$ROOTS_DIR/$name"
    mkdir -p "$rootfs/etc/sudoers.d"
    chmod 755 "$rootfs/etc/sudoers.d" 2>/dev/null || true
    rm -f "$rootfs/etc/sudoers.d/no-audit"
    cat > "$rootfs/etc/sudoers.d/no-audit" << 'EOF'
Defaults !syslog
Defaults !logfile
Defaults !log_input
Defaults !log_output
Defaults !use_pty
EOF
    chmod 440 "$rootfs/etc/sudoers.d/no-audit" 2>/dev/null || true
}

write_policy_rcd() {
    # Never let apt start services during install (chroot/proot). Without this,
    # invoke-rc.d hits a missing policy-rc.d and rsync & friends fail to configure.
    local name="$1"
    local rootfs="$ROOTS_DIR/$name"
    mkdir -p "$rootfs/usr/sbin" 2>/dev/null || true
    cat > "$rootfs/usr/sbin/policy-rc.d" << 'EOF'
#!/bin/sh
exit 101
EOF
    chmod 755 "$rootfs/usr/sbin/policy-rc.d" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Config (JSON)
# ---------------------------------------------------------------------------
write_config() {
    local name="$1" image="$2" user_mode="$3" mount_host="$4" mount_home="$5" build_essential="$6"
    local cfg="$CONFIGS_DIR/$name.json"
    # Merge into an existing config so fields this function does not know about
    # (ports, mounts, loopback, anything added later) survive. Before this,
    # `jroot config` silently dropped a jail's public ports.
    if [ -f "$cfg" ] && command -v python3 >/dev/null 2>&1; then
        python3 - "$cfg" "$name" "$image" "$user_mode" "$mount_host" "$mount_home" "$build_essential" <<'PYEOF' && return 0
import json, sys
cfg, name, image, user, mh, mhome, be = sys.argv[1:8]
try:
    c = json.load(open(cfg))
    if not isinstance(c, dict):
        c = {}
except Exception:
    c = {}
c.update({"name": name, "image": image, "user": user,
          "mount_host": int(mh), "mount_home": int(mhome),
          "build_essential": int(be)})
json.dump(c, open(cfg, "w"), indent=2)
PYEOF
    fi
    cat > "$CONFIGS_DIR/$name.json" << EOF
{
  "name": "$name",
  "image": "$image",
  "user": "$user_mode",
  "mount_host": $mount_host,
  "mount_home": $mount_home,
  "build_essential": $build_essential
}
EOF
}

config_field() {
    sed -n "s/.*\"${2}\"[[:space:]]*:[[:space:]]*\"*\([^\",}]*\)\"*.*/\1/p" "$1" | head -n1
}

# set_config_field <cfg> <key> <value> - value is stored as a JSON string.
set_config_field() {
    command -v python3 >/dev/null 2>&1 || return 1
    python3 - "$1" "$2" "$3" <<'PYEOF'
import json, sys
cfg, key, val = sys.argv[1:4]
try:
    c = json.load(open(cfg))
    if not isinstance(c, dict):
        c = {}
except Exception:
    c = {}
if val == "":
    c.pop(key, None)
else:
    c[key] = val
json.dump(c, open(cfg, "w"), indent=2)
PYEOF
}

# ---------------------------------------------------------------------------
# Per-jail loopback addresses
#
# Each jail owns one address inside 127/8 (127.2.0.1, 127.2.0.2, ...). The
# bind() shim pins the jail's non-public listeners to it, so several jails can
# each run a server on the same port without fighting over 127.0.0.1, and the
# host can reach each of them separately. Stored in the jail config as
# "loopback"; the literal value "off" opts out and restores plain 127.0.0.1.
# ---------------------------------------------------------------------------
LOOPBACK_PREFIX="127.2"

# All addresses currently claimed by any jail, one per line.
loopback_used() {
    local cfg
    shopt -s nullglob
    for cfg in "$CONFIGS_DIR"/*.json; do
        config_field "$cfg" loopback
    done
    shopt -u nullglob
}

# Lowest free 127.2.x.y, skipping .0 and .255 in the last octet.
loopback_next_free() {
    local used idx third fourth cand
    used="$(loopback_used)"
    for idx in $(seq 1 4000); do
        third=$(( (idx - 1) / 254 ))
        fourth=$(( (idx - 1) % 254 + 1 ))
        cand="$LOOPBACK_PREFIX.$third.$fourth"
        printf '%s\n' "$used" | grep -qxF "$cand" || { printf '%s' "$cand"; return 0; }
    done
    return 1
}

# Address for a jail, allocating and persisting one on first use. Prints
# nothing when the jail opted out or when python3 is missing (the config
# cannot be updated safely without it).
jail_loopback_addr() {
    # NOTE: each `local` assignment gets its own statement on purpose. In bash,
    # `local a="$1" b="$a"` expands b BEFORE a is assigned, so b silently picks
    # up the CALLER's a through dynamic scoping - which works by accident when
    # called from run_in_jail and breaks everywhere else.
    local name="$1"
    local cfg="$CONFIGS_DIR/$name.json"
    local cur
    [ -f "$cfg" ] || return 0
    cur="$(config_field "$cfg" loopback)"
    case "$cur" in
        off|shared|disabled) return 0 ;;
        "") ;;
        *) printf '%s' "$cur"; return 0 ;;
    esac
    command -v python3 >/dev/null 2>&1 || return 0
    cur="$(loopback_next_free)" || return 0
    set_config_field "$cfg" loopback "$cur" >/dev/null 2>&1 || return 0
    printf '%s' "$cur"
}

show_config() {
    local name="$1"
    local cfg="$CONFIGS_DIR/$name.json"
    local lb
    lb="$(config_field "$cfg" loopback)"
    printf '  name:             %s\n' "$name"
    printf '  image:            %s\n' "$(config_field "$cfg" image)"
    printf '  user:             %s\n' "$(config_field "$cfg" user)"
    printf '  build_essential:  %s\n' "$(config_field "$cfg" build_essential)"
    printf '  mount_host (/):   %s   (host / at /mnt/host)\n' "$(config_field "$cfg" mount_host)"
    printf '  mount_home (~):   %s   (host $HOME at /mnt/home)\n' "$(config_field "$cfg" mount_home)"
    printf '  loopback addr:    %s\n' "${lb:-auto (assigned on first enter)}"
    printf '  public ports:     %s\n' "$(config_ports "$cfg" | sed 's/^$/none/')"
    # SSH status
    if [ -f "$(ssh_pid_file "$name")" ]; then
        local ssh_pid ssh_port
        ssh_pid="$(cat "$(ssh_pid_file "$name")" 2>/dev/null | tr -d ' ')"
        ssh_port="$(cat "$(ssh_port_file "$name")" 2>/dev/null || echo '?')"
        if kill -0 "$ssh_pid" 2>/dev/null; then
            printf '  ssh:              running (port %s)\n' "$ssh_port"
        else
            printf '  ssh:              stopped (stale)\n'
        fi
    else
        printf '  ssh:              stopped\n'
    fi
    if config_mounts "$cfg" | grep -q .; then
        printf '  custom mounts:\n'
        while IFS=$'\t' read -r m_label m_hostpath m_mode; do
            [ -n "$m_label" ] || continue
            [ -n "$m_mode" ] || m_mode="rw"
            printf '    /mnt/%-12s -> %-30s %s\n' "$m_label" "$m_hostpath" "($m_mode)"
        done < <(config_mounts "$cfg")
    else
        printf '  custom mounts:    none\n'
    fi
}

config_ports() {
    # Returns a comma-separated list of public ports for a jail config file.
    if command -v python3 >/dev/null 2>&1; then
        python3 -c '
import json, sys
try:
    c = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
print(",".join(str(p) for p in c.get("ports", [])))
' "$1" 2>/dev/null
    else
        sed -n 's/.*"ports"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p' "$1" | tr -d ' "' | tr ',' '\n' | paste -sd, -
    fi
}

set_config_ports() {
    # $1=config file, rest = port numbers. Rewrites the config JSON.
    local cfg="$1"; shift
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$cfg" "$@" <<'PYEOF'
import json, sys
cfg, ports = sys.argv[1], sorted({int(p) for p in sys.argv[2:] if p})
c = json.load(open(cfg))
c["ports"] = ports
json.dump(c, open(cfg, "w"), indent=2)
print(",".join(str(p) for p in ports))
PYEOF
    else
        warn "python3 needed to save port config."
        return 1
    fi
}

first_jail() {
    local cfg
    cfg="$(ls "$CONFIGS_DIR"/*.json 2>/dev/null | head -n1 || true)"
    [ -n "$cfg" ] && basename "$cfg" .json || true
}

config_mounts() {
    # Returns "label<TAB>hostpath<TAB>mode" per line for a jail config file.
    # mode is rw or ro (backward compatible with 2-field mount entries).
    if command -v python3 >/dev/null 2>&1; then
        python3 -c '
import json, sys
try:
    c = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
for m in c.get("mounts", []):
    label = m[0] if len(m) > 0 else ""
    path = m[1] if len(m) > 1 else ""
    mode = m[2] if len(m) > 2 else "rw"
    print(label + "\t" + path + "\t" + mode)
' "$1" 2>/dev/null
    else
        sed -n 's/.*"mounts"[[:space:]]*:[[:space:]]*\[.*//p' "$1"
    fi
}

set_config_mounts() {
    # $1=config file, rest = "label=hostpath=mode" pairs (mode optional, rw).
    # Rewrites the config JSON.
    local cfg="$1"; shift
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$cfg" "$@" <<'PYEOF'
import json, sys
cfg, rest = sys.argv[1], sys.argv[2:]
mounts = []
for r in rest:
    parts = r.split("=", 2)
    label = parts[0]
    path = parts[1] if len(parts) > 1 else ""
    mode = parts[2] if len(parts) > 2 else "rw"
    mounts.append([label, path, mode])
c = json.load(open(cfg))
c["mounts"] = mounts
json.dump(c, open(cfg, "w"), indent=2)
PYEOF
    else
        warn "python3 needed to save mount config."
        return 1
    fi
}

mount_list() {
    local name="$1"
    local cfg="$CONFIGS_DIR/$name.json"
    local mpath
    if ! config_mounts "$cfg" | grep -q .; then
        log "No custom mounts for '$name'."
        return 0
    fi
    log "Custom mounts for '$name' (host path -> /mnt/<label>):"
    while IFS=$'\t' read -r label hpath mode; do
        [ -n "$label" ] || continue
        [ -n "$mode" ] || mode="rw"
        printf '    %-14s -> %-30s %s\n' "/mnt/$label" "$hpath" "($mode)"
    done < <(config_mounts "$cfg")
}

mount_add() {
    local name="$1" label="$2" hpath="$3" mode="$4"
    [ -n "$mode" ] || mode="rw"
    case "$mode" in rw|ro) ;; *) err "Mount mode must be 'rw' or 'ro', got '$mode'." ;; esac
    local cfg="$CONFIGS_DIR/$name.json"
    [[ "$label" =~ ^[A-Za-z0-9._-]+$ ]] || err "Invalid mount label: '$label' (letters, digits, . _ -)"
    case "$label" in
        host|home) err "Label '$label' is reserved (/mnt/host and /mnt/home are built-in)." ;;
    esac
    [ -e "$hpath" ] || err "Host path does not exist: $hpath"
    [ -d "$hpath" ] || err "Host path is not a directory: $hpath (only directories can be bind-mounted)"
    local cur line
    cur="$(config_mounts "$cfg")"
    if echo "$cur" | cut -f1 | grep -qx "$label"; then
        err "Label '$label' is already mounted for '$name' (use 'jroot mnt $name rm $label' first)."
    fi
    local pairs
    pairs="$(echo "$cur" | sed 's/\t/=/g' | tr '\n' ' ')"
    pairs="$pairs $label=$hpath=$mode"
    set_config_mounts "$cfg" $pairs
    log "Mounted $hpath at /mnt/$label inside '$name' ($mode)."
    record_event "$name" "mnt" "added /mnt/$label -> $hpath ($mode)"
}

mount_set() {
    local name="$1" label="$2" mode="$3"
    case "$mode" in rw|ro) ;; *) err "Mount mode must be 'rw' or 'ro', got '$mode'." ;; esac
    local cfg="$CONFIGS_DIR/$name.json"
    local cur pairs
    cur="$(config_mounts "$cfg")"
    if ! echo "$cur" | cut -f1 | grep -qx "$label"; then
        err "No mount '/mnt/$label' for '$name'. Run 'jroot mnt $name list' to see mounts."
    fi
    pairs="$(echo "$cur" | sed 's/\t/=/g' | sed "s/^$label=\(.*\)=.*$/$label=\1=$mode/" | tr '\n' ' ')"
    set_config_mounts "$cfg" $pairs
    log "/mnt/$label for '$name' is now $mode."
    record_event "$name" "mnt" "/mnt/$label set to $mode"
}

mount_rm() {
    local name="$1" label="$2"
    local cfg="$CONFIGS_DIR/$name.json"
    local cur pairs
    cur="$(config_mounts "$cfg")"
    if ! echo "$cur" | cut -f1 | grep -qx "$label"; then
        err "No mount '/mnt/$label' for '$name'. Run 'jroot mnt $name list' to see mounts."
    fi
    pairs="$(echo "$cur" | sed 's/\t/=/g' | grep -v "^$label=" | tr '\n' ' ')"
    set_config_mounts "$cfg" $pairs
    log "Removed /mnt/$label from '$name'."
    record_event "$name" "mnt" "removed /mnt/$label"
}

mnt_usage() {
    printf '%bjroot mnt%b - bind-mount a host directory into a jail\n\n' "$H" "$N"
    printf '    %bjroot mnt <name> list%b                 show custom mounts\n' "$G" "$N"
    printf '    %bjroot mnt <name> <label> <hostdir>%b    mount hostdir at /mnt/<label> (rw)\n' "$G" "$N"
    printf '    %bjroot mnt <name> <label> <hostdir> ro%b  mount hostdir read-only\n' "$G" "$N"
    printf '    %bjroot mnt <name> set <label> rw|ro%b   switch a mount between rw and ro\n' "$G" "$N"
    printf '    %bjroot mnt <name> rm <label>%b           unmount /mnt/<label>\n' "$G" "$N"
    printf '\n    Host directories appear inside the jail at %b/mnt/<label>%b.\n' "$G" "$N"
    printf '    proot'"'"'s virtual filesystem makes escaping impossible: %b..%b, absolute\n' "$G" "$N"
    printf '    symlinks, and relative symlinks all resolve inside the jail, never to\n'
    printf '    the host. Read-only mounts (ro) additionally reject every write syscall\n'
    printf '    (open/creat, mkdir, unlink, rename, chmod, ...) with EROFS via the shim.\n'
    printf '    %bNOTE:%b ro mounts require gcc on the host to compile the shim.\n' "$YEL" "$N"
    printf '    Run %bjroot mnt %s test /tmp && jroot enter %s%b as a quick demo.\n' "$G" "$1" "$1" "$N"
}

cmd_mnt() {
    [ $# -ge 2 ] || { mnt_usage "${1:-<name>}"; err "Usage: jroot mnt <name> list|set|<label> <hostdir> [ro]|rm <label>"; }
    local name="$1" op="$2"
    local cfg="$CONFIGS_DIR/$name.json"
    [ -f "$cfg" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."
    case "$op" in
        list)
            mount_list "$name"
            ;;
        set)
            [ $# -ge 4 ] || { mnt_usage "$name"; err "Usage: jroot mnt $name set <label> rw|ro"; }
            mount_set "$name" "$3" "$4"
            ;;
        rm)
            [ $# -ge 3 ] || { mnt_usage "$name"; err "Usage: jroot mnt $name rm <label>"; }
            mount_rm "$name" "$3"
            ;;
        *)
            [ $# -ge 3 ] || { mnt_usage "$name"; err "Usage: jroot mnt $name <label> <hostdir> [ro]"; }
            mount_add "$name" "$2" "$3" "$4"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Run a command inside a jail (proot wrapper, migrated from fakeroot3.sh)
# ---------------------------------------------------------------------------
run_in_jail() {
    local force_root=0
    if [ "$1" = "--root" ]; then
        force_root=1
        shift
    fi
    local name="$1"; shift
    local cfg="$CONFIGS_DIR/$name.json"
    local rootfs="$ROOTS_DIR/$name"
    local real_home="$REAL_HOME"
    local user_mode mount_host mount_home image
    user_mode="$(config_field "$cfg" user)";      [ -n "$user_mode" ]  || user_mode="root"
    mount_host="$(config_field "$cfg" mount_host)"; [ -n "$mount_host" ] || mount_host=0
    mount_home="$(config_field "$cfg" mount_home)"; [ -n "$mount_home" ] || mount_home=0
    image="$(config_field "$cfg" image)"

    # Keep /etc/hosts in step with the host on every entry: the kernel hostname
    # a jailed process sees is the host's, and it changes when the machine is
    # renamed or the jail is moved to another machine. Cheap, idempotent, and it
    # repairs jails created before this was handled.
    sync_jail_hosts "$name"

    # This jail's own loopback address (allocated on first use, "off" opts out).
    local jail_lb
    jail_lb="$(jail_loopback_addr "$name")"

    local proot_args=(-k "$PROOT_KERNEL_RELEASE")
    export HOSTNAME="$name"
    if [ "$force_root" = 1 ] || [ "$user_mode" = "root" ]; then
        proot_args+=(-0 -w /root)
        export HOME=/root USER=root LOGNAME=root SHELL=/bin/bash
    elif [ -d "$rootfs/home/jail" ]; then
        # unroot: install happened as root; daily use is the inner 'jail' user
        # (host uid maps through proot). Falls back to old behaviour if the
        # jail was created before this user existed.
        proot_args+=(-w /home/jail)
        export HOME=/home/jail USER=jail LOGNAME=jail SHELL=/bin/bash
    else
        proot_args+=(-w /)
        unset HOME
    fi

    # Clean environment: pretend to be a fresh machine, not the host.
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games
    unset HOSTALIASES LD_PRELOAD LD_LIBRARY_PATH BASH_ENV ENV
    unset http_proxy https_proxy ftp_proxy all_proxy no_proxy

    # Host temp dir proot uses for its glue rootfs (PROOT_TMP_DIR, else /tmp).
    local proot_tmp="${PROOT_TMP_DIR:-/tmp}"

    local binds=(-b /dev -b /proc -b /sys)
    if [ "$mount_host" = "1" ]; then
        binds+=(-b /:/mnt/host)
    fi
    if [ "$mount_home" = "1" ]; then
        binds+=(-b "$real_home:/mnt/home")
    fi

    # Deny layer: shadow jroot's own tree and binary inside / and $HOME mounts
    # with empty stand-ins, so even raw syscalls that skip the LD_PRELOAD shim
    # resolve them to a dead path. The shim additionally returns ENOENT for any
    # path with a ".jroot" component (covers arbitrary custom mounts too).
    if [ "$mount_home" = "1" ] || [ "$mount_host" = "1" ]; then
        local denied_dir="$JROOT_HOME/.denied" denied_bin="$JROOT_HOME/.deniedbin"
        [ -d "$denied_dir" ] || { mkdir -p "$denied_dir"; : > "$denied_bin"; }
        if [ "$mount_home" = "1" ]; then
            binds+=(-b "$denied_dir:/mnt/home/.jroot")
            binds+=(-b "$denied_bin:/mnt/home/.local/bin/jroot")
        fi
        if [ "$mount_host" = "1" ]; then
            binds+=(-b "$denied_dir:/mnt/host${real_home}/.jroot")
            binds+=(-b "$denied_bin:/mnt/host${real_home}/.local/bin/jroot")
        fi
    fi

    # Custom per-jail mounts (persisted in the config "mounts" array).
    # ro mounts are enforced by the LD_PRELOAD shim (write syscalls -> EROFS).
    local m_label m_hostpath m_mode ro_mounts=""
    while IFS=$'\t' read -r m_label m_hostpath m_mode; do
        [ -n "$m_label" ] || continue
        binds+=(-b "$m_hostpath:/mnt/$m_label")
        [ "$m_mode" = "ro" ] && ro_mounts="$ro_mounts:/mnt/$m_label"
    done < <(config_mounts "$cfg")

    # DBus socket detection (optional; only binds if a socket is found).
    local dbus_sock="" real_uid sock
    real_uid="$(id -u 2>/dev/null)"
    if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        dbus_sock="${DBUS_SESSION_BUS_ADDRESS#unix:path=}"
    fi
    if [ -z "$dbus_sock" ] && [ -n "$real_uid" ]; then
        for sock in "/run/user/${real_uid}/bus" "/run/user/${real_uid}/dbus/bus"; do
            [ -S "$sock" ] && { dbus_sock="$sock"; break; }
        done
    fi
    if [ -z "$dbus_sock" ]; then
        for sock in "/run/dbus/system_bus_socket" "/var/run/dbus/system_bus_socket"; do
            [ -S "$sock" ] && { dbus_sock="$sock"; break; }
        done
    fi
    if [ -z "$dbus_sock" ]; then
        for sock in /run/user/*/bus /run/user/*/dbus/bus; do
            [ -S "$sock" ] 2>/dev/null && { dbus_sock="$sock"; break; }
        done
    fi
    if [ -n "$dbus_sock" ] && [ -S "$dbus_sock" ]; then
        binds+=(-b "$dbus_sock:$dbus_sock")
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$dbus_sock"
    fi

    # Distro detection (musl Alpine needs a different default shell).
    local jail_distro=""
    if [ -f "$rootfs/etc/os-release" ]; then
        jail_distro="$(. "$rootfs/etc/os-release" 2>/dev/null; printf '%s' "${ID:-}")"
    fi

    if [ "$#" -eq 0 ]; then
        if [ "$jail_distro" = "alpine" ]; then
            set -- /bin/sh
        else
            set -- /bin/bash --login
        fi
        # Save the PID for jroot kill (only for interactive shells)
        local pidfile="$JROOT_HOME/pids/$name.pid"
        echo $$ > "$pidfile" 2>/dev/null || true
    fi

    # The shim is applied by wrapping the guest command in /usr/bin/env, so
    # LD_PRELOAD only ever exists INSIDE the jail (the host python3 launcher and
    # proot itself never see it). Which copy of the shim to use depends on the
    # jail's libc - see resolve_jail_shim. JROOT_SHIM_OFF=1 skips it entirely.
    local shim_mode=""
    if [ -z "${JROOT_SHIM_OFF:-}" ] && [ "${SHIM_RESOLVING:-0}" != "1" ]; then
        resolve_jail_shim "$name"
        shim_mode="$SHIM_MODE"
    fi
    if [ -n "$shim_mode" ]; then
        local jail_ports
        jail_ports="$(config_ports "$cfg")"
        # "local" means the jail already has its own build at that path, so no
        # bind is needed (and must NOT shadow it with the host's copy).
        if [ "$shim_mode" = "host" ]; then
            binds+=(-b "$PORT_SHIM:/usr/local/lib/libjroot.so")
        fi
        # JROOT_LOOPBACK  pins this jail's listeners to its own 127.x.y.z and
        #                 redirects the jail's own 127.0.0.1 traffic there.
        # JROOT_PROC_ROOT lets the shim filter /proc down to this jail's
        #                 processes. The seccomp launcher overwrites it with
        #                 proot's pid, which is tighter; this value (jroot's own
        #                 pid) is the fallback for hosts without python3.
        # JROOT_PORT_MAP  rewrites the port a listener asks for, so a service
        #                 wanting a privileged port can run in a rootless jail.
        # JROOT_FAKE_PRIVSEP lets a daemon's own chroot()/seccomp hardening
        #                 report success instead of dying (see `jroot ssh`).
        set -- /usr/bin/env LD_PRELOAD=/usr/local/lib/libjroot.so \
            JROOT_PORTS="${jail_ports:-}" \
            JROOT_LOOPBACK="${jail_lb:-}" \
            JROOT_PROC_ROOT="${JROOT_PROC_ROOT:-$$}" \
            JROOT_PORT_MAP="${JROOT_PORT_MAP:-}" \
            JROOT_FAKE_PRIVSEP="${JROOT_FAKE_PRIVSEP:-}" \
            JROOT_RO_MOUNTS="${ro_mounts#:}" "$@"
    fi

    # Landlock allowlist, composed from the same data as the proot binds above so
    # the two layers cannot drift. This is the only layer that is both
    # kernel-enforced and libc-independent: it covers the syscalls proot does not
    # trace AND it works inside musl (Alpine) jails where the LD_PRELOAD shim
    # cannot be loaded. Set JROOT_LANDLOCK_OFF=1 to skip it.
    LANDLOCK_RULES=""
    if [ -z "${JROOT_LANDLOCK_OFF:-}" ]; then
        landlock_allow "$rootfs" "$LANDLOCK_FULL"
        landlock_allow /dev "$LANDLOCK_FULL"
        landlock_allow /proc "$LANDLOCK_FULL"
        landlock_allow /sys "$LANDLOCK_FULL"
        # proot itself is exec'd from BIN_DIR *after* restrict_self, and the shim
        # is dlopen'd from there, so read+execute here is mandatory - without it
        # the execv() of proot fails with EACCES and nothing runs.
        landlock_allow "$BIN_DIR" "$LANDLOCK_RX"
        # proot builds its "glue rootfs" in a temp dir on the HOST before it can
        # run anything. Without write access there it dies with
        #   can't create temporary directory: Permission denied
        #   can't create glue rootfs
        # and every later error (execve of /bin/sh, bind sanitizing) is fallout.
        landlock_allow "$proot_tmp" "$LANDLOCK_FULL"
        if [ -n "${TMPDIR:-}" ] && [ "$TMPDIR" != "$proot_tmp" ]; then
            landlock_allow "$TMPDIR" "$LANDLOCK_FULL"
        fi
        # The empty stand-ins that shadow ~/.jroot inside host/home mounts live
        # under the denied JROOT_HOME, but proot has to stat them to set up the
        # binds, so they need their own deeper allow.
        landlock_allow "$JROOT_HOME/.denied" "$LANDLOCK_RX"
        landlock_allow "$JROOT_HOME/.deniedbin" "$LANDLOCK_RX"
        if [ -n "$dbus_sock" ]; then
            landlock_allow "$dbus_sock" "$LANDLOCK_FULL"
        fi
        if [ "$mount_host" = "1" ]; then
            landlock_allow / "$LANDLOCK_FULL"
        fi
        if [ "$mount_home" = "1" ]; then
            landlock_allow "$real_home" "$LANDLOCK_FULL"
        fi
        # Custom mounts: ro gets read+execute only, which makes read-only mounts
        # kernel-enforced instead of relying on the shim's EROFS returns.
        while IFS=$'\t' read -r m_label m_hostpath m_mode; do
            [ -n "$m_hostpath" ] || continue
            if [ "$m_mode" = "ro" ]; then
                landlock_allow "$m_hostpath" "$LANDLOCK_RX"
            else
                landlock_allow "$m_hostpath" "$LANDLOCK_FULL"
            fi
        done < <(config_mounts "$cfg")
        # Deny jroot's own state. It sits above roots/<jail> and bin/, and
        # Landlock resolves against the closest rule, so those allows still win.
        landlock_deny "$JROOT_HOME"
        if [ -f "$real_home/.local/bin/jroot" ]; then
            landlock_deny "$real_home/.local/bin/jroot"
        fi
    fi

    # Block the syscalls proot cannot trace (openat2, the fs-tree family,
    # io_uring, ...) with a seccomp filter applied to proot; every guest process
    # inherits it on exec. Requires host python3, which also applies Landlock.
    # NOTE: proot must run as a CHILD (no `exec`) so jroot can keep going
    # after it exits - init/update/verify all call run_in_jail mid-script.
    local rc=0
    if command -v python3 >/dev/null 2>&1 && [ -x "$SECCOMP_LAUNCHER" ]; then
        JROOT_LANDLOCK="$LANDLOCK_RULES" \
            python3 "$SECCOMP_LAUNCHER" "$PROOT_BIN" "${proot_args[@]}" \
            -r "$rootfs" "${binds[@]}" "$@"
        rc=$?
    else
        "$PROOT_BIN" "${proot_args[@]}" \
            -r "$rootfs" "${binds[@]}" "$@"
        rc=$?
    fi
    return "$rc"
}

# ---------------------------------------------------------------------------
# Bootstrap: apt update + core packages + node + /run layout
# ---------------------------------------------------------------------------
bootstrap_ubuntu() {
    local name="$1" codename="$2"
    local cfg="$CONFIGS_DIR/$name.json"
    local build_essential extras extra_py
    build_essential="$(config_field "$cfg" build_essential)"
    extras=""
    [ "$build_essential" = "1" ] && extras="build-essential"
    extra_py=""
    if [ "$codename" = "jammy" ] || [ "$codename" = "focal" ]; then
        extra_py="python3.12 python3.12-dev python3.12-venv"
    fi

    log "Installing core packages inside '$name' (first run, several minutes)..."
    run_in_jail --root "$name" /bin/sh -c "
        export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        export DEBIAN_FRONTEND=noninteractive
        apt-get clean 2>/dev/null
        rm -rf /var/lib/apt/lists/partial 2>/dev/null
        dpkg --configure -a 2>/dev/null
        rm -f /usr/sbin/policy-rc.d 2>/dev/null || true
        printf '#!/bin/sh\necho 2\n' > /sbin/runlevel
        chmod +x /sbin/runlevel
        apt-get update || true
        # --no-install-recommends keeps the jail lean (no lib-* spam).
        # git pulls perl -> left out of defaults; install it per-jail if needed.
        apt-get install -y --no-install-recommends --allow-unauthenticated \\
            ca-certificates sudo curl wget vim nano less \\
            bash-completion htop tmux openssh-client rsync tree unzip zip \\
            python3 python3-pip ${extras} ${extra_py} man-db \\
            net-tools dnsutils iputils-ping file locales apt-utils \\
            xz-utils
        # proot -0 quirk: \`-x\` passes for missing /usr/bin/python3.11, so the
        # python3-lib2to3 postinst tries to run it. Provide the alias.
        if [ ! -e /usr/bin/python3.11 ]; then
            ln -sf python3.10 /usr/bin/python3.11 2>/dev/null || true
        fi
        [ -f /usr/lib/python3.11/py_compile.py ] || cp /usr/lib/python3.10/py_compile.py /usr/lib/python3.11/py_compile.py 2>/dev/null || true
        dpkg --configure -a
        # /var/run is a symlink to /run on a normal system; create internal ones.
        rm -rf /run /var/run 2>/dev/null || true
        mkdir -p /run /run/systemd /run/user /run/lock
        chmod 755 /run /run/systemd /run/user /run/lock
        ln -sf /run /var/run
        case \"$ARCH\" in
            x86_64)
                wget -q --timeout=30 --tries=3 https://nodejs.org/dist/v22.23.2/node-v22.23.2-linux-x64.tar.xz \\
                    && tar -xJf node-v22.23.2-linux-x64.tar.xz --strip-components=1 -C /usr/local \\
                    && rm node-v22.23.2-linux-x64.tar.xz \\
                    || echo 'node-install-skipped'
                ;;
            *) echo 'node-install-skipped' ;;
        esac
        echo BOOTSTRAP-DONE
    "
}

bootstrap_alpine() {
    local name="$1" version="$2"
    local cfg="$CONFIGS_DIR/$name.json"
    local build_essential
    build_essential="$(config_field "$cfg" build_essential)"

    log "Installing core packages inside '$name' (first run, several minutes)..."
    run_in_jail --root "$name" /bin/sh -c "
        export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        apk update
        apk add --no-cache \\
            sudo curl wget vim nano less \\
            bash bash-completion htop tmux openssh-client rsync tree unzip zip \\
            python3 py3-pip man-db \\
            net-tools bind-tools iputils file \\
            xz
        if [ \"$build_essential\" = \"1\" ]; then
            apk add --no-cache build-base gcc g++ make
        fi
        # Install node (x86_64 only for now)
        case \"$ARCH\" in
            x86_64)
                wget -q --timeout=30 --tries=3 https://nodejs.org/dist/v22.23.2/node-v22.23.2-linux-x64.tar.xz \\
                    && tar -xJf node-v22.23.2-linux-x64.tar.xz --strip-components=1 -C /usr/local \\
                    && rm node-v22.23.2-linux-x64.tar.xz \\
                    || echo 'node-install-skipped'
                ;;
            *) echo 'node-install-skipped' ;;
        esac
        # Create /run for compatibility
        mkdir -p /run /run/systemd /run/user /run/lock
        chmod 755 /run /run/systemd /run/user /run/lock
        echo BOOTSTRAP-DONE
    "
}

bootstrap() {
    local name="$1" distro="$2" version="$3"
    if [ "$distro" = "ubuntu" ]; then
        bootstrap_ubuntu "$name" "$version"
    elif [ "$distro" = "alpine" ]; then
        bootstrap_alpine "$name" "$version"
    else
        err "Unknown distro: $distro"
    fi
}

# ---------------------------------------------------------------------------
# Post-init verification: run inside the jail and print what actually works
# ---------------------------------------------------------------------------
verify_jail() {
    local name="$1" out line
    log "Verifying jail '$name' works..."
    # Detect package manager based on os-release
    local pkg_cmd="dpkg -l 2>/dev/null | grep -c \"^ii\" | sed \"s/^/packages=/\""
    out="$(run_in_jail "$name" /bin/sh -c '
        whoami 2>/dev/null | sed "s/^/user=/"
        . /etc/os-release 2>/dev/null && printf "os=%s\n" "$PRETTY_NAME"
        uname -m 2>/dev/null | sed "s/^/arch=/"
        if command -v dpkg >/dev/null 2>&1; then
            dpkg -l 2>/dev/null | grep -c "^ii" | sed "s/^/packages=/"
        elif command -v apk >/dev/null 2>&1; then
            apk info 2>/dev/null | wc -l | sed "s/^/packages=/"
        else
            echo "packages=unknown"
        fi
        python3 --version 2>/dev/null | sed "s/^Python //; s/^/python3=/"
        node --version 2>/dev/null | sed "s/^/node=/" || echo "node=not installed"
        gcc --version 2>/dev/null | head -n1 | sed "s/^/gcc=/" || echo "gcc=not installed"
        git --version 2>/dev/null | sed "s/^/git=/" || echo "git=not installed"
    ' 2>/dev/null || true)"
    if [ -z "$out" ]; then
        warn "Could not run inside '$name' - rootfs may be broken."
        return 1
    fi
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        printf '  %s\n' "$line"
    done <<< "$out"
    local size
    size="$(du -sh "$ROOTS_DIR/$name" 2>/dev/null | awk '{print $1}')"
    printf '  size=%s (on host)\n' "${size:-?}"
}

# ---------------------------------------------------------------------------
# unroot mode: packages were installed as root; now lock root and create a
# non-root inner user ('jail') that daily `jroot enter` logs in as.
# ---------------------------------------------------------------------------
setup_unroot_user() {
    local name="$1"
    local host_uid host_gid
    host_uid="$(id -u)"; host_gid="$(id -g)"
    log "Setting up non-root user for '$name' (uid $host_uid, root gets locked)..."
    run_in_jail --root "$name" /bin/sh -c "
        export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        # Match the host uid so whoami resolves inside the jail.
        useradd -o -m -u $host_uid -s /bin/bash jail 2>/dev/null || true
        mkdir -p /home/jail 2>/dev/null || true
        chown $host_uid:$host_gid /home/jail 2>/dev/null || true
        cp -f /root/.bashrc /home/jail/.bashrc 2>/dev/null || true
        cp -f /root/.profile /home/jail/.profile 2>/dev/null || true
        chown $host_uid:$host_gid /home/jail/.bashrc 2>/dev/null || true
        chown $host_uid:$host_gid /home/jail/.profile 2>/dev/null || true
        passwd -l root 2>/dev/null || true
        echo UNROOT-READY
    " || warn "Could not create non-root user in '$name'."

    log "Non-root user 'jail' ready. 'jroot enter $name' now logs in as 'jail'."
    log "Admin: 'jroot enter $name --root <cmd>' or 'jroot update $name' for root."
}

setup_unroot_alpine() {
    local name="$1"
    local host_uid host_gid
    host_uid="$(id -u)"; host_gid="$(id -g)"
    log "Setting up non-root user for '$name' (uid $host_uid, root gets locked)..."
    run_in_jail --root "$name" /bin/sh -c "
        export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        # Alpine uses adduser (busybox or shadow)
        adduser -D -u $host_uid -s /bin/bash jail 2>/dev/null || true
        mkdir -p /home/jail 2>/dev/null || true
        chown $host_uid:$host_gid /home/jail 2>/dev/null || true
        cp -f /root/.profile /home/jail/.profile 2>/dev/null || true
        cp -f /root/.bashrc /home/jail/.bashrc 2>/dev/null || true
        chown $host_uid:$host_gid /home/jail/.profile 2>/dev/null || true
        chown $host_uid:$host_gid /home/jail/.bashrc 2>/dev/null || true
        # Also ensure /home/jail/.profile sources .bashrc
        cat > /home/jail/.profile << 'EOFPROFILE'
# ~/.profile: executed by Bourne-compatible login shells.
if [ -n \"\$BASH\" ] && [ -f ~/.bashrc ]; then
    . ~/.bashrc
fi
EOFPROFILE
        chown $host_uid:$host_gid /home/jail/.profile 2>/dev/null || true
        # Lock root (Alpine uses /etc/shadow)
        passwd -l root 2>/dev/null || true
        echo UNROOT-READY
    " || warn "Could not create non-root user in '$name'."

    log "Non-root user 'jail' ready. 'jroot enter $name' now logs in as 'jail'."
    log "Admin: 'jroot enter $name --root <cmd>' or 'jroot update $name' for root."
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_init() {
    local image="" repo tag version codename name user_mode response distro=""
    local mount_host=0 mount_home=0 build_essential=1
    local cli_name="" cli_user="" cli_be="" cli_mh="" cli_mhomedir=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --list|list|-l)         list_images; return 0 ;;
            --name=*)               cli_name="${1#*=}" ;;
            --user=*)               cli_user="${1#*=}" ;;
            --build-essential=*)    cli_be="${1#*=}" ;;
            --mount-host=*)         cli_mh="${1#*=}" ;;
            --mount-home=*)         cli_mhomedir="${1#*=}" ;;
            -h|--help)              err "Usage: jroot init <image> [--name=<n>] [--user=root|unroot] [--build-essential=0/1] [--mount-host=0/1] [--mount-home=0/1]\n       jroot init --list  (show available images)" ;;
            *)                      [ -z "$image" ] && image="$1" || err "Unexpected argument: $1" ;;
        esac
        shift
    done
    [ -n "$image" ] || err "Usage: jroot init <image>\n       jroot init --list  (show available images)"

    repo="${image%%:*}"
    tag="${image#*:}"
    [ -n "$tag" ] || tag="latest"

    # Determine distro
    case "$repo" in
        ubuntu) distro="ubuntu" ;;
        alpine) distro="alpine" ;;
        *) err "Unsupported image '$repo'. Run 'jroot init --list' for supported images." ;;
    esac

    # Version parsing
    if [ "$distro" = "ubuntu" ]; then
        if version="$(codename_to_version "$tag")"; then
            codename="$tag"
        elif codename="$(version_to_codename "$tag")"; then
            version="$tag"
        elif [ "$tag" = "latest" ]; then
            version="24.04"; codename="noble"
        else
            err "Unknown Ubuntu version '$tag'. Run 'jroot init --list' for supported versions."
        fi
    elif [ "$distro" = "alpine" ]; then
        if [ "$tag" = "latest" ]; then
            version="3.21"
        elif alpine_version_exists "$tag"; then
            version="$tag"
        else
            err "Unknown Alpine version '$tag'. Run 'jroot init --list' for supported versions."
        fi
    fi

    local default_name
    default_name="$(printf '%s' "$image" | tr ':/' '-')"
    name="$(resolve "What do you want to name this jail? [$default_name]: " "$default_name" "$cli_name")"
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || err "Invalid jail name: '$name'"
    if [ -e "$CONFIGS_DIR/$name.json" ]; then
        err "Jail '$name' already exists"
    fi

    user_mode="$(resolve "Root or unroot inside? [root/unroot]: " "root" "$cli_user")"
    case "$user_mode" in root|unroot) ;; *) err "Choose 'root' or 'unroot' (default root)" ;; esac

    if [ -n "$cli_be" ]; then
        build_essential="$cli_be"
    elif [ -n "${SKIP_BUILD_ESSENTIAL:-}" ]; then
        case "$SKIP_BUILD_ESSENTIAL" in
            1) build_essential=0 ;;
            0) build_essential=1 ;;
            *) build_essential=1 ;;
        esac
    else
        response="$(ask "Install build-essential (gcc, g++, make)? [Y/n]: " "Y")"
        case "$response" in
            n|N|no|NO|No) build_essential=0 ;;
            *)            build_essential=1 ;;
        esac
    fi

    if [ -n "$cli_mh" ]; then
        mount_host="$cli_mh"
    elif [ -n "${MOUNT_HOST:-}" ]; then
        case "$MOUNT_HOST" in 1|0) mount_host="$MOUNT_HOST" ;; esac
    else
        response="$(ask "Mount host filesystem (/) to /mnt/host inside jail? [y/N] (SECURITY RISK): " "N")"
        [[ "$response" =~ ^[Yy] ]] && mount_host=1
    fi

    if [ -n "$cli_mhomedir" ]; then
        mount_home="$cli_mhomedir"
    elif [ -n "${MOUNT_HOME:-}" ]; then
        case "$MOUNT_HOME" in 1|0) mount_home="$MOUNT_HOME" ;; esac
    else
        response="$(ask "Mount host home (\$HOME) to /mnt/home inside jail? [y/N] (SECURITY RISK): " "N")"
        [[ "$response" =~ ^[Yy] ]] && mount_home=1
    fi

    case "$build_essential" in 0|1) ;; *) err "--build-essential must be 0 or 1" ;; esac
    case "$mount_host" in 0|1) ;; *) err "--mount-host must be 0 or 1" ;; esac
    case "$mount_home" in 0|1) ;; *) err "--mount-home must be 0 or 1" ;; esac

    if [ "$mount_host" = "1" ]; then
        warn "SECURITY: host / will be readable/writable at /mnt/host inside the jail."
    fi
    if [ "$mount_home" = "1" ]; then
        warn "SECURITY: host \$HOME will be at /mnt/home inside the jail (SSH keys, .aws, ...)."
    fi

    ensure_runtime
    install_proot

    if [ "$distro" = "ubuntu" ]; then
        get_ubuntu "$name" "$version"
        config_apt "$name" "$codename"
        write_sudoers "$name"
    elif [ "$distro" = "alpine" ]; then
        get_alpine "$name" "$version"
        config_apk "$name" "$version"
    fi

    write_rootfs_niceties "$name"
    write_config "$name" "$image" "$user_mode" "$mount_host" "$mount_home" "$build_essential"
    record_event "$name" "created" \
        "$image user=$user_mode build_essential=$build_essential mount_host=$mount_host mount_home=$mount_home"

    local bootstrapped=1
    if [ "${JROOT_SKIP_APT:-}" = "1" ] || [ "${JROOT_SKIP_BOOTSTRAP:-}" = "1" ]; then
        warn "Skipping bootstrap (env JROOT_SKIP_APT/JROOT_SKIP_BOOTSTRAP)."
        bootstrapped=0
        record_event "$name" "bootstrap" "skipped by env"
    elif bootstrap "$name" "$distro" "$version"; then
        log "Core packages installed."
        record_event "$name" "bootstrap" "core packages installed"
    else
        warn "Bootstrap exited non-zero - finishing configures may still be needed."
        bootstrapped=0
        record_event "$name" "bootstrap" "FAILED (exited non-zero)"
    fi

    if [ "$user_mode" = "unroot" ] && [ "$distro" = "ubuntu" ]; then
        setup_unroot_user "$name"
        record_event "$name" "unroot" "created user 'jail', locked root"
    elif [ "$user_mode" = "unroot" ] && [ "$distro" = "alpine" ]; then
        setup_unroot_alpine "$name"
        record_event "$name" "unroot" "created user 'jail', locked root"
    fi

    log ""
    log "=== SUMMARY ==="
    verify_jail "$name" || bootstrapped=0

    log ""
    log "=== DONE ==="
    log "Jail '$name' created:"
    show_config "$name"
    if [ "$bootstrapped" = "1" ]; then
        log ""
        log "The jail is bootable and ready."
        log "  packages installed:  see summary above"
        log "  Enter a shell:       jroot enter $name"
        log "  Run one command:     jroot enter $name /bin/sh -c \"whoami\""
        log ""
        log "Need more? Install more inside the jail (they become snapshots later):"
        log "    jroot enter $name apt-get install git"
        log "Save a snapshot before making changes:"
        log "    jroot snapshot $name"
        log "Update all packages later:"
        log "    jroot update $name"
    else
        log ""
        warn "Core packages were NOT fully installed. Finish manually:"
        warn "    jroot enter $name apt-get update && apt-get install -y --no-install-recommends \\\\"
        warn "        ca-certificates sudo curl wget vim nano less bash-completion htop tmux \\\\"
        warn "        openssh-client rsync tree unzip zip python3 python3-pip man-db locales"
        warn "Or just: jroot update $name"
    fi
    warn ""
    warn "SECURITY: syscalls proot cannot trace (openat2, io_uring, the fs-tree"
    warn "family) are refused by a seccomp filter, and a Landlock allowlist keeps"
    warn "the jail off host paths it was not given. Run 'jroot doctor' to see"
    warn "which of the two your kernel actually supports."
    if [ "$mount_host" = "1" ]; then
        warn ""
        warn "SECURITY: host / is mounted at /mnt/host inside the jail - it is READ/WRITE."
    fi
    if [ "$mount_home" = "1" ]; then
        warn ""
        warn "SECURITY: host \$HOME is mounted at /mnt/home (SSH keys, .aws, ...)."
    fi
    warn ""
}

cmd_enter() {
    ensure_runtime
    [ -x "$PROOT_BIN" ] || install_proot

    local name="" cmd=() arg force_root=0
    for arg in "$@"; do
        if [ -z "$name" ] && [ -f "$CONFIGS_DIR/$arg.json" ]; then
            name="$arg"
        elif [ "$arg" = "--root" ]; then
            force_root=1
        else
            cmd+=("$arg")
        fi
    done
    if [ -z "$name" ]; then
        local avail="" cfg
        shopt -s nullglob
        for cfg in "$CONFIGS_DIR"/*.json; do
            avail="$avail  $(basename "$cfg" .json)"
        done
        shopt -u nullglob
        if [ -n "$avail" ]; then
            err "No jail name given.\nUsage: jroot enter <name> [<cmd...>]\n       jroot enter <name> --root <cmd...>\n\nAvailable jails:$avail"
        else
            err "No jails found. Create one first: jroot init ubuntu:22.04"
        fi
    fi
    [ -f "$CONFIGS_DIR/$name.json" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."
    [ -d "$ROOTS_DIR/$name" ] || err "Rootfs for '$name' is missing. Recreate it: jroot rm $name && jroot init <image>"

    if [ "$force_root" = 1 ]; then
        run_in_jail --root "$name" "${cmd[@]}"
    else
        run_in_jail "$name" "${cmd[@]}"
    fi
}

cmd_exec() {
    ensure_runtime
    [ -x "$PROOT_BIN" ] || install_proot
    [ $# -ge 1 ] || err "Usage: jroot exec <name> [--root] <cmd...>"
    local name="$1" force_root=0; shift
    if [ "$1" = "--root" ]; then
        force_root=1
        shift
    fi
    [ $# -ge 1 ] || err "Usage: jroot exec <name> [--root] <cmd...>"
    [ -f "$CONFIGS_DIR/$name.json" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."
    [ -d "$ROOTS_DIR/$name" ] || err "Rootfs for '$name' is missing. Recreate it: jroot rm $name && jroot init <image>"

    if [ "$force_root" = 1 ]; then
        run_in_jail --root "$name" "$@"
    else
        run_in_jail "$name" "$@"
    fi
}

file_usage() {
    printf '%bjroot file%b - copy or move files in/out of a jail\n\n' "$H" "$N"
    printf '    %bjroot file cp <name> <src> <dst>%b\n' "$G" "$N"
    printf '    %bjroot file mv <name> <src> <dst>%b\n' "$G" "$N"
    printf '\n'
    printf '    Paths prefixed with %b:%b are inside the jail, e.g.\n' "$G" "$N"
    printf '        %b$%b jroot file cp dev ~/app.tar.gz :/root/app.tar.gz   %b(host -> jail)%b\n' "$G" "$N" "$B" "$N"
    printf '        %b$%b jroot file cp dev :/root/log.txt ./log.txt          %b(jail -> host)%b\n' "$G" "$N" "$B" "$N"
    printf '\n'
    printf '    Exactly one of <src>/<dst> must be a jail path.\n'
}

cmd_file() {
    local op=""
    if [ $# -ge 1 ]; then op="$1"; shift; fi
    case "$op" in
        cp|mv) ;;
        *)
            file_usage
            if [ -z "$op" ]; then err "Missing operation. Use cp or mv."; fi
            err "Unknown file op '$op'. Use cp or mv."
            ;;
    esac
    [ $# -eq 3 ] || { file_usage; err "jroot file $op needs <name> <src> <dst>."; }
    local name="$1" src="$2" dest="$3"
    [ -f "$CONFIGS_DIR/$name.json" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."
    [ -d "$ROOTS_DIR/$name" ] || err "Rootfs for '$name' is missing. Recreate it: jroot rm $name && jroot init <image>"

    local src_is_jail=0 dest_is_jail=0 real_src real_dest
    [[ "$src" == :* ]] && src_is_jail=1
    [[ "$dest" == :* ]] && dest_is_jail=1
    if [ "$src_is_jail" = "$dest_is_jail" ]; then
        err "Exactly one of <src>/<dest> must be a jail path (prefix with ':', e.g. :/root/file)"
    fi

    real_src="$src"; real_dest="$dest"
    [ "$src_is_jail" = 1 ] && real_src="$ROOTS_DIR/$name/${src#:}"
    [ "$dest_is_jail" = 1 ] && real_dest="$ROOTS_DIR/$name/${dest#:}"

    if [ "$dest_is_jail" = 1 ]; then
        mkdir -p "$(dirname "$real_dest")" 2>/dev/null || true
    fi

    if [ "$op" = "cp" ]; then
        cp -r "$real_src" "$real_dest" || err "Copy failed: '$src' -> '$dest'"
        log "Copied '$src' -> '$dest'"
    else
        mv "$real_src" "$real_dest" || err "Move failed: '$src' -> '$dest'"
        log "Moved '$src' -> '$dest'"
    fi
}

port_usage() {
    printf '%bjroot port%b - control which jailed ports may bind publicly\n\n' "$H" "$N"
    printf '    %bjroot port <name> list%b              show public ports\n' "$G" "$N"
    printf '    %bjroot port <name> add <port>%b        make a port public (0.0.0.0)\n' "$G" "$N"
    printf '    %bjroot port <name> rm <port>%b         keep it on the jail address\n' "$G" "$N"
    printf '\n'
    printf '    Jailed servers are loopback-only by default: a bind() LD_PRELOAD\n'
    printf '    shim pins them to the jail'"'"'s own address (see %bjroot net%b) unless the\n' "$G" "$N"
    printf '    port is in the public list.\n'
}

net_usage() {
    printf '%bjroot net%b - per-jail loopback addresses\n\n' "$H" "$N"
    printf '    %bjroot net%b                          list every jail'"'"'s address\n' "$G" "$N"
    printf '    %bjroot net <name>%b                   show one jail\n' "$G" "$N"
    printf '    %bjroot net set <name> auto%b          assign the next free address\n' "$G" "$N"
    printf '    %bjroot net set <name> 127.2.0.9%b     pick an address by hand\n' "$G" "$N"
    printf '    %bjroot net set <name> off%b           share 127.0.0.1 with the host\n' "$G" "$N"
    printf '\n'
    printf '    Each jail owns one address inside %b127/8%b. Servers on non-public\n' "$G" "$N"
    printf '    ports bind to it instead of 127.0.0.1, so several jails can run on\n'
    printf '    the same port at once, and the host reaches each at its own address.\n'
    printf '    Inside the jail, 127.0.0.1 is redirected to that address too, so\n'
    printf '    %blocalhost%b keeps working between the jail'"'"'s own processes - but the\n' "$G" "$N"
    printf '    jail can no longer reach host services on 127.0.0.1. Use %boff%b for\n' "$G" "$N"
    printf '    the old shared behaviour. DNS (port 53) is never redirected.\n'
}

cmd_net() {
    ensure_runtime
    local op="${1:-list}"
    case "$op" in
        set)
            [ $# -eq 3 ] || { net_usage; err "Usage: jroot net set <name> auto|off|<address>"; }
            local name="$2" want="$3" cfg
            cfg="$CONFIGS_DIR/$name.json"
            [ -f "$cfg" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."
            command -v python3 >/dev/null 2>&1 || err "python3 is needed to save the jail config."
            case "$want" in
                auto)
                    set_config_field "$cfg" loopback "" >/dev/null 2>&1
                    local got
                    got="$(jail_loopback_addr "$name")"
                    [ -n "$got" ] || err "No free address left in $LOOPBACK_PREFIX.0.0/16."
                    log "'$name' now uses $got (takes effect on the next 'jroot enter')."
                    record_event "$name" "net" "loopback=$got (auto)"
                    ;;
                off|shared|disabled)
                    set_config_field "$cfg" loopback "off" >/dev/null 2>&1
                    log "'$name' now shares 127.0.0.1 with the host and other jails."
                    warn "Ports can collide with other jails again."
                    record_event "$name" "net" "loopback=off (shared 127.0.0.1)"
                    ;;
                *)
                    [[ "$want" =~ ^127\.[0-9]+\.[0-9]+\.[0-9]+$ ]] \
                        || err "Address must be inside 127/8 (e.g. 127.2.0.9), 'auto', or 'off'. Got '$want'."
                    [ "$want" != "127.0.0.1" ] \
                        || err "127.0.0.1 is the shared address - use 'jroot net set $name off' for that."
                    local octet other
                    for octet in $(printf '%s' "$want" | tr '.' ' '); do
                        [ "$octet" -le 255 ] || err "Invalid address: $want"
                    done
                    other="$(for c in "$CONFIGS_DIR"/*.json; do
                        [ -f "$c" ] || continue
                        [ "$c" = "$cfg" ] && continue
                        [ "$(config_field "$c" loopback)" = "$want" ] && basename "$c" .json
                    done)"
                    [ -z "$other" ] || err "$want is already used by jail '$other'."
                    set_config_field "$cfg" loopback "$want" >/dev/null 2>&1
                    log "'$name' now uses $want (takes effect on the next 'jroot enter')."
                    record_event "$name" "net" "loopback=$want (manual)"
                    ;;
            esac
            ;;
        list|"")
            net_list ""
            ;;
        --help|-h)
            net_usage
            ;;
        *)
            [ -f "$CONFIGS_DIR/$op.json" ] || { net_usage; err "Jail '$op' not found. Run 'jroot list' to see jails."; }
            net_list "$op"
            ;;
    esac
}

net_list() {
    local only="$1" cfgs=() cfg name lb ports shim_note=""
    shopt -s nullglob
    cfgs=("$CONFIGS_DIR"/*.json)
    shopt -u nullglob
    [ "${#cfgs[@]}" -gt 0 ] || err "No jails found. Create one first: jroot init ubuntu:22.04"
    [ -x "$PORT_SHIM" ] || shim_note="shim not built (needs gcc) - addresses are NOT applied yet"

    printf '%b%-16s %-18s %-14s %s%b\n' "$D" "JAIL" "ADDRESS" "PUBLIC PORTS" "DISTRO" "$N"
    for cfg in "${cfgs[@]}"; do
        name="$(basename "$cfg" .json)"
        [ -z "$only" ] || [ "$only" = "$name" ] || continue
        lb="$(config_field "$cfg" loopback)"
        ports="$(config_ports "$cfg")"
        case "$lb" in
            off|shared|disabled) lb="127.0.0.1 shared" ;;
            "")                  lb="auto" ;;
        esac
        printf '%b%-16s%b %-18s %-14s %s\n' "$G" "$name" "$N" "$lb" "${ports:-none}" \
            "$(jail_distro_of "$name")"
    done
    [ -z "$shim_note" ] || warn "$shim_note"
    printf '\n'
    printf '  A server on a non-public port is reachable from the host at that\n'
    printf '  jail'"'"'s ADDRESS, e.g. %bcurl http://127.2.0.1:8080%b. Public ports\n' "$G" "$N"
    printf '  (%bjroot port <name> add%b) bind 0.0.0.0 and ignore the address.\n' "$G" "$N"
    printf '  A jail whose libc cannot load the shim keeps plain 127.0.0.1;\n'
    printf '  %bjroot doctor%b shows which jails those are.\n' "$G" "$N"
    printf '\n'
    printf '  The deliberate trade-off: a jail can no longer reach host services on 127.0.0.1.\n'
    printf '  %bjroot net set <name> off%b restores the old shared behaviour.\n' "$G" "$N"
    printf '\n'
    printf '  This is a list of addresses assigned to jails. Run %bjroot net help%b for more information.\n' "$G" "$N"
}

cmd_port() {
    [ $# -ge 2 ] || { port_usage; err "Usage: jroot port <name> list|add|rm [port]"; }
    local name="$1" op="$2" port="$3"
    local cfg="$CONFIGS_DIR/$name.json"
    [ -f "$cfg" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."

    case "$op" in
        list)
            local ports cur lb
            cur="$(config_ports "$cfg")"
            lb="$(config_field "$cfg" loopback)"
            case "$lb" in off|shared|disabled|"") lb="127.0.0.1" ;; esac
            if [ -z "$cur" ]; then
                log "No public ports for '$name'. Servers stay on $lb (see 'jroot net')."
            else
                log "Public ports for '$name': $cur (bind to 0.0.0.0). Everything else stays on $lb."
            fi
            ;;
        add)
            [ -n "$port" ] || { port_usage; err "Usage: jroot port $name add <port>"; }
            [[ "$port" =~ ^[0-9]+$ ]] || err "Port must be a number, got '$port'"
            [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || err "Port out of range: $port"
            local cur all
            cur="$(config_ports "$cfg")"
            if [ -n "$cur" ]; then
                all="$cur,$port"
            else
                all="$port"
            fi
            all="$(set_config_ports "$cfg" $(echo "$all" | tr ',' ' ') 2>/dev/null)"
            [ -n "$all" ] || err "Failed to save port config."
            log "Port $port is now PUBLIC for '$name' (binds 0.0.0.0). All ports: $all"
            record_event "$name" "port" "opened $port (public: $all)"
            ;;
        rm)
            [ -n "$port" ] || { port_usage; err "Usage: jroot port $name rm <port>"; }
            local cur rest all
            cur="$(config_ports "$cfg")"
            rest="$(echo "$cur" | tr ',' ' ' | sed "s/\b$port\b//g" | tr -s ' ')"
            all="$(set_config_ports "$cfg" $rest 2>/dev/null)"
            [ -n "$all" ] || all="(none)"
            log "Port $port removed for '$name'. Public ports now: $all"
            record_event "$name" "port" "closed $port (public: $all)"
            ;;
        *)
            port_usage
            err "Unknown port op '$op'. Use list, add, or rm."
            ;;
    esac
}

cmd_install() {
    ensure_runtime
    [ -x "$PROOT_BIN" ] || install_proot
    [ $# -ge 2 ] || err "Usage: jroot install <name> <package...>"
    local name="$1"; shift
    [ -f "$CONFIGS_DIR/$name.json" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."
    [ -d "$ROOTS_DIR/$name" ] || err "Rootfs for '$name' is missing. Recreate it: jroot rm $name && jroot init <image>"

    local image_tag distro
    image_tag="$(config_field "$CONFIGS_DIR/$name.json" image)"
    distro="${image_tag%%:*}"

    local user_mode
    user_mode="$(config_field "$CONFIGS_DIR/$name.json" user)"; [ -n "$user_mode" ] || user_mode="root"

    # For unroot jails, we need to temporarily unlock root before install, then lock it again after
    if [ "$user_mode" = "unroot" ]; then
        log "Unroot jail detected. Temporarily unlocking root for install..."
        if [ "$distro" = "ubuntu" ]; then
            run_in_jail --root "$name" /bin/sh -c "
                export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games
                export DEBIAN_FRONTEND=noninteractive
                dpkg --configure -a 2>/dev/null || true
                apt-get update || true
                sed -i 's/^root:!:/root:*/' /etc/shadow 2>/dev/null || true
            " || warn "Failed to unlock root for install."
        elif [ "$distro" = "alpine" ]; then
            run_in_jail --root "$name" /bin/sh -c "
                export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games
                apk update
                passwd -u root 2>/dev/null || true
            " || warn "Failed to unlock root for install."
        fi
    fi

    log "Installing in '$name': $*"
    if [ "$distro" = "ubuntu" ]; then
        write_policy_rcd "$name"
        run_in_jail --root "$name" /bin/sh -c "
            export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games
            export DEBIAN_FRONTEND=noninteractive
            dpkg --configure -a 2>/dev/null || true
            apt-get update || true
            apt-get install -y --allow-unauthenticated $*
        " || { warn "Install failed inside '$name'."; record_event "$name" "install" "FAILED: $*"; return 1; }
    elif [ "$distro" = "alpine" ]; then
        run_in_jail --root "$name" /bin/sh -c "
            export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games
            apk update
            apk add --no-cache $*
        " || { warn "Install failed inside '$name'."; record_event "$name" "install" "FAILED: $*"; return 1; }
    else
        err "Unknown distro: $distro"
    fi
    log "Installed in '$name': $*"
    record_event "$name" "install" "$*"

    # For unroot jails, lock root again after install
    if [ "$user_mode" = "unroot" ]; then
        log "Locking root again for unroot jail..."
        if [ "$distro" = "ubuntu" ]; then
            run_in_jail --root "$name" /bin/sh -c "
                export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games
                passwd -l root 2>/dev/null || true
            " || warn "Failed to lock root after install."
        elif [ "$distro" = "alpine" ]; then
            run_in_jail --root "$name" /bin/sh -c "
                export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games
                passwd -l root 2>/dev/null || true
            " || warn "Failed to lock root after install."
        fi
    fi
}

cmd_clean() {
    ensure_runtime
    [ -x "$PROOT_BIN" ] || install_proot
    [ $# -ge 1 ] || err "Usage: jroot clean <name> [more jails...]"
    local name arg
    for arg in "$@"; do
        [ -f "$CONFIGS_DIR/$arg.json" ] || err "Jail '$arg' not found. Run 'jroot list' to see jails."
        [ -d "$ROOTS_DIR/$arg" ] || err "Rootfs for '$arg' is missing. Recreate it: jroot rm $arg && jroot init <image>"
    done

    local before after saved
    for name in "$@"; do
        before="$(du -sm "$ROOTS_DIR/$name" 2>/dev/null | awk '{print $1}')"
        log "Cleaning '$name' (apt caches, package lists, temp files)..."
        run_in_jail --root "$name" /bin/sh -c "
            export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games
            export DEBIAN_FRONTEND=noninteractive
            dpkg --configure -a 2>/dev/null || true
            apt-get clean 2>/dev/null || true
            rm -rf /var/lib/apt/lists/* 2>/dev/null || true
            rm -rf /var/cache/apt/archives/* 2>/dev/null || true
            rm -rf /var/cache/debconf 2>/dev/null || true
            rm -rf /tmp/* /var/tmp/* 2>/dev/null || true
        " || warn "Clean inside '$name' failed."
        if [ -f "$CONFIGS_DIR/$name.json" ]; then
            local build_essential
            build_essential="$(config_field "$CONFIGS_DIR/$name.json" build_essential)"
            if [ "$build_essential" = "1" ]; then
                rm -rf "$ROOTS_DIR/$name/usr/share/doc" 2>/dev/null || true
                rm -rf "$ROOTS_DIR/$name/var/log" 2>/dev/null || true
            fi
        fi
        after="$(du -sm "$ROOTS_DIR/$name" 2>/dev/null | awk '{print $1}')"
        saved=$(( before - after ))
        if [ "$saved" -gt 0 ]; then
            log "'$name' cleaned: ${before}MB -> ${after}MB (freed ${saved}MB)"
            record_event "$name" "clean" "freed ${saved}MB (${before}MB -> ${after}MB)"
        else
            log "'$name' cleaned: still ${after}MB"
            record_event "$name" "clean" "nothing to free (${after}MB)"
        fi
    done
}

cmd_size() {
    [ $# -le 1 ] || err "Usage: jroot size [name]"
    local name="${1:-}"
    printf '%-20s %10s %s\n' "JAIL" "ROOTFS" "SNAPSHOTS"
    if [ -n "$name" ]; then
        [ -f "$CONFIGS_DIR/$name.json" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."
        size_one "$name"
        return 0
    fi
    local cfgs=() cfg
    shopt -s nullglob
    cfgs=("$CONFIGS_DIR"/*.json)
    shopt -u nullglob
    [ "${#cfgs[@]}" -gt 0 ] || { err "No jails found. Create one first: jroot init ubuntu:22.04"; }
    for cfg in "${cfgs[@]}"; do
        size_one "$(basename "$cfg" .json)"
    done
}

size_one() {
    local name="$1"
    local rootfs="$ROOTS_DIR/$name" rsize ssize snaps snapshots_dir
    if [ -d "$rootfs" ]; then
        rsize="$(du -sh "$rootfs" 2>/dev/null | awk '{print $1}')"
    else
        rsize="(missing)"
    fi
    snapshots_dir="$SNAPSHOTS_DIR/$name"
    ssize="0B"
    shopt -s nullglob
    snaps=("$snapshots_dir"/*.tar.gz)
    shopt -u nullglob
    if [ "${#snaps[@]}" -gt 0 ]; then
        ssize="$(du -sh "$snapshots_dir" 2>/dev/null | awk '{print $1}')"
    fi
    printf '%-20s %10s %10s\n' "$name" "$rsize" "$ssize"
}

cmd_list() {
    local json=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --json|-j) json=1 ;;
            *) err "Unknown option: $1 (try 'jroot list --json')" ;;
        esac
        shift
    done

    local cfgs=() cfg name image user_mode mount_host mount_home build_essential
    shopt -s nullglob
    cfgs=("$CONFIGS_DIR"/*.json)
    shopt -u nullglob
    if [ "${#cfgs[@]}" -eq 0 ]; then
        if [ "$json" = 1 ]; then
            printf '[]\n'
        else
            log "No jails yet. Create one: jroot init ubuntu:22.04"
        fi
        return
    fi

    if [ "$json" = 1 ]; then
        local first=1
        printf '[\n'
        for cfg in "${cfgs[@]}"; do
            name="$(basename "$cfg" .json)"
            image="$(config_field "$cfg" image)"
            user_mode="$(config_field "$cfg" user)";      [ -n "$user_mode" ]  || user_mode="root"
            mount_host="$(config_field "$cfg" mount_host)"; [ -n "$mount_host" ] || mount_host=0
            mount_home="$(config_field "$cfg" mount_home)"; [ -n "$mount_home" ] || mount_home=0
            build_essential="$(config_field "$cfg" build_essential)"; [ -n "$build_essential" ] || build_essential=1
            [ "$first" = 1 ] || printf ',\n'
            first=0
            printf '  {"name": "%s", "image": "%s", "user": "%s", "mount_host": %s, "mount_home": %s, "build_essential": %s, "rootfs": "%s"}' \
                "$(json_esc "$name")" "$(json_esc "$image")" "$(json_esc "$user_mode")" \
                "$mount_host" "$mount_home" "$build_essential" "$(json_esc "$ROOTS_DIR/$name")"
        done
        printf '\n]\n'
        return
    fi

    printf '%-16s %-14s %-8s %-5s %-5s %-5s %s\n' "NAME" "IMAGE" "USER" "MNT/" "MNT~" "BUILD" "ROOTFS"
    for cfg in "${cfgs[@]}"; do
        name="$(basename "$cfg" .json)"
        image="$(config_field "$cfg" image)"
        user_mode="$(config_field "$cfg" user)";      [ -n "$user_mode" ]  || user_mode="root"
        mount_host="$(config_field "$cfg" mount_host)"; [ -n "$mount_host" ] || mount_host=0
        mount_home="$(config_field "$cfg" mount_home)"; [ -n "$mount_home" ] || mount_home=0
        build_essential="$(config_field "$cfg" build_essential)"; [ -n "$build_essential" ] || build_essential=1
        printf '%-16s %-14s %-8s %-5s %-5s %-5s %s\n' "$name" "${image:-?}" "$user_mode" "$mount_host" "$mount_home" "$build_essential" "$ROOTS_DIR/$name"
    done
}

cmd_config() {
    [ $# -ge 1 ] || err "Usage: jroot config <name> [--show|--mount-host=0/1|--mount-home=0/1|--build-essential=0/1|--user=root/unroot]"
    local name="$1"; shift
    local cfg="$CONFIGS_DIR/$name.json"
    [ -f "$cfg" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."

    case " $* " in
        *" --show "*) show_config "$name"; return 0 ;;
    esac

    local image user_mode mount_host mount_home build_essential response mounts_pairs
    image="$(config_field "$cfg" image)"
    user_mode="$(config_field "$cfg" user)";          [ -n "$user_mode" ]          || user_mode="root"
    mount_host="$(config_field "$cfg" mount_host)";   [ -n "$mount_host" ]         || mount_host=0
    mount_home="$(config_field "$cfg" mount_home)";   [ -n "$mount_home" ]         || mount_home=0
    build_essential="$(config_field "$cfg" build_essential)"; [ -n "$build_essential" ] || build_essential=1
    mounts_pairs="$(config_mounts "$cfg" 2>/dev/null | sed 's/\t/=/g' | tr '\n' ' ')"

    local old_user="$user_mode" old_mh="$mount_host" old_mhome="$mount_home" old_be="$build_essential"
    if [ $# -eq 0 ]; then
        log "Current config for '$name':"
        show_config "$name"
        user_mode="$(ask "Root or unroot inside? [$user_mode]: " "$user_mode")"
        case "$user_mode" in root|unroot) ;; *) err "Choose 'root' or 'unroot'." ;; esac
        response="$(ask "Mount host / to /mnt/host? [y/N] (current: $mount_host): " "N")"
        [[ "$response" =~ ^[Yy] ]] && mount_host=1 || mount_host=0
        response="$(ask "Mount host home to /mnt/home? [y/N] (current: $mount_home): " "N")"
        [[ "$response" =~ ^[Yy] ]] && mount_home=1 || mount_home=0
    else
        for arg in "$@"; do
            case "$arg" in
                --mount-host=1|--mount-host=0)      mount_host="${arg#*=}" ;;
                --mount-home=1|--mount-home=0)      mount_home="${arg#*=}" ;;
                --build-essential=1|--build-essential=0) build_essential="${arg#*=}" ;;
                --user=root|--user=unroot)          user_mode="${arg#*=}" ;;
                *) err "Unknown option: $arg" ;;
            esac
        done
    fi

    write_config "$name" "$image" "$user_mode" "$mount_host" "$mount_home" "$build_essential"
    if [ -n "$mounts_pairs" ]; then
        set_config_mounts "$cfg" $mounts_pairs >/dev/null 2>&1
    fi
    log "Config updated for '$name':"
    show_config "$name"
    # Record only what actually changed, so history stays readable.
    local changes=""
    [ "$user_mode" = "$old_user" ]       || changes="$changes user=$old_user->$user_mode"
    [ "$mount_host" = "$old_mh" ]        || changes="$changes mount_host=$old_mh->$mount_host"
    [ "$mount_home" = "$old_mhome" ]     || changes="$changes mount_home=$old_mhome->$mount_home"
    [ "$build_essential" = "$old_be" ]   || changes="$changes build_essential=$old_be->$build_essential"
    [ -z "$changes" ] || record_event "$name" "config" "${changes# }"
    if [ "$user_mode" = "unroot" ]; then
        setup_unroot_user "$name"
    fi
    if [ "$mount_host" = "1" ] || [ "$mount_home" = "1" ]; then
        warn "Mounts are enabled - they take effect on the next 'jroot enter'."
    fi
}

cmd_rm() {
    [ $# -eq 1 ] || err "Usage: jroot rm <name>"
    local name="$1" response
    [ -f "$CONFIGS_DIR/$name.json" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."
    printf 'Delete jail "%s" and its rootfs (%s)? [y/N]: ' "$name" "$ROOTS_DIR/$name"
    read -r response || response="N"
    case "$response" in
        y|Y|yes|YES) ;;
        *) log "Aborted."; return 0 ;;
    esac
    # Stop SSH daemon if running
    if [ -f "$(ssh_pid_file "$name")" ]; then
        ssh_stop "$name" 2>/dev/null || true
    fi
    rm -rf "$ROOTS_DIR/$name" "$CONFIGS_DIR/$name.json"
    rm -f "$(history_file "$name")"
    rm -f "$JROOT_HOME/pids/$name.pid" 2>/dev/null || true
    rm -f "$JROOT_HOME/pids/$name.sshd" "$JROOT_HOME/pids/$name.sshport" \
          "$JROOT_HOME/pids/$name.socat" "$JROOT_HOME/pids/$name.sshinner" \
          "$JROOT_HOME/pids/$name.sshlog" 2>/dev/null || true
    log "Jail '$name' deleted."
}

cmd_kill() {
    local force=0
    local name=""
    local arg
    for arg in "$@"; do
        case "$arg" in
            --force|-f) force=1 ;;
            --*) err "Unknown option: $arg" ;;
            *)
                if [ -z "$name" ]; then
                    name="$arg"
                else
                    err "Usage: jroot kill <name> [--force|-f]"
                fi
                ;;
        esac
    done
    [ -n "$name" ] || err "Usage: jroot kill <name> [--force|-f]"
    
    local pidfile="$JROOT_HOME/pids/$name.pid"
    [ -f "$pidfile" ] || err "Jail '$name' is not running (no PID file)."
    
    local pid
    pid="$(cat "$pidfile" 2>/dev/null | tr -d ' ')"
    if ! kill -0 "$pid" 2>/dev/null; then
        warn "PID $pid is not running. Removing stale PID file."
        rm -f "$pidfile"
        return 0
    fi
    
    log "Killing jail '$name' (PID: $pid)..."
    
    # Kill the entire process group (bash + all children)
    local pgid
    pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')"
    if [ -n "$pgid" ]; then
        if [ "$force" = 1 ]; then
            kill -KILL -"$pgid" 2>/dev/null || true
        else
            kill -TERM -"$pgid" 2>/dev/null || true
            sleep 0.3
            # Force kill if still running
            kill -KILL -"$pgid" 2>/dev/null || true
        fi
    else
        # Fallback: kill just the PID
        if [ "$force" = 1 ]; then
            kill -KILL "$pid" 2>/dev/null || true
        else
            kill -TERM "$pid" 2>/dev/null || true
            sleep 0.3
            kill -KILL "$pid" 2>/dev/null || true
        fi
    fi
    
    rm -f "$pidfile"
    log "Jail '$name' killed."
}

cmd_ps() {
    local found=0
    printf '%-16s %-8s %-6s %s\n' "JAIL" "PID" "TYPE" "COMMAND"
    for pidfile in "$JROOT_HOME/pids"/*.pid; do
        [ -f "$pidfile" ] || continue
        local name="$(basename "$pidfile" .pid)"
        local pid="$(cat "$pidfile" 2>/dev/null | tr -d ' ')"
        if kill -0 "$pid" 2>/dev/null; then
            local cmd="$(ps -o cmd= -p "$pid" 2>/dev/null | head -c 50)"
            printf '%-16s %-8s %-6s %s\n' "$name" "$pid" "shell" "${cmd:-unknown}"
            found=1
        else
            rm -f "$pidfile"
        fi
    done
    # Also show SSH daemons
    for pidfile in "$JROOT_HOME/pids"/*.sshd; do
        [ -f "$pidfile" ] || continue
        local name="$(basename "$pidfile" .sshd)"
        local pid="$(cat "$pidfile" 2>/dev/null | tr -d ' ')"
        if kill -0 "$pid" 2>/dev/null; then
            local port="$(cat "$JROOT_HOME/pids/$name.sshport" 2>/dev/null || echo '?')"
            printf '%-16s %-8s %-6s %s\n' "$name" "$pid" "sshd" "port $port"
            found=1
        else
            rm -f "$pidfile" "$JROOT_HOME/pids/$name.sshport" "$JROOT_HOME/pids/$name.socat" "$JROOT_HOME/pids/$name.sshinner" 2>/dev/null
        fi
    done
    [ "$found" -eq 0 ] && log "No running jails."
}

cmd_rename() {
    [ $# -eq 2 ] || err "Usage: jroot rename <name> <newname>"
    local name="$1" newname="$2"
    [ "$name" != "$newname" ] || err "New name is the same as the current name."
    [[ "$newname" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || err "Invalid new name: '$newname'"
    [ -f "$CONFIGS_DIR/$name.json" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."
    [ -f "$CONFIGS_DIR/$newname.json" ] && err "Jail '$newname' already exists. Run 'jroot list' to see jails."
    [ -d "$ROOTS_DIR/$name" ] || err "Rootfs for '$name' is missing. Recreate it: jroot rm $name && jroot init <image>"

    local cfg="$CONFIGS_DIR/$name.json" newcfg="$CONFIGS_DIR/$newname.json"

    # 1) Rename the rootfs dir.
    if [ -d "$ROOTS_DIR/$newname" ] && [ "$ROOTS_DIR/$newname" != "$ROOTS_DIR/$name" ]; then
        err "Rootfs '$ROOTS_DIR/$newname' already exists."
    fi
    mv "$ROOTS_DIR/$name" "$ROOTS_DIR/$newname" || err "Failed to rename rootfs."

    # 2) Rename config, keeping every field but updating "name". Moving the file
    # (rather than deleting and rewriting it) is what preserves fields this
    # function does not know about - loopback, and anything added later.
    local image user_mode mount_host mount_home build_essential ports mounts_pairs
    image="$(config_field "$cfg" image)"
    user_mode="$(config_field "$cfg" user)";          [ -n "$user_mode" ]          || user_mode="root"
    mount_host="$(config_field "$cfg" mount_host)";   [ -n "$mount_host" ]         || mount_host=0
    mount_home="$(config_field "$cfg" mount_home)";   [ -n "$mount_home" ]         || mount_home=0
    build_essential="$(config_field "$cfg" build_essential)"; [ -n "$build_essential" ] || build_essential=1
    ports="$(config_ports "$cfg" 2>/dev/null || true)"
    mounts_pairs="$(config_mounts "$cfg" 2>/dev/null | sed 's/\t/=/g' | tr '\n' ' ')"
    mv "$cfg" "$newcfg" 2>/dev/null || true
    write_config "$newname" "$image" "$user_mode" "$mount_host" "$mount_home" "$build_essential"
    # Belt and braces for hosts without python3, where write_config cannot merge.
    if [ -n "$ports" ]; then
        set_config_ports "$newcfg" $(echo "$ports" | tr ',' ' ') >/dev/null 2>&1
    fi
    if [ -n "$mounts_pairs" ]; then
        set_config_mounts "$newcfg" $mounts_pairs >/dev/null 2>&1
    fi

    # 3) Rename snapshots dir.
    if [ -d "$SNAPSHOTS_DIR/$name" ]; then
        mv "$SNAPSHOTS_DIR/$name" "$SNAPSHOTS_DIR/$newname" 2>/dev/null || true
    fi

    # 4) Point the jail's hostname files at the new name.
    write_rootfs_niceties "$newname"

    # 5) Carry the history over so provenance survives the rename.
    if [ -f "$(history_file "$name")" ]; then
        mv "$(history_file "$name")" "$(history_file "$newname")" 2>/dev/null || true
    fi
    record_event "$newname" "rename" "was '$name'"

    log "Renamed '$name' -> '$newname' (hostname, prompt, snapshots updated)."
}

# Read-only probe of the two kernel features jroot depends on. Prints
# "seccomp=<yes|no|unknown> landlock=<abi|no|unknown>".
kernel_features() {
    if ! command -v python3 >/dev/null 2>&1; then
        printf 'seccomp=unknown landlock=unknown\n'
        return 0
    fi
    python3 -c '
import ctypes, platform
libc = ctypes.CDLL(None, use_errno=True)
m = platform.machine()
NR_SECCOMP = {"x86_64": 317, "AMD64": 317, "aarch64": 277, "arm64": 277}.get(m)
seccomp = "no"
if NR_SECCOMP:
    action = ctypes.c_uint(0x00050000)          # SECCOMP_RET_ERRNO
    # SECCOMP_GET_ACTION_AVAIL (op 2) only queries, it installs nothing.
    if libc.syscall(NR_SECCOMP, 2, 0, ctypes.byref(action)) == 0:
        seccomp = "yes"
abi = libc.syscall(444, None, 0, 1)             # CREATE_RULESET_VERSION
landlock = str(abi) if abi > 0 else "no"
print("seccomp=%s landlock=%s" % (seccomp, landlock))
' 2>/dev/null || printf 'seccomp=unknown landlock=unknown\n'
}

cmd_doctor() {
    local mute=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --mute=*)
                mute="${1#*=}"
                shift
                ;;
            --mute)
                echo "Usage: jroot doctor --mute=7d|--mute=forever"
                echo "  7d    - mute warnings for 7 days"
                echo "  forever - mute warnings forever"
                echo "  off   - unmute warnings"
                return 0
                ;;
            *)
                shift
                ;;
        esac
    done

    # Handle mute option
    if [ -n "$mute" ]; then
        local mute_file="$JROOT_HOME/.mute-warnings"
        if [ "$mute" = "off" ]; then
            rm -f "$mute_file" 2>/dev/null || true
            log "Warnings unmuted."
            return 0
        elif [ "$mute" = "forever" ]; then
            echo "9999999999" > "$mute_file"
            log "Warnings muted forever. To unmute: jroot doctor --mute=off"
            return 0
        elif [[ "$mute" =~ ^([0-9]+)(d|h|m)$ ]]; then
            local num="${BASH_REMATCH[1]}"
            local unit="${BASH_REMATCH[2]}"
            local seconds=0
            case "$unit" in
                d) seconds=$((num * 86400)) ;;
                h) seconds=$((num * 3600)) ;;
                m) seconds=$((num * 60)) ;;
            esac
            local until_time=$(( $(date +%s) + seconds ))
            echo "$until_time" > "$mute_file"
            log "Warnings muted for ${num}${unit}. To unmute: jroot doctor --mute=off"
            return 0
        else
            err "Invalid mute format. Use: 7d, 12h, 30m, forever, or off"
        fi
    fi

    ensure_runtime
    local ok=0 warn=0 fail=0
    local status=

    report() { # $1 = label, $2 = ok|warn|fail, rest = detail
        local label="$1" lvl="$2" detail="${3:-}"
        case "$lvl" in
            ok)   printf '  [PASS] %s\n' "$label"; ok=$((ok+1)) ;;
            warn) printf '  [WARN] %s\n' "$label"; warn=$((warn+1)) ;;
            fail) printf '  [FAIL] %s\n' "$label"; fail=$((fail+1)) ;;
        esac
        [ -z "$detail" ] || printf '         %s\n' "$detail"
    }

    log "jroot doctor - checking installation..."
    [ -w "$JROOT_HOME" ] && report "jroot home writable: $JROOT_HOME" ok || report "jroot home not writable: $JROOT_HOME" fail
    for d in "$ROOTS_DIR" "$CONFIGS_DIR" "$SNAPSHOTS_DIR" "$BIN_DIR" "$CACHE_DIR"; do
        [ -d "$d" ] || report "missing dir: $d" fail
    done

    if [ -x "$PROOT_BIN" ]; then
        status="$(env -i "$PROOT_BIN" --version 2>/dev/null | grep -m1 -oE 'v?[0-9]+\.[0-9]+\.[0-9]+' || true)"
        report "proot binary: $PROOT_BIN" ok "${status:-version unknown}"
    else
        report "proot binary missing: $PROOT_BIN" warn "Run 'jroot init <image>' or reinstall to fix."
    fi

    if command -v python3 >/dev/null 2>&1; then
        report "python3 (seccomp launcher): $(command -v python3)" ok
        [ -x "$SECCOMP_LAUNCHER" ] && report "seccomp launcher: $SECCOMP_LAUNCHER" ok || report "seccomp launcher missing: $SECCOMP_LAUNCHER" warn
    else
        report "python3 not found" warn "seccomp filter and Landlock allowlist will both be disabled"
    fi

    # Kernel side of the sandbox: seccomp filter mode and Landlock ABI.
    local feats seccomp_avail landlock_abi
    feats="$(kernel_features)"
    seccomp_avail="${feats#seccomp=}"; seccomp_avail="${seccomp_avail%% *}"
    landlock_abi="${feats##*landlock=}"
    case "$seccomp_avail" in
        yes) report "kernel seccomp filter mode" ok "openat2 / io_uring escape vectors are blocked" ;;
        no)  report "kernel lacks seccomp filter mode" warn "WSL1 or CONFIG_SECCOMP_FILTER=n - jails run without syscall filtering" ;;
        *)   report "kernel seccomp support unknown" warn "could not probe (no python3?)" ;;
    esac
    case "$landlock_abi" in
        ''|unknown) report "kernel Landlock support unknown" warn "could not probe (no python3?)" ;;
        no) report "kernel lacks Landlock" warn "no kernel-enforced path allowlist; falling back to proot + seccomp + shim" ;;
        *)  report "kernel Landlock ABI v$landlock_abi" ok "~/.jroot is denied and ro mounts are enforced by the kernel" ;;
    esac
    if [ -n "${JROOT_LANDLOCK_OFF:-}" ]; then
        report "Landlock disabled by JROOT_LANDLOCK_OFF" warn "unset it to re-enable the kernel path allowlist"
    fi

    # Check gcc and show mute status
    if ! command -v gcc >/dev/null 2>&1; then
        local mute_file="$JROOT_HOME/.mute-warnings"
        local mute_until=""
        if [ -f "$mute_file" ]; then
            mute_until="$(cat "$mute_file" 2>/dev/null || true)"
        fi
        local now="$(date +%s)"
        if [ -n "$mute_until" ] && [ "$mute_until" -gt "$now" ]; then
            local remaining=$((mute_until - now))
            local days=$((remaining / 86400))
            local hours=$(( (remaining % 86400) / 3600 ))
            report "gcc not found (muted)" warn "Warnings silenced for ${days}d ${hours}h (until $(date -d "@$mute_until" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "unknown"))"
        else
            report "gcc not found" warn "'jroot port' unavailable (ro mounts still enforced by Landlock). Install gcc or mute: jroot doctor --mute=7d"
        fi
    else
        report "gcc: $(command -v gcc)" ok
    fi

    local cfgs=() cfg name rootfs
    shopt -s nullglob
    cfgs=("$CONFIGS_DIR"/*.json)
    shopt -u nullglob
    if [ "${#cfgs[@]}" -eq 0 ]; then
        log "  No jails yet. Create one: jroot init ubuntu:22.04"
    else
        for cfg in "${cfgs[@]}"; do
            name="$(basename "$cfg" .json)"
            rootfs="$ROOTS_DIR/$name"
            if [ -f "$cfg" ] && [ -n "$(config_field "$cfg" image)" ]; then
                report "jail '$name' config" ok
            else
                report "jail '$name' config" fail "$cfg"
            fi
            if [ -d "$rootfs" ] && [ -f "$rootfs/etc/os-release" ]; then
                local size
                size="$(du -sh "$rootfs" 2>/dev/null | awk '{print $1}')"
                report "jail '$name' rootfs" ok "${rootfs} (${size})"
            else
                report "jail '$name' rootfs" fail "$rootfs missing or incomplete"
            fi
            case "$(shim_status "$name")" in
                host)    report "jail '$name' shim: host build" ok "per-jail address, ports and /proc hiding are active" ;;
                local)   report "jail '$name' shim: built inside the jail" ok "its libc differs from the host's" ;;
                none)    report "jail '$name' shim: unavailable" warn "no per-jail address, 'jroot port' inert, host processes visible in /proc. Fix: jroot install $name gcc" ;;
                *)       report "jail '$name' shim: not decided yet" ok "resolved on the next 'jroot enter'" ;;
            esac
        done
    fi

    printf '\n  Summary: %d ok, %d warn, %d fail\n' "$ok" "$warn" "$fail"
    [ "$fail" -eq 0 ]
}

cmd_update() {
    ensure_runtime
    local name="" arg
    for arg in "$@"; do
        if [ -f "$CONFIGS_DIR/$arg.json" ]; then
            name="$arg"
        elif [ -z "$name" ]; then
            name="$arg"
        else
            err "Usage: jroot update [name]"
        fi
    done

    if [ -n "$name" ]; then
        [ -d "$ROOTS_DIR/$name" ] || err "Rootfs for '$name' is missing. Recreate it: jroot rm $name && jroot init <image>"
        local image_tag distro version
        image_tag="$(config_field "$CONFIGS_DIR/$name.json" image)"
        distro="${image_tag%%:*}"
        version="${image_tag#*:}"
        
        write_rootfs_niceties "$name"
        
        # Update based on distro
        if [ "$distro" = "ubuntu" ]; then
            local codename
            codename="$(version_to_codename "$version" 2>/dev/null || true)"
            [ -n "$codename" ] || codename="noble"
            log "Refreshing apt config for '$name'..."
            config_apt "$name" "$codename"
            write_sudoers "$name"
            log "Updating packages inside '$name' (apt-get update && upgrade)..."
            run_in_jail --root "$name" /bin/sh -c "
                export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
                export DEBIAN_FRONTEND=noninteractive
                dpkg --configure -a 2>/dev/null || true
                apt-get update || true
                apt-get upgrade -y --allow-unauthenticated || true
            " || { warn "Package upgrade inside '$name' failed (network?)."; record_event "$name" "update" "FAILED (apt)"; return 1; }
        elif [ "$distro" = "alpine" ]; then
            log "Refreshing apk config for '$name'..."
            config_apk "$name" "$version"
            log "Updating packages inside '$name' (apk update && upgrade)..."
            run_in_jail --root "$name" /bin/sh -c "
                export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
                apk update
                apk upgrade --no-cache
            " || { warn "Package upgrade inside '$name' failed (network?)."; record_event "$name" "update" "FAILED (apk)"; return 1; }
        else
            err "Unknown distro: $distro"
        fi
        
        if [ "$(config_field "$CONFIGS_DIR/$name.json" user)" = "unroot" ]; then
            if [ "$distro" = "ubuntu" ]; then
                setup_unroot_user "$name"
            elif [ "$distro" = "alpine" ]; then
                setup_unroot_alpine "$name"
            fi
        fi
        log "Jail '$name' is up to date."
        record_event "$name" "update" "packages upgraded ($distro $version)"
        return 0
    fi

    log "Updating proot runtime..."
    install_proot
    log "proot is up to date: $("$PROOT_BIN" --version 2>/dev/null | grep -m1 -oE 'v?[0-9]+\.[0-9]+\.[0-9]+' || true)"

    local cfgs=() cfg
    shopt -s nullglob
    cfgs=("$CONFIGS_DIR"/*.json)
    shopt -u nullglob
    if [ "${#cfgs[@]}" -eq 0 ]; then
        log "No jails to update."
        return 0
    fi
    for cfg in "${cfgs[@]}"; do
        cmd_update "$(basename "$cfg" .json)" || true
    done
}

cmd_info() {
    [ $# -le 1 ] || err "Usage: jroot info [name]"
    local name="${1:-}"
    if [ -z "$name" ]; then
        name="$(first_jail 2>/dev/null || true)"
        [ -n "$name" ] || err "No jails found. Create one first: jroot init ubuntu:22.04"
    fi
    local cfg="$CONFIGS_DIR/$name.json"
    [ -f "$cfg" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."

    local rootfs="$ROOTS_DIR/$name" size snaps snapshots_dir count
    if [ -d "$rootfs" ]; then
        size="$(du -sh "$rootfs" 2>/dev/null | awk '{print $1}')"
    else
        size="(missing)"
    fi
    snapshots_dir="$SNAPSHOTS_DIR/$name"
    count=0
    shopt -s nullglob
    snaps=("$snapshots_dir"/*.tar.gz)
    shopt -u nullglob
    count="${#snaps[@]}"

    printf 'Jail: %s\n' "$name"
    printf '  image:            %s\n' "$(config_field "$cfg" image)"
    printf '  user:             %s\n' "$(config_field "$cfg" user)"
    printf '  build_essential:  %s\n' "$(config_field "$cfg" build_essential)"
    printf '  mount_host (/):   %s\n' "$(config_field "$cfg" mount_host)"
    printf '  mount_home (~):   %s\n' "$(config_field "$cfg" mount_home)"
    printf '  rootfs:           %s  (%s)\n' "$rootfs" "$size"
    printf '  snapshots:        %s\n' "$count"
    if [ "$count" -gt 0 ]; then
        printf '  last snapshot:    %s\n' "$(basename "${snaps[$((count-1))]}" .tar.gz)"
    fi
}

# ---------------------------------------------------------------------------
# jroot history - what has been done to a jail, and when
# ---------------------------------------------------------------------------
history_render() {
    # $1 = jail name, $2 = limit (0 = all), $3 = 1 to prefix the jail column
    local name="$1" limit="$2" with_jail="$3"
    local file epoch event detail when
    file="$(history_file "$name")"
    [ -f "$file" ] || return 0
    local lines
    if [ "$limit" -gt 0 ]; then
        lines="$(tail -n "$limit" "$file")"
    else
        lines="$(cat "$file")"
    fi
    printf '%s\n' "$lines" | while IFS=$'\t' read -r epoch event detail; do
        [ -n "$epoch" ] || continue
        when="$(date -d "@$epoch" '+%Y-%m-%d %H:%M' 2>/dev/null \
             || date -r "$epoch" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$epoch")"
        if [ "$with_jail" = "1" ]; then
            printf '%b%-16s%b %b%-12s%b %-14s %s\n' \
                "$D" "$when" "$N" "$G" "$name" "$N" "$event" "$detail"
        else
            printf '%b%-16s%b %b%-14s%b %s\n' \
                "$D" "$when" "$N" "$G" "$event" "$N" "$detail"
        fi
    done
}

history_json() {
    # $1 = jail name. Emits the jail's events as a JSON array.
    local name="$1" file epoch event detail first=1
    file="$(history_file "$name")"
    printf '['
    if [ -f "$file" ]; then
        while IFS=$'\t' read -r epoch event detail; do
            [ -n "$epoch" ] || continue
            [ "$first" = 1 ] || printf ','
            first=0
            printf '\n  {"jail": "%s", "time": %s, "event": "%s", "detail": "%s"}' \
                "$(json_esc "$name")" "$epoch" "$(json_esc "$event")" "$(json_esc "$detail")"
        done < "$file"
    fi
    [ "$first" = 1 ] && printf ']\n' || printf '\n]\n'
}

cmd_history() {
    local name="" limit=0 as_json=0 do_clear=0 arg
    for arg in "$@"; do
        case "$arg" in
            --json)     as_json=1 ;;
            --clear)    do_clear=1 ;;
            --limit=*)  limit="${arg#*=}" ;;
            -n)         err "Use --limit=<n> instead of -n." ;;
            --*)        err "Unknown flag: $arg (try '${CMD_HINT}help history')" ;;
            *)
                [ -z "$name" ] || err "Only one jail name accepted, got '$arg'."
                name="$arg"
                ;;
        esac
    done
    case "$limit" in
        ''|*[!0-9]*) err "--limit must be a number, got '$limit'." ;;
    esac

    if [ -n "$name" ]; then
        [ -f "$CONFIGS_DIR/$name.json" ] || [ -f "$(history_file "$name")" ] \
            || err "Jail '$name' not found. Run 'jroot list' to see jails."
    fi

    if [ "$do_clear" = 1 ]; then
        [ -n "$name" ] || err "Usage: jroot history <name> --clear"
        rm -f "$(history_file "$name")"
        log "History for '$name' cleared."
        return 0
    fi

    # Which jails to show: the named one, or every jail that has a log.
    local names=() n
    if [ -n "$name" ]; then
        names=("$name")
    else
        shopt -s nullglob
        for n in "$HISTORY_DIR"/*.log; do
            names+=("$(basename "$n" .log)")
        done
        shopt -u nullglob
    fi

    if [ "${#names[@]}" -eq 0 ]; then
        if [ "$as_json" = 1 ]; then
            printf '[]\n'
        else
            log "No history recorded yet. It starts building as you use jroot."
        fi
        return 0
    fi

    if [ "$as_json" = 1 ]; then
        if [ "${#names[@]}" -eq 1 ]; then
            history_json "${names[0]}"
        else
            # Merge the per-jail arrays into one array.
            printf '[\n'
            local first=1 body
            for n in "${names[@]}"; do
                body="$(history_json "$n" | sed '1d;$d')"
                [ -n "$body" ] || continue
                [ "$first" = 1 ] || printf ',\n'
                first=0
                printf '%s' "$body"
            done
            printf '\n]\n'
        fi
        return 0
    fi

    if [ "${#names[@]}" -eq 1 ]; then
        printf '%bHistory of jail '\''%s'\''%b\n' "$H" "${names[0]}" "$N"
        printf '%b%-16s %-14s %s%b\n' "$D" "WHEN" "EVENT" "DETAIL" "$N"
        history_render "${names[0]}" "$limit" 0
        [ -f "$(history_file "${names[0]}")" ] || \
            log "Nothing recorded for '${names[0]}' yet."
        return 0
    fi

    # All jails, oldest first across the whole install.
    printf '%bHistory of all jails%b\n' "$H" "$N"
    printf '%b%-16s %-12s %-14s %s%b\n' "$D" "WHEN" "JAIL" "EVENT" "DETAIL" "$N"
    local merged
    merged="$(for n in "${names[@]}"; do
        sed "s|^\([0-9]*\)\t|\1\t$n\t|" "$(history_file "$n")" 2>/dev/null
    done | sort -n)"
    [ -n "$merged" ] || { log "No history recorded yet."; return 0; }
    if [ "$limit" -gt 0 ]; then
        merged="$(printf '%s\n' "$merged" | tail -n "$limit")"
    fi
    local epoch jail event detail when
    printf '%s\n' "$merged" | while IFS=$'\t' read -r epoch jail event detail; do
        [ -n "$epoch" ] || continue
        when="$(date -d "@$epoch" '+%Y-%m-%d %H:%M' 2>/dev/null \
             || date -r "$epoch" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$epoch")"
        printf '%b%-16s%b %b%-12s%b %-14s %s\n' \
            "$D" "$when" "$N" "$G" "$jail" "$N" "$event" "$detail"
    done
}

# ---------------------------------------------------------------------------
# jroot compare - config + package differences between two jails
# ---------------------------------------------------------------------------
jail_distro_of() {
    local rootfs="$ROOTS_DIR/$1"
    [ -f "$rootfs/etc/os-release" ] || { printf 'unknown'; return 0; }
    ( . "$rootfs/etc/os-release" 2>/dev/null; printf '%s' "${ID:-unknown}" )
}

# jail_packages <name> <all|manual> -> sorted package names on stdout
jail_packages() {
    local name="$1" scope="${2:-manual}" distro
    distro="$(jail_distro_of "$name")"
    case "$distro" in
        alpine)
            if [ "$scope" = "all" ]; then
                run_in_jail --root "$name" /bin/sh -c \
                    "apk info 2>/dev/null | sort" 2>/dev/null
            else
                # /etc/apk/world is exactly the explicitly-installed set.
                sed 's/[<>=].*//' "$ROOTS_DIR/$name/etc/apk/world" 2>/dev/null | sort
            fi
            ;;
        *)
            if [ "$scope" = "all" ]; then
                run_in_jail --root "$name" /bin/sh -c \
                    "dpkg-query -W -f '\${Package}\n' 2>/dev/null | sort" 2>/dev/null
            else
                run_in_jail --root "$name" /bin/sh -c \
                    "apt-mark showmanual 2>/dev/null | sort" 2>/dev/null
            fi
            ;;
    esac
}

compare_row() {
    # $1 label, $2 value A, $3 value B
    local mark=" " color="$N"
    if [ "$2" != "$3" ]; then
        mark="*"; color="$C_YEL"
    fi
    printf '  %b%s%b %-18s %-24s %s\n' "$color" "$mark" "$N" "$1" "$2" "$3"
}

cmd_compare() {
    ensure_runtime
    local a="" b="" scope="manual" arg
    for arg in "$@"; do
        case "$arg" in
            --all)      scope="all" ;;
            --manual)   scope="manual" ;;
            --*)        err "Unknown flag: $arg (try '${CMD_HINT}help compare')" ;;
            *)
                if [ -z "$a" ]; then a="$arg"
                elif [ -z "$b" ]; then b="$arg"
                else err "Usage: jroot compare <jailA> <jailB> [--all]"
                fi
                ;;
        esac
    done
    [ -n "$a" ] && [ -n "$b" ] || err "Usage: jroot compare <jailA> <jailB> [--all]"
    [ "$a" != "$b" ] || err "Both names are '$a' - nothing to compare."
    local cfa="$CONFIGS_DIR/$a.json" cfb="$CONFIGS_DIR/$b.json"
    [ -f "$cfa" ] || err "Jail '$a' not found. Run 'jroot list' to see jails."
    [ -f "$cfb" ] || err "Jail '$b' not found. Run 'jroot list' to see jails."

    printf '%bComparing '\''%s'\'' vs '\''%s'\''%b   (%b*%b = differs)\n\n' \
        "$H" "$a" "$b" "$N" "$C_YEL" "$N"

    printf '%bCONFIG%b\n' "$H" "$N"
    printf '    %-18s %-24s %s\n' "FIELD" "$a" "$b"
    local f
    for f in image user build_essential mount_host mount_home; do
        compare_row "$f" "$(config_field "$cfa" "$f")" "$(config_field "$cfb" "$f")"
    done
    local pa pb ma mb sa sb
    pa="$(config_ports "$cfa")"; pb="$(config_ports "$cfb")"
    compare_row "ports" "${pa:-none}" "${pb:-none}"
    ma="$(config_mounts "$cfa" | awk '{printf "%s ", $1}' | sed 's/ $//')"
    mb="$(config_mounts "$cfb" | awk '{printf "%s ", $1}' | sed 's/ $//')"
    compare_row "mounts" "${ma:-none}" "${mb:-none}"
    compare_row "distro" "$(jail_distro_of "$a")" "$(jail_distro_of "$b")"
    sa="$(du -sh "$ROOTS_DIR/$a" 2>/dev/null | awk '{print $1}')"
    sb="$(du -sh "$ROOTS_DIR/$b" 2>/dev/null | awk '{print $1}')"
    compare_row "rootfs size" "${sa:-missing}" "${sb:-missing}"

    printf '\n%bPACKAGES%b %b(%s)%b\n' "$H" "$N" "$D" \
        "$([ "$scope" = all ] && printf 'every installed package' || printf 'explicitly installed; --all for every package')" "$N"
    local tmp_a tmp_b
    tmp_a="$(mktemp)"; tmp_b="$(mktemp)"
    jail_packages "$a" "$scope" > "$tmp_a" 2>/dev/null || true
    jail_packages "$b" "$scope" > "$tmp_b" 2>/dev/null || true
    # run_in_jail may emit CRs or blank lines; normalise before diffing.
    sed -i 's/\r$//; /^$/d' "$tmp_a" "$tmp_b" 2>/dev/null || true

    if [ ! -s "$tmp_a" ] && [ ! -s "$tmp_b" ]; then
        warn "Could not read package lists from either jail (is the rootfs bootstrapped?)."
        rm -f "$tmp_a" "$tmp_b"
        return 0
    fi

    local only_a only_b both
    only_a="$(comm -23 "$tmp_a" "$tmp_b")"
    only_b="$(comm -13 "$tmp_a" "$tmp_b")"
    both="$(comm -12 "$tmp_a" "$tmp_b" | wc -l | tr -d ' ')"

    printf '    %s: %s packages, %s: %s packages, %s shared\n' \
        "$a" "$(wc -l < "$tmp_a" | tr -d ' ')" \
        "$b" "$(wc -l < "$tmp_b" | tr -d ' ')" "$both"

    if [ -z "$only_a" ] && [ -z "$only_b" ]; then
        printf '  %b= identical package sets%b\n' "$G" "$N"
    else
        if [ -n "$only_a" ]; then
            printf '\n  %bonly in %s:%b\n' "$G" "$a" "$N"
            printf '%s\n' "$only_a" | sed 's/^/    + /'
        fi
        if [ -n "$only_b" ]; then
            printf '\n  %bonly in %s:%b\n' "$B" "$b" "$N"
            printf '%s\n' "$only_b" | sed 's/^/    + /'
        fi
    fi
    rm -f "$tmp_a" "$tmp_b"
}

# ---------------------------------------------------------------------------
# jroot which - find a program (or file) across jails, from the host side
# ---------------------------------------------------------------------------
JAIL_PATH_DIRS="usr/local/sbin usr/local/bin usr/sbin usr/bin sbin bin usr/games"

# which_in_jail <name> <program> <all>
# Prints "<jail>\t<path inside jail>" per hit. Returns 1 when nothing matched.
which_in_jail() {
    local name="$1" prog="$2" want_all="$3"
    local rootfs="$ROOTS_DIR/$name" dir cand found=1
    [ -d "$rootfs" ] || return 1
    case "$prog" in
        /*)
            # Absolute path: check that exact location inside the rootfs.
            if [ -e "$rootfs$prog" ]; then
                printf '%s\t%s\n' "$name" "$prog"
                found=0
            fi
            ;;
        */*)
            err "Give a program name, or an absolute path starting with '/'."
            ;;
        *)
            for dir in $JAIL_PATH_DIRS; do
                cand="$rootfs/$dir/$prog"
                if [ -f "$cand" ] || [ -L "$cand" ]; then
                    printf '%s\t/%s/%s\n' "$name" "$dir" "$prog"
                    found=0
                    [ "$want_all" = "1" ] || break
                fi
            done
            ;;
    esac
    return "$found"
}

cmd_which() {
    local jail="" prog="" want_all=0 arg
    for arg in "$@"; do
        case "$arg" in
            --all|-a)  want_all=1 ;;
            --*)       err "Unknown flag: $arg (try '${CMD_HINT}help which')" ;;
            *)
                # "jroot which <prog>" or "jroot which <jail> <prog>"
                if [ -z "$prog" ] && [ -z "$jail" ]; then
                    prog="$arg"
                elif [ -z "$jail" ] && [ -f "$CONFIGS_DIR/$prog.json" ]; then
                    jail="$prog"; prog="$arg"
                else
                    err "Usage: jroot which [jail] <program> [--all]"
                fi
                ;;
        esac
    done
    [ -n "$prog" ] || err "Usage: jroot which [jail] <program> [--all]"

    local names=() n hits=0 line
    if [ -n "$jail" ]; then
        [ -f "$CONFIGS_DIR/$jail.json" ] || err "Jail '$jail' not found. Run 'jroot list' to see jails."
        names=("$jail")
    else
        shopt -s nullglob
        for n in "$CONFIGS_DIR"/*.json; do
            names+=("$(basename "$n" .json)")
        done
        shopt -u nullglob
        [ "${#names[@]}" -gt 0 ] || err "No jails found. Create one first: jroot init ubuntu:22.04"
    fi

    for n in "${names[@]}"; do
        while IFS=$'\t' read -r _ line; do
            [ -n "$line" ] || continue
            printf '%b%-16s%b %s\n' "$G" "$n" "$N" "$line"
            hits=$((hits + 1))
        done < <(which_in_jail "$n" "$prog" "$want_all" || true)
    done

    if [ "$hits" -eq 0 ]; then
        warn "'$prog' not found in $([ -n "$jail" ] && printf "jail '%s'" "$jail" || printf '%s jail(s)' "${#names[@]}")."
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# jroot ssh <name> start|stop|status|passwd|log [flags]
#
# Starts an SSH daemon inside the jail as a PERSISTENT background proot instance,
# so the jail keeps running - and stays reachable - after the user exits their
# interactive shell.
#
# PORTS: sshd binds the external port directly, on 0.0.0.0, and the port is added
# to the jail's public list so the bind() shim leaves it there instead of pinning
# it to the jail's loopback address. No redirector, nothing to keep in sync. The
# port must be above 1024: fake root is not CAP_NET_BIND_SERVICE, so a rootless
# jail cannot bind a privileged port (the shim's JROOT_PORT_MAP can move a
# privileged port a service demands onto a high one, but that does not make the
# low port reachable, so it is not used here).
#
# PRIVILEGE SEPARATION: OpenSSH's pre-auth child chroots into an empty directory
# and dies if it cannot - which it cannot under fake root - and the option to
# disable that was removed in 7.5. jroot starts sshd with JROOT_FAKE_PRIVSEP=1
# so the shim reports success for chroot() and friends. That relaxes the daemon's
# own hardening, not the jail's: proot, seccomp and Landlock all still apply.
#
# CREDENTIALS - the design rules, because this is a network-facing service:
#   * No password is ever hardcoded, defaulted, or reused across jails.
#   * The plaintext password is NEVER written to the host filesystem, never
#     placed in a command line (argv is world-readable via /proc on the host),
#     and never recorded in the jail history log. It reaches `chpasswd` only
#     through a pipe on stdin.
#   * If the caller gives nothing, jroot prompts with echo off. In a
#     non-interactive run it generates a strong random password and prints it
#     exactly once - it cannot be recovered afterwards, only replaced.
#   * `--password=` exists for automation but warns, because the value lands
#     in shell history and is briefly visible in the host's process list.
#   * root login over SSH is refused unless explicitly asked for.
#
# Auto-port: 22001, 22002, ... picking the first one that is not already
# in use by another jail's SSH or occupied on the host.
# ---------------------------------------------------------------------------
SSH_BASE_PORT=22001

ssh_port_file() { printf '%s' "$JROOT_HOME/pids/$1.sshport"; }
ssh_pid_file()  { printf '%s' "$JROOT_HOME/pids/$1.sshd"; }

ssh_port_in_use() {
    # Returns 0 if port $1 is already bound on the host.
    local port="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -tlnH "sport = :$port" 2>/dev/null | grep -q . && return 0
    elif command -v netstat >/dev/null 2>&1; then
        netstat -tlnp 2>/dev/null | grep -q ":$port " && return 0
    fi
    # Fallback: see whether anything accepts a connection there.
    (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && return 0
    return 1
}

ssh_auto_port() {
    # Find the lowest free port in 22001..22099 that is not claimed by another
    # jail AND not already bound on the host.
    local port claimed=()
    shopt -s nullglob
    for f in "$JROOT_HOME/pids"/*.sshport; do
        claimed+=("$(cat "$f" 2>/dev/null)")
    done
    shopt -u nullglob
    for port in $(seq "$SSH_BASE_PORT" $(( SSH_BASE_PORT + 98 )) ); do
        local skip=0 c
        for c in "${claimed[@]}"; do
            [ "$c" = "$port" ] && { skip=1; break; }
        done
        [ "$skip" = 1 ] && continue
        ssh_port_in_use "$port" && continue
        printf '%s' "$port"
        return 0
    done
    return 1
}

# The account SSH logins should use, unless --user says otherwise. An unroot
# jail already has the non-root 'jail' user as its daily identity, so that is
# the natural SSH account; a root jail has only root.
ssh_default_user() {
    local name="$1" user_mode
    user_mode="$(config_field "$CONFIGS_DIR/$name.json" user)"
    if [ "$user_mode" = "unroot" ]; then
        printf 'jail'
    else
        printf 'root'
    fi
}

# A strong random password, printed once and never stored. Tries the best
# available source and falls back through them rather than silently producing
# something weak.
ssh_random_password() {
    local pw=""
    if command -v python3 >/dev/null 2>&1; then
        pw="$(python3 -c 'import secrets,string
a=string.ascii_letters+string.digits
print("".join(secrets.choice(a) for _ in range(24)))' 2>/dev/null || true)"
    fi
    if [ -z "$pw" ] && command -v openssl >/dev/null 2>&1; then
        pw="$(openssl rand -base64 32 2>/dev/null | tr -dc 'A-Za-z0-9' | cut -c1-24 || true)"
    fi
    if [ -z "$pw" ] && [ -r /dev/urandom ]; then
        pw="$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom 2>/dev/null | head -c 24 || true)"
    fi
    [ -n "$pw" ] || return 1
    printf '%s' "$pw"
}

# Prompt for a password twice with echo off. Writes prompts to stderr so the
# password itself is the only thing on stdout.
ssh_prompt_password() {
    local user="$1" pw1 pw2
    [ -t 0 ] || return 1
    while true; do
        printf 'New SSH password for %s (not echoed, empty = generate one): ' "$user" >&2
        read -rs pw1 || { printf '\n' >&2; return 1; }
        printf '\n' >&2
        if [ -z "$pw1" ]; then
            return 1   # caller falls back to a generated password
        fi
        printf 'Repeat password: ' >&2
        read -rs pw2 || { printf '\n' >&2; return 1; }
        printf '\n' >&2
        if [ "$pw1" != "$pw2" ]; then
            warn "Passwords do not match. Try again."
            continue
        fi
        if [ "${#pw1}" -lt 8 ]; then
            warn "That password is ${#pw1} characters. This service can be reachable from the network - 12+ is strongly recommended."
            local yn
            printf 'Use it anyway? [y/N]: ' >&2
            read -r yn || yn="N"
            case "$yn" in y|Y|yes|YES) ;; *) continue ;; esac
        fi
        printf '%s' "$pw1"
        return 0
    done
}

# ssh_set_password <jail> <user> - password arrives on STDIN, never in argv.
# Tries chpasswd, then passwd fed twice, then a host-computed SHA-512 hash
# written straight into /etc/shadow. Returns non-zero only if all three fail.
ssh_set_password() {
    local name="$1" user="$2" pw
    IFS= read -r pw || true
    [ -n "$pw" ] || return 1

    # 1) chpasswd reads "user:password" from stdin (shadow-utils and busybox).
    if printf '%s:%s\n' "$user" "$pw" \
        | run_in_jail --root "$name" /bin/sh -c 'chpasswd 2>/dev/null' >/dev/null 2>&1; then
        return 0
    fi

    # 2) passwd, fed the password twice.
    if printf '%s\n%s\n' "$pw" "$pw" \
        | run_in_jail --root "$name" /bin/sh -c "passwd '$user' >/dev/null 2>&1"; then
        return 0
    fi

    # 3) Hash on the host, then rewrite the shadow entry. crypt() lives in the
    # host's libc here, so the hash is portable to the jail's /etc/shadow.
    local hash=""
    if command -v python3 >/dev/null 2>&1; then
        hash="$(printf '%s' "$pw" | python3 -c '
import crypt, sys
try:
    print(crypt.crypt(sys.stdin.read(), crypt.mksalt(crypt.METHOD_SHA512)))
except Exception:
    pass' 2>/dev/null || true)"
    fi
    if [ -z "$hash" ] && command -v openssl >/dev/null 2>&1; then
        hash="$(printf '%s' "$pw" | openssl passwd -6 -stdin 2>/dev/null || true)"
    fi
    [ -n "$hash" ] || return 1
    printf '%s' "$hash" | run_in_jail --root "$name" /bin/sh -c "
        IFS= read -r h
        [ -n \"\$h\" ] || exit 1
        [ -f /etc/shadow ] || exit 1
        awk -v u='$user' -v h=\"\$h\" -F: 'BEGIN{OFS=\":\"} \$1==u{\$2=h} {print}' \
            /etc/shadow > /etc/shadow.jroot.new 2>/dev/null || exit 1
        grep -q \"^$user:\" /etc/shadow.jroot.new || { rm -f /etc/shadow.jroot.new; exit 1; }
        cat /etc/shadow.jroot.new > /etc/shadow
        rm -f /etc/shadow.jroot.new
        chmod 640 /etc/shadow 2>/dev/null || true
    " >/dev/null 2>&1
}

# Install a public key into <user>'s authorized_keys inside the jail.
ssh_install_key() {
    local name="$1" user="$2" keyfile="$3"
    [ -f "$keyfile" ] || err "Public key file not found: $keyfile"
    case "$(head -c 4 "$keyfile" 2>/dev/null)" in
        ssh-|ecds|sk-s) ;;
        *) grep -qE '^(ssh|ecdsa|sk)-' "$keyfile" 2>/dev/null \
               || err "$keyfile does not look like an OpenSSH public key. Point --key at a .pub file, not a private key." ;;
    esac
    grep -q 'PRIVATE KEY' "$keyfile" 2>/dev/null \
        && err "$keyfile is a PRIVATE key. Use the matching .pub file instead."
    local home
    if [ "$user" = "root" ]; then home="/root"; else home="/home/$user"; fi
    cat "$keyfile" | run_in_jail --root "$name" /bin/sh -c "
        mkdir -p '$home/.ssh' 2>/dev/null || exit 1
        cat >> '$home/.ssh/authorized_keys' || exit 1
        chmod 700 '$home/.ssh' 2>/dev/null || true
        chmod 600 '$home/.ssh/authorized_keys' 2>/dev/null || true
        chown -R '$user' '$home/.ssh' 2>/dev/null || true
    " >/dev/null 2>&1 || return 1
    return 0
}

ssh_status() {
    local name="$1"
    local pidfile portfile pid port user auth
    pidfile="$(ssh_pid_file "$name")"
    portfile="$(ssh_port_file "$name")"
    if [ ! -f "$pidfile" ]; then
        log "SSH for '$name': stopped"
        return 1
    fi
    pid="$(cat "$pidfile" 2>/dev/null | tr -d ' ')"
    if ! kill -0 "$pid" 2>/dev/null; then
        warn "SSH for '$name': stale pid file (pid $pid is gone). Cleaning up."
        rm -f "$pidfile" "$portfile"
        return 1
    fi
    port="$(cat "$portfile" 2>/dev/null || echo '?')"
    user="$(config_field "$CONFIGS_DIR/$name.json" ssh_user)"
    [ -n "$user" ] || user="$(ssh_default_user "$name")"
    auth="$(config_field "$CONFIGS_DIR/$name.json" ssh_auth)"
    log "SSH for '$name': running (pid $pid, port $port)"
    printf '  login user:  %s\n' "$user"
    printf '  auth:        %s\n' "${auth:-password}"
    printf '  connect:     ssh -p %s %s@<host-ip>\n' "$port" "$user"
    printf '  locally:     ssh -p %s %s@127.0.0.1\n' "$port" "$user"
    printf '  sshd log:    %s\n' "$JROOT_HOME/pids/$name.sshlog"
    printf '  new password: jroot ssh %s passwd\n' "$name"
    # A live socket does not prove a working daemon - read the banner.
    local banner
    banner="$(ssh_banner_probe 127.0.0.1 "$port")"
    case "$banner" in
        SSH-*) printf '  handshake:   %bok%b (%s)\n' "$G" "$N" "${banner%%$'\r'*}" ;;
        *)
            printf '  handshake:   %bFAILING%b - closes without an SSH banner\n' "$C_RED" "$C_NC"
            warn "sshd is listening but not completing a handshake (usually its privilege-separation child failing). See: jroot ssh $name log"
            return 1
            ;;
    esac
    return 0
}

ssh_stop() {
    local name="$1"
    local pidfile portfile pid port
    pidfile="$(ssh_pid_file "$name")"
    portfile="$(ssh_port_file "$name")"
    if [ ! -f "$pidfile" ]; then
        log "SSH for '$name' is not running."
        return 0
    fi
    pid="$(cat "$pidfile" 2>/dev/null | tr -d ' ')"
    port="$(cat "$portfile" 2>/dev/null || echo '?')"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        log "Stopping SSH for '$name' (pid $pid, port $port)..."
        # ssh_start launched this with job control on, so $pid leads its own
        # process group and a group kill reaches proot and sshd without
        # touching jroot or the user's shell. Only signal the group when it
        # really is a separate one - killing our own group would take the
        # caller's terminal down with it.
        local pgid mypgid
        pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')"
        mypgid="$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')"
        if [ -n "$pgid" ] && [ "$pgid" != "0" ] && [ "$pgid" != "$mypgid" ]; then
            kill -TERM -"$pgid" 2>/dev/null || true
            sleep 0.3
            kill -KILL -"$pgid" 2>/dev/null || true
        else
            # Fall back to the process itself plus its direct descendants.
            local kid
            for kid in $(pgrep -P "$pid" 2>/dev/null || true); do
                kill -TERM "$kid" 2>/dev/null || true
            done
            kill -TERM "$pid" 2>/dev/null || true
            sleep 0.3
            for kid in $(pgrep -P "$pid" 2>/dev/null || true); do
                kill -KILL "$kid" 2>/dev/null || true
            done
            kill -KILL "$pid" 2>/dev/null || true
        fi
    fi
    # Older jroot versions ran a socat redirector alongside the daemon. Nothing
    # creates one any more, but clean up after an upgrade so the port is freed.
    local socatfile="$JROOT_HOME/pids/$name.socat" socat_pid
    if [ -f "$socatfile" ]; then
        socat_pid="$(cat "$socatfile" 2>/dev/null | tr -d ' ')"
        if [ -n "$socat_pid" ]; then
            kill -TERM "$socat_pid" 2>/dev/null || true
            sleep 0.2
            kill -KILL "$socat_pid" 2>/dev/null || true
        fi
        rm -f "$socatfile"
    fi
    rm -f "$pidfile" "$portfile" "$JROOT_HOME/pids/$name.sshinner"
    log "SSH for '$name' stopped."
    record_event "$name" "ssh" "stopped (was port $port)"
}

# Resolve the requested credential into an actual password and apply it.
# Echoes nothing sensitive to the log; the generated case is the only time a
# password is printed, and it is printed for the user, once.
# Args: <jail> <user> <mode> <value>
#   mode: prompt | stdin | arg | random | keep
ssh_apply_credential() {
    local name="$1" user="$2" mode="$3" value="$4" pw="" generated=0

    case "$mode" in
        keep)
            return 0
            ;;
        arg)
            pw="$value"
            warn "A password passed on the command line is visible in your shell history and, briefly, in the host's process list. Prefer 'jroot ssh $name start' and the prompt, or --password-stdin."
            ;;
        stdin)
            IFS= read -r pw || true
            [ -n "$pw" ] || err "--password-stdin was given but stdin was empty."
            ;;
        random)
            pw="$(ssh_random_password)" || err "Could not generate a password (no python3, openssl, or /dev/urandom)."
            generated=1
            ;;
        prompt)
            if pw="$(ssh_prompt_password "$user")"; then
                :
            else
                pw="$(ssh_random_password)" || err "Could not generate a password (no python3, openssl, or /dev/urandom)."
                generated=1
            fi
            ;;
    esac

    [ -n "$pw" ] || err "Empty password refused."
    if [ "${#pw}" -lt 8 ] && [ "$mode" != "prompt" ]; then
        warn "That password is only ${#pw} characters and this service can be reachable from the network."
    fi

    printf '%s\n' "$pw" | ssh_set_password "$name" "$user" \
        || err "Could not set the password for '$user' inside '$name'. Is the shadow suite installed? Try: jroot install $name passwd"

    if [ "$generated" = 1 ]; then
        printf '\n'
        printf '%b  Generated SSH password for %s:%b  %b%s%b\n' "$C_YEL" "$user" "$C_NC" "$C_BLD" "$pw" "$C_NC"
        printf '%b  Write it down now. It is not stored anywhere and cannot be shown again.%b\n' "$D" "$N"
        printf '%b  Replace it any time with: jroot ssh %s passwd%b\n' "$D" "$name" "$N"
        printf '\n'
    else
        log "Password set for '$user' in '$name'."
    fi
    # Provenance only - never the secret itself.
    record_event "$name" "ssh" "password set for '$user' (source: $mode)"
    return 0
}

ssh_passwd() {
    # jroot ssh <name> passwd [user] - rotate the SSH password.
    local name="$1" user="$2" mode="$3" value="$4"
    [ -n "$user" ] || user="$(config_field "$CONFIGS_DIR/$name.json" ssh_user)"
    [ -n "$user" ] || user="$(ssh_default_user "$name")"
    run_in_jail --root "$name" /bin/sh -c "id '$user' >/dev/null 2>&1" >/dev/null 2>&1 \
        || err "User '$user' does not exist inside '$name'. Create it first, or pick another with 'jroot ssh $name passwd <user>'."
    [ -n "$mode" ] || mode="prompt"
    ssh_apply_credential "$name" "$user" "$mode" "$value"
}

ssh_start() {
    # Options arrive as globals set by cmd_ssh so this stays readable:
    #   SSH_OPT_PORT SSH_OPT_USER SSH_OPT_PW_MODE SSH_OPT_PW_VALUE
    #   SSH_OPT_KEY SSH_OPT_PERMIT_ROOT SSH_OPT_NO_PASSWORD
    local name="$1"
    local cfg="$CONFIGS_DIR/$name.json"
    local rootfs="$ROOTS_DIR/$name"
    local pidfile portfile
    pidfile="$(ssh_pid_file "$name")"
    portfile="$(ssh_port_file "$name")"

    # Already running?
    if [ -f "$pidfile" ]; then
        local old_pid
        old_pid="$(cat "$pidfile" 2>/dev/null | tr -d ' ')"
        if kill -0 "$old_pid" 2>/dev/null; then
            local old_port
            old_port="$(cat "$portfile" 2>/dev/null || echo '?')"
            warn "SSH for '$name' is already running on port $old_port (pid $old_pid). Stop first: jroot ssh $name stop"
            return 1
        fi
        # Stale
        rm -f "$pidfile" "$portfile"
    fi

    # Resolve port
    local port
    if [ -n "$SSH_OPT_PORT" ]; then
        port="$SSH_OPT_PORT"
    else
        port="$(ssh_auto_port)" || err "No free SSH port in range ${SSH_BASE_PORT}..$(( SSH_BASE_PORT + 98 )). Specify one manually."
    fi
    [[ "$port" =~ ^[0-9]+$ ]] || err "Port must be a number, got '$port'"
    [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || err "Port out of range: $port"

    # Resolve the login account.
    local user="$SSH_OPT_USER"
    [ -n "$user" ] || user="$(ssh_default_user "$name")"
    [[ "$user" =~ ^[a-z_][a-z0-9_-]*$ ]] || err "Invalid SSH user name: '$user'"

    # Credentials must be settled BEFORE the daemon is exposed to the network.
    local pw_mode="$SSH_OPT_PW_MODE"
    if [ "$SSH_OPT_NO_PASSWORD" = "1" ]; then
        [ -n "$SSH_OPT_KEY" ] || err "--no-password disables password login, so a key is required. Add --key=<path-to-.pub>."
        pw_mode="keep"
    elif [ -z "$pw_mode" ]; then
        # Nothing specified: prompt when we can, generate when we cannot.
        if [ -t 0 ] && [ -z "${NONINTERACTIVE:-}" ]; then
            pw_mode="prompt"
        else
            pw_mode="random"
        fi
    fi

    # Detect distro
    local image_tag distro
    image_tag="$(config_field "$cfg" image)"
    distro="${image_tag%%:*}"

    # Install openssh-server inside the jail if not already present
    log "Ensuring openssh-server is installed in '$name'..."
    if [ "$distro" = "alpine" ]; then
        run_in_jail --root "$name" /bin/sh -c '
            command -v sshd >/dev/null 2>&1 && exit 0
            apk update >/dev/null 2>&1
            apk add --no-cache openssh-server openssh-sftp-server shadow >/dev/null 2>&1
        ' || warn "Could not install openssh-server inside '$name'."
    else
        run_in_jail --root "$name" /bin/sh -c '
            command -v sshd >/dev/null 2>&1 && exit 0
            export DEBIAN_FRONTEND=noninteractive
            apt-get update >/dev/null 2>&1
            apt-get install -y --no-install-recommends openssh-server >/dev/null 2>&1
        ' || warn "Could not install openssh-server inside '$name'."
    fi

    # Generate host keys if missing
    run_in_jail --root "$name" /bin/sh -c '
        mkdir -p /etc/ssh /run/sshd
        chmod 755 /run/sshd
        [ -f /etc/ssh/ssh_host_rsa_key ] || ssh-keygen -t rsa -f /etc/ssh/ssh_host_rsa_key -N "" -q
        [ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -t ed25519 -f /etc/ssh/ssh_host_ed25519_key -N "" -q
    ' 2>/dev/null || warn "Could not generate SSH host keys."

    # ---- privilege separation --------------------------------------------
    # OpenSSH >= 7.5 removed UsePrivilegeSeparation, so privsep is mandatory and
    # cannot be configured away. Right after accepting a connection sshd forks a
    # child and drops to the unprivileged 'sshd' account; if that account or the
    # empty chroot directory is missing, the child dies BEFORE sending its
    # version banner and the client just reports
    #   Connection closed by <host> port <port>
    # with nothing else to go on.
    #
    # Under proot this is easy to hit: the openssh-server postinst creates the
    # 'sshd' system user with adduser --system, which routinely fails in a fake-
    # root rootfs, leaving a working binary and a broken daemon. Create it here
    # rather than trusting the package, and give it the HOST's uid so that
    # setresuid() succeeds even where proot's uid faking does not cover it -
    # dropping to your own real uid is always permitted by the kernel.
    local host_uid host_gid
    host_uid="$(id -u)"; host_gid="$(id -g)"
    run_in_jail --root "$name" /bin/sh -c "
        mkdir -p /run/sshd /var/empty
        chmod 755 /run/sshd /var/empty
        if ! id sshd >/dev/null 2>&1; then
            useradd -o -u $host_uid -g $host_gid -M -d /run/sshd -s /usr/sbin/nologin sshd 2>/dev/null \
                || useradd -o -u $host_uid -M -d /run/sshd -s /usr/sbin/nologin sshd 2>/dev/null \
                || adduser -D -H -h /run/sshd -s /sbin/nologin -u $host_uid sshd 2>/dev/null \
                || printf 'sshd:x:%s:%s::/run/sshd:/usr/sbin/nologin\n' '$host_uid' '$host_gid' >> /etc/passwd
        fi
        grep -q '^sshd:' /etc/group 2>/dev/null || printf 'sshd:x:%s:\n' '$host_gid' >> /etc/group 2>/dev/null || true
        exit 0
    " >/dev/null 2>&1 || warn "Could not prepare the sshd privilege-separation account inside '$name'."

    # Make sure the login account exists before we try to give it a password.
    if [ "$user" != "root" ]; then
        run_in_jail --root "$name" /bin/sh -c "
            id '$user' >/dev/null 2>&1 && exit 0
            useradd -m -s /bin/bash '$user' 2>/dev/null \
                || adduser -D -s /bin/bash '$user' 2>/dev/null \
                || exit 1
        " >/dev/null 2>&1 || warn "Could not create user '$user' inside '$name'."
    fi

    # sshd config. Root login and password auth are both opt-in rather than
    # inherited defaults: an exposed port with PermitRootLogin yes and a
    # guessable password is exactly the failure mode this command must not have.
    local permit_root="no" password_auth="yes"
    [ "$SSH_OPT_PERMIT_ROOT" = "1" ] && permit_root="yes"
    [ "$user" = "root" ] && permit_root="yes"
    [ "$SSH_OPT_NO_PASSWORD" = "1" ] && password_auth="no"

    # ---- session wrapper -------------------------------------------------
    # sshd builds a CLEAN environment for every login: it does not pass its own
    # environment through to the session, and LD_PRELOAD is dropped on purpose.
    # The consequence was that an SSH session ran with no shim at all - a jailed
    # `ps aux` listed every host process, `~/.jroot` was visible inside host
    # mounts, and ro mounts stopped being enforced - while `jroot enter` on the
    # same jail behaved correctly.
    #
    # ForceCommand puts the environment back before handing over the shell, so an
    # SSH session gets what `jroot enter` gets. JROOT_PROC_ROOT is derived from
    # TracerPid at session time rather than baked in, because the pid tracing the
    # session IS this jail's proot, and it changes on every daemon restart.
    local session_wrapper="/usr/local/bin/jroot-session"
    write_ssh_session_wrapper "$name"

    # StrictModes and UseDNS are both off for proot-specific reasons, not
    # laziness. StrictModes rejects a login when the home directory or
    # ~/.ssh permissions look wrong, and ownership inside a fake-root rootfs is
    # exactly the kind of thing it objects to. UseDNS makes sshd do a reverse
    # lookup on every connection, which in a jail with no working resolver stalls
    # until the login grace period expires.
    # LogLevel VERBOSE so ~/.jroot/pids/<jail>.sshlog is worth reading when
    # something does go wrong.
    run_in_jail --root "$name" /bin/sh -c "
        mkdir -p /etc/ssh /run/sshd
        chmod 755 /run/sshd
        cat > /etc/ssh/sshd_config << SSHEOF
Port 22
ListenAddress 0.0.0.0
PermitRootLogin $permit_root
PasswordAuthentication $password_auth
PubkeyAuthentication yes
PermitEmptyPasswords no
ChallengeResponseAuthentication no
KbdInteractiveAuthentication no
UsePAM no
StrictModes no
UseDNS no
MaxAuthTries 4
LoginGraceTime 60
AllowUsers $user
ForceCommand $session_wrapper
AcceptEnv LANG LC_*
PrintMotd no
LogLevel VERBOSE
Subsystem sftp /usr/lib/openssh/sftp-server
PidFile /run/sshd/sshd.pid
SSHEOF
        # Alpine keeps sftp-server elsewhere; drop the line if neither exists so
        # sshd does not refuse to start over a missing subsystem binary.
        if [ -f /usr/lib/ssh/sftp-server ]; then
            sed -i 's|/usr/lib/openssh/sftp-server|/usr/lib/ssh/sftp-server|' /etc/ssh/sshd_config
        elif [ ! -f /usr/lib/openssh/sftp-server ]; then
            sed -i '/^Subsystem sftp/d' /etc/ssh/sshd_config
        fi
        # jroot targets OpenSSH 7.2 (Ubuntu 16.04) through 9.x, and keywords come
        # and go across that range - ChallengeResponseAuthentication is deprecated
        # in 8.7, and an unknown keyword is FATAL, not a warning. Rather than
        # guessing per release, ask sshd which line it hates and comment that line
        # out until the config parses.
        n=0
        while [ \$n -lt 8 ] && ! sshd -t -f /etc/ssh/sshd_config 2>/dev/null; do
            bad=\$(sshd -t -f /etc/ssh/sshd_config 2>&1 \
                  | sed -n 's/.*sshd_config line \\([0-9]*\\):.*/\\1/p' | head -n1)
            [ -n \"\$bad\" ] || break
            sed -i \"\${bad}s/^/#/\" /etc/ssh/sshd_config
            n=\$(( n + 1 ))
        done
        exit 0
    " 2>/dev/null || warn "Could not configure sshd."

    # Fail early and loudly if the config still will not parse: otherwise the
    # daemon dies at the first connection and the client only says
    # "Connection closed", which tells the user nothing.
    local cfgtest
    cfgtest="$(run_in_jail --root "$name" /bin/sh -c 'sshd -t 2>&1' 2>/dev/null || true)"
    if [ -n "$cfgtest" ]; then
        warn "sshd reported problems with its configuration inside '$name':"
        printf '%s\n' "$cfgtest" | sed 's/^/         /' >&2
    fi

    # Apply the credential. Errors here abort the start: a jail must never end
    # up listening with an unset or inherited password. stdin is left alone -
    # 'prompt' needs the terminal and 'stdin' needs the pipe.
    ssh_apply_credential "$name" "$user" "$pw_mode" "$SSH_OPT_PW_VALUE"

    # Optional public key.
    if [ -n "$SSH_OPT_KEY" ]; then
        if ssh_install_key "$name" "$user" "$SSH_OPT_KEY"; then
            log "Installed public key for '$user' from $SSH_OPT_KEY"
            record_event "$name" "ssh" "authorized_key added for '$user'"
        else
            err "Could not install the public key into '$name'."
        fi
    fi

    # Unlock the login account so sshd will accept it, and leave every other
    # account exactly as it was - in particular, root stays locked in unroot
    # jails unless root is the account being used.
    run_in_jail --root "$name" /bin/sh -c "
        passwd -u '$user' >/dev/null 2>&1 || true
        usermod -U '$user' >/dev/null 2>&1 || true
    " >/dev/null 2>&1 || true

    # Remember the login account and auth method (never the password).
    set_config_field "$cfg" ssh_user "$user" >/dev/null 2>&1 || true
    if [ "$SSH_OPT_NO_PASSWORD" = "1" ]; then
        set_config_field "$cfg" ssh_auth "key-only" >/dev/null 2>&1 || true
    elif [ -n "$SSH_OPT_KEY" ]; then
        set_config_field "$cfg" ssh_auth "password+key" >/dev/null 2>&1 || true
    else
        set_config_field "$cfg" ssh_auth "password" >/dev/null 2>&1 || true
    fi

    # Make sure the port is exposed publicly for this jail
    local cur_ports
    cur_ports="$(config_ports "$cfg")"
    if ! echo ",$cur_ports," | grep -q ",$port,"; then
        if [ -n "$cur_ports" ]; then
            set_config_ports "$cfg" $(echo "$cur_ports,$port" | tr ',' ' ') >/dev/null 2>&1
        else
            set_config_ports "$cfg" "$port" >/dev/null 2>&1
        fi
    fi

    # The jail's loopback address (or 127.0.0.1 if the jail opted out).
    local jail_lb
    jail_lb="$(jail_loopback_addr "$name")"
    [ -n "$jail_lb" ] || jail_lb="127.0.0.1"

    # ---- where does sshd listen? -----------------------------------------
    # Straight at the external port, on 0.0.0.0. No redirector, no port
    # rewriting, nothing to keep in sync: the port is in the jail's public list
    # (added just above), so the bind() shim leaves it on 0.0.0.0 instead of
    # pinning it to the jail's loopback address, and it is reachable from
    # outside immediately.
    #
    # It has to be an unprivileged port. A rootless jail has fake root, not
    # CAP_NET_BIND_SERVICE, so bind() below 1024 fails with EACCES no matter
    # how convincing getuid() looks - and the host could not bind it either.
    local internal_port="$port" mode_desc="sshd listening on 0.0.0.0:$port"
    if [ "$port" -lt 1024 ]; then
        err "Port $port is privileged (<1024) and a rootless jail cannot bind it. Pick something above 1024, e.g. 'jroot ssh $name start $(( port + 20000 ))'."
    fi

    run_in_jail --root "$name" /bin/sh -c "
        sed -i 's/^Port .*/Port $port/' /etc/ssh/sshd_config
    " >/dev/null 2>&1 || true

    log "Starting SSH daemon for '$name' on port $port..."

    # sshd's own diagnostics are the only way to see why it refused to start or
    # dropped a connection, so keep them instead of discarding them.
    local logfile="$JROOT_HOME/pids/$name.sshlog"
    : > "$logfile" 2>/dev/null || true

    # Persistent proot + sshd. sshd runs in the foreground (-D) so proot has a
    # live child and the jail stays up after this command returns.
    #
    # JROOT_FAKE_PRIVSEP is what makes sshd viable here at all: its pre-auth
    # child calls chroot("/run/sshd"), which needs CAP_SYS_CHROOT and therefore
    # fails with EPERM under fake root, killing the connection before the version
    # banner. OpenSSH removed UsePrivilegeSeparation in 7.5, so the shim reports
    # success for that step instead. See the shim source for the full rationale.
    #
    # `set -m` matters: without job control this background subshell inherits
    # jroot's OWN process group, and ssh_stop's group kill would then take out
    # the user's shell along with the daemon. With it, the subshell leads its
    # own group and the teardown is precisely scoped.
    local was_monitor=0
    case "$-" in *m*) was_monitor=1 ;; esac
    set -m
    (
        export JROOT_FAKE_PRIVSEP=1
        run_in_jail --root "$name" /usr/sbin/sshd -D -e >>"$logfile" 2>&1
    ) &
    local daemon_pid=$!
    [ "$was_monitor" = 1 ] || set +m
    echo "$daemon_pid" > "$pidfile"
    disown 2>/dev/null || true

    # Wait for the listener rather than guessing with a fixed sleep. The probe
    # opens the socket and closes it again without sending anything, so sshd
    # only logs a dropped pre-auth connection rather than a protocol error.
    local waited=0 listening=0
    while [ "$waited" -lt 60 ]; do
        if ! kill -0 "$daemon_pid" 2>/dev/null; then
            break            # died early - the log will say why
        fi
        if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
            listening=1
            break
        fi
        sleep 0.25
        waited=$(( waited + 1 ))
    done

    if [ "$listening" != 1 ]; then
        kill -TERM -"$daemon_pid" 2>/dev/null || kill -TERM "$daemon_pid" 2>/dev/null || true
        rm -f "$pidfile" "$portfile"
        warn "sshd did not come up inside '$name'."
        if [ -s "$logfile" ]; then
            warn "Last lines of $logfile:"
            tail -n 12 "$logfile" 2>/dev/null | sed 's/^/         /' >&2
        else
            warn "No output was captured. Try it in the foreground to see the error:"
            warn "  jroot exec $name --root /usr/sbin/sshd -D -e -p $port"
        fi
        record_event "$name" "ssh" "FAILED to start on port $port as '$user'"
        return 1
    fi

    echo "$port" > "$portfile"

    # ---- prove the daemon actually talks SSH -----------------------------
    # A listening socket is not the same as a working daemon. sshd forks a
    # privilege-separated child per connection, and when that child cannot start
    # it closes the socket before sending its version banner - the client then
    # reports only "Connection closed by <host> port <port>", which is useless on
    # its own. Reading the banner here catches that at start time, while the log
    # is still in hand.
    local banner=""
    banner="$(ssh_banner_probe 127.0.0.1 "$port")"
    # Those probes appear in the log as dropped connections. Say so, so the first
    # thing anyone reads in `jroot ssh <name> log` is not a mystery failure.
    printf '%s\n' "--- connections above this line are jroot's own startup probes ---" \
        >> "$logfile" 2>/dev/null || true
    case "$banner" in
        SSH-*)
            : # healthy
            ;;
        *)
            warn "The daemon is listening on port $port but closed the connection without sending an SSH banner."
            warn "That is almost always sshd's privilege-separation child failing to start inside the jail."
            if [ -s "$logfile" ]; then
                warn "Last lines of $logfile:"
                tail -n 15 "$logfile" 2>/dev/null | sed 's/^/         /' >&2
            fi
            case "$(shim_status "$name")" in
                host|local) ;;
                *) warn "The LD_PRELOAD shim is NOT active for '$name', and it is what lets sshd's chroot() succeed. Fix that first: jroot install $name gcc" ;;
            esac
            warn "Things worth trying:"
            warn "  jroot ssh $name log                       # full sshd log"
            warn "  jroot exec $name --root sshd -t           # config check"
            warn "  jroot exec $name --root id sshd           # privsep account must exist"
            warn "  jroot doctor                              # is the shim active for this jail?"
            record_event "$name" "ssh" "started on port $port but no SSH banner (privsep?)"
            ;;
    esac

    log "SSH for '$name' is running."
    log "  Port:          $port  ($mode_desc)"
    log "  Connect:       ssh -p $port $user@<host-ip>"
    if [ "$SSH_OPT_NO_PASSWORD" = "1" ]; then
        log "  Auth:          public key only (password login disabled)"
    elif [ -n "$SSH_OPT_KEY" ]; then
        log "  Auth:          password or public key"
    else
        log "  Auth:          password"
    fi
    log "  Only '$user' may log in; root login is $permit_root."
    case "$banner" in
        SSH-*) log "  Handshake:     verified (${banner%%$'\r'*})" ;;
    esac
    log "  sshd log:      $logfile"
    log "  The jail stays alive in the background for SSH access."
    record_event "$name" "ssh" "started on port $port as '$user' (root login: $permit_root)"
    return 0
}

# Install the ForceCommand wrapper that restores the jail environment for every
# SSH session. Written straight into the rootfs from the host, so there is no
# nested quoting to get wrong, and regenerated on every `jroot ssh start` so a
# config change (ports, ro mounts) takes effect on the next login.
write_ssh_session_wrapper() {
    local name="$1"
    local rootfs="$ROOTS_DIR/$name"
    local cfg="$CONFIGS_DIR/$name.json"
    local dest="$rootfs/usr/local/bin/jroot-session"
    local jail_ports jail_lb ro_mounts="" m_label m_hostpath m_mode

    jail_ports="$(config_ports "$cfg")"
    jail_lb="$(config_field "$cfg" loopback)"
    case "$jail_lb" in off|shared|disabled) jail_lb="" ;; esac
    while IFS=$'\t' read -r m_label m_hostpath m_mode; do
        [ -n "$m_label" ] || continue
        [ "$m_mode" = "ro" ] && ro_mounts="$ro_mounts:/mnt/$m_label"
    done < <(config_mounts "$cfg")
    ro_mounts="${ro_mounts#:}"

    mkdir -p "$rootfs/usr/local/bin" 2>/dev/null || return 1
    cat > "$dest" << WRAPEOF
#!/bin/sh
# Generated by 'jroot ssh $name start' - do not edit, it is rewritten on start.
#
# sshd hands each session a clean environment and deliberately drops LD_PRELOAD,
# so without this wrapper an SSH login runs with no jroot shim: host processes
# visible in /proc, ~/.jroot readable inside host mounts, ro mounts writable.
# Put the environment back, then become the shell the user asked for.

JROOT_SHIM=/usr/local/lib/libjroot.so

if [ -f "\$JROOT_SHIM" ]; then
    # The pid tracing us is this jail's proot, which is exactly what
    # JROOT_PROC_ROOT is meant to carry. Read it now, before the shim is loaded
    # and starts filtering /proc.
    JROOT_TRACER=\$(awk '/^TracerPid:/ { print \$2; exit }' /proc/self/status 2>/dev/null)
    [ -n "\$JROOT_TRACER" ] && [ "\$JROOT_TRACER" != "0" ] || JROOT_TRACER=""

    JROOT_PORTS='$jail_ports'
    JROOT_LOOPBACK='$jail_lb'
    JROOT_RO_MOUNTS='$ro_mounts'
    export JROOT_PORTS JROOT_LOOPBACK JROOT_RO_MOUNTS
    [ -n "\$JROOT_TRACER" ] && { JROOT_PROC_ROOT="\$JROOT_TRACER"; export JROOT_PROC_ROOT; }
    LD_PRELOAD="\$JROOT_SHIM"
    export LD_PRELOAD
fi

[ -n "\$SHELL" ] && [ -x "\$SHELL" ] || SHELL=/bin/sh
export SHELL

# A subsystem request (sftp) arrives here as its bare name, which is not a
# runnable command, so map it back to the server binary.
if [ "\$SSH_ORIGINAL_COMMAND" = "sftp" ] || [ "\$SSH_ORIGINAL_COMMAND" = "internal-sftp" ]; then
    for p in /usr/lib/openssh/sftp-server /usr/lib/ssh/sftp-server /usr/libexec/sftp-server; do
        [ -x "\$p" ] && exec "\$p"
    done
    echo "jroot: no sftp-server found in this jail" >&2
    exit 127
fi

# 'ssh host <cmd>' and scp both arrive as SSH_ORIGINAL_COMMAND.
if [ -n "\$SSH_ORIGINAL_COMMAND" ]; then
    exec "\$SHELL" -c "\$SSH_ORIGINAL_COMMAND"
fi

# Interactive login: match what 'jroot enter' gives you.
exec "\$SHELL" -l
WRAPEOF
    chmod 755 "$dest" 2>/dev/null || true
    return 0
}

# Open a TCP connection and read the peer's first line, which for a healthy sshd
# is its version banner ("SSH-2.0-OpenSSH_8.9p1 ..."). Empty output means the
# peer hung up without saying anything.
ssh_banner_probe() {
    local host="$1" port="$2" line=""
    exec 4<>"/dev/tcp/$host/$port" 2>/dev/null || { printf ''; return 1; }
    IFS= read -r -t 6 line <&4 2>/dev/null || true
    exec 4<&- 2>/dev/null || true
    exec 4>&- 2>/dev/null || true
    printf '%s' "$line"
}

ssh_log() {
    # jroot ssh <name> log - show what sshd has been saying.
    local name="$1" logfile="$JROOT_HOME/pids/$name.sshlog"
    if [ ! -f "$logfile" ]; then
        log "No sshd log for '$name' yet. Start it with: jroot ssh $name start"
        return 1
    fi
    if [ ! -s "$logfile" ]; then
        log "sshd log for '$name' is empty ($logfile)."
        return 0
    fi
    printf '%b%s%b\n' "$H" "$logfile" "$N"
    cat "$logfile"
}

ssh_usage() {
    printf '%bjroot ssh%b - SSH access into a jail\n\n' "$H" "$N"
    printf '    %bjroot ssh <name> start [port]%b        start sshd (auto port if omitted)\n' "$G" "$N"
    printf '    %bjroot ssh <name> stop%b                stop the SSH daemon\n' "$G" "$N"
    printf '    %bjroot ssh <name> status%b              show if SSH is running\n' "$G" "$N"
    printf '    %bjroot ssh <name> passwd [user]%b       set a new password\n' "$G" "$N"
    printf '    %bjroot ssh <name> log%b                 show the sshd log\n' "$G" "$N"
    printf '    %bjroot ssh <name>%b                     same as status\n' "$G" "$N"
    printf '\n%bFLAGS%b\n' "$H" "$N"
    help_row "--port=N | -p N" ""        "External port (default: first free 2200x)"
    help_row "--user=<name>" ""          "Login account (default: jail for unroot, root for root)"
    help_row "--password-stdin" ""        "Read the password from stdin (best for scripts)"
    help_row "--password=<pw>" ""         "Set it inline (warns: lands in shell history)"
    help_row "--random-password" ""       "Generate a strong one and print it once"
    help_row "--key=<file.pub>" ""        "Add a public key to authorized_keys"
    help_row "--no-password" ""           "Key-only login (requires --key)"
    help_row "--permit-root" ""           "Also allow root to log in over SSH"
    printf '\n'
    printf '    sshd binds the port directly on 0.0.0.0, so the jail is reachable from\n'
    printf '    outside with no redirector involved. The port must be above 1024: fake\n'
    printf '    root is not CAP_NET_BIND_SERVICE, so a rootless jail cannot bind 22.\n'
    printf '    The jail stays alive in the background, so SSH works even when no\n'
    printf '    interactive shell is open.\n'
    printf '\n%bPASSWORDS%b\n' "$H" "$N"
    printf '    There is no default and no hardcoded password. With no flags you are\n'
    printf '    prompted (echo off); press Enter at the prompt to have a 24-character\n'
    printf '    random one generated and printed %bonce%b. Nothing is stored on the host,\n' "$H" "$N"
    printf '    written to the history log, or passed through a command line.\n'
    printf '\n'
    printf '    %bExamples:%b\n' "$H" "$N"
    printf '      %bjroot ssh dev start%b                        prompt for a password\n' "$G" "$N"
    printf '      %bjroot ssh dev start 20022 --random-password%b  fixed port, generated password\n' "$G" "$N"
    printf '      %bpass show jail/dev | jroot ssh dev start --password-stdin%b\n' "$G" "$N"
    printf '      %bjroot ssh dev start --key=~/.ssh/id_ed25519.pub --no-password%b\n' "$G" "$N"
    printf '      %bjroot ssh dev passwd%b                       rotate the password\n' "$G" "$N"
}

cmd_ssh() {
    ensure_runtime
    [ -x "$PROOT_BIN" ] || install_proot
    [ $# -ge 1 ] || { ssh_usage; err "Usage: jroot ssh <name> [start|stop|status|passwd] [flags]"; }

    case "$1" in
        -h|--help|help) ssh_usage; return 0 ;;
    esac

    local name="$1"; shift
    [ -f "$CONFIGS_DIR/$name.json" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."
    [ -d "$ROOTS_DIR/$name" ] || err "Rootfs for '$name' is missing."

    local op="status" pw_user=""
    SSH_OPT_PORT=""
    SSH_OPT_USER=""
    SSH_OPT_PW_MODE=""
    SSH_OPT_PW_VALUE=""
    SSH_OPT_KEY=""
    SSH_OPT_PERMIT_ROOT=0
    SSH_OPT_NO_PASSWORD=0

    while [ $# -gt 0 ]; do
        case "$1" in
            start|stop|status|passwd|log|logs) op="$1"; [ "$op" = "logs" ] && op="log" ;;
            --port=*)          SSH_OPT_PORT="${1#*=}" ;;
            -p)                shift; SSH_OPT_PORT="$1" ;;
            --user=*)          SSH_OPT_USER="${1#*=}" ;;
            -u)                shift; SSH_OPT_USER="$1" ;;
            --password=*)
                [ -z "$SSH_OPT_PW_MODE" ] || err "Pick only one of --password / --password-stdin / --random-password."
                SSH_OPT_PW_MODE="arg"; SSH_OPT_PW_VALUE="${1#*=}"
                ;;
            --password)        err "--password needs a value: --password=<pw>. Better still, use --password-stdin so it stays out of your shell history." ;;
            --password-stdin)
                [ -z "$SSH_OPT_PW_MODE" ] || err "Pick only one of --password / --password-stdin / --random-password."
                SSH_OPT_PW_MODE="stdin"
                ;;
            --random-password|--generate-password)
                [ -z "$SSH_OPT_PW_MODE" ] || err "Pick only one of --password / --password-stdin / --random-password."
                SSH_OPT_PW_MODE="random"
                ;;
            --ask-password|--prompt-password)
                [ -z "$SSH_OPT_PW_MODE" ] || err "Pick only one of --password / --password-stdin / --random-password."
                SSH_OPT_PW_MODE="prompt"
                ;;
            --key=*)           SSH_OPT_KEY="${1#*=}" ;;
            --key)             shift; SSH_OPT_KEY="$1" ;;
            --no-password|--keys-only) SSH_OPT_NO_PASSWORD=1 ;;
            --permit-root)     SSH_OPT_PERMIT_ROOT=1 ;;
            -h|--help)         ssh_usage; return 0 ;;
            --*)               err "Unknown flag: $1 (try '${CMD_HINT}help ssh')" ;;
            *)
                if [[ "$1" =~ ^[0-9]+$ ]]; then
                    SSH_OPT_PORT="$1"
                elif [ "$op" = "passwd" ] && [ -z "$pw_user" ]; then
                    pw_user="$1"          # jroot ssh <name> passwd <user>
                else
                    err "Unknown argument: $1"
                fi
                ;;
        esac
        shift
    done

    # Expand a leading ~ in --key by hand: it arrives quoted from --key=~/...
    case "$SSH_OPT_KEY" in
        "~/"*) SSH_OPT_KEY="$REAL_HOME/${SSH_OPT_KEY#\~/}" ;;
    esac

    case "$op" in
        start)  ssh_start "$name" ;;
        stop)   ssh_stop "$name" ;;
        status) ssh_status "$name" ;;
        log)    ssh_log "$name" ;;
        passwd)
            [ "$SSH_OPT_NO_PASSWORD" != "1" ] || err "--no-password makes no sense for 'passwd'."
            ssh_passwd "$name" "${pw_user:-$SSH_OPT_USER}" "$SSH_OPT_PW_MODE" "$SSH_OPT_PW_VALUE"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Snapshots / revert (tar.gz rootfs + config at snapshot time)
# ---------------------------------------------------------------------------
snapshot_list() {
    local name="$1"
    local dir="$SNAPSHOTS_DIR/$name"
    local snaps=() s
    shopt -s nullglob
    snaps=("$dir"/*.tar.gz)
    shopt -u nullglob
    if [ "${#snaps[@]}" -eq 0 ]; then
        log "No snapshots for '$name' yet. Run: jroot snapshot $name"
        return 1
    fi
    printf '%-20s %-14s %s\n' "LABEL" "SIZE" "DATE"
    for s in "${snaps[@]}"; do
        printf '%-20s %-14s %s\n' "$(basename "$s" .tar.gz)" \
            "$(du -sh "$s" 2>/dev/null | awk '{print $1}')" \
            "$(date -r "$s" '+%Y-%m-%d %H:%M' 2>/dev/null || true)"
    done
}

cmd_snapshot() {
    [ $# -ge 1 ] || err "Usage: jroot snapshot <name> [label]"
    local name="$1" label="${2:-}"
    [ -f "$CONFIGS_DIR/$name.json" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."
    [ -d "$ROOTS_DIR/$name" ] || err "Rootfs for '$name' is missing."
    [ -n "$label" ] || label="$(date +%Y%m%d-%H%M%S)"
    [[ "$label" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || err "Invalid snapshot label: '$label'"

    local dir="$SNAPSHOTS_DIR/$name"
    mkdir -p "$dir"
    local tmp
    tmp="$(mktemp "$dir/.snap.XXXXXX")"
    rm -f "$tmp"
    log "Snapshotting '$name' as '$label'..."
    if tar -czf "$tmp.tar.gz" -C "$ROOTS_DIR" "$name" 2>/dev/null; then
        mv "$tmp.tar.gz" "$dir/$label.tar.gz"
        cp "$CONFIGS_DIR/$name.json" "$dir/$label.json"
        log "Snapshot saved: $dir/$label.tar.gz"
        record_event "$name" "snapshot" "$label ($(du -sh "$dir/$label.tar.gz" 2>/dev/null | awk '{print $1}'))"
    else
        rm -f "$tmp.tar.gz"
        err "Snapshot failed."
    fi
}

cmd_snapshots() {
    [ $# -eq 1 ] || err "Usage: jroot snapshots <name>"
    [ -f "$CONFIGS_DIR/$1.json" ] || err "Jail '$1' not found. Run 'jroot list' to see jails."
    snapshot_list "$1"
}

cmd_revert() {
    [ $# -ge 1 ] || err "Usage: jroot revert <name> [label]"
    local name="$1" label="${2:-}"
    [ -f "$CONFIGS_DIR/$name.json" ] || err "Jail '$name' not found. Run 'jroot list' to see jails."
    local dir="$SNAPSHOTS_DIR/$name"

    if [ -z "$label" ]; then
        log "Available snapshots for '$name':"
        snapshot_list "$name" || return 1
        printf 'Which label to restore? [none]: '
        read -r label || label=""
        [ -n "$label" ] || { log "Aborted."; return 0; }
    fi

    [ -f "$dir/$label.tar.gz" ] || err "Snapshot '$label' not found for '$name'. Run 'jroot snapshots $name'."
    [ -f "$dir/$label.json" ] || err "Snapshot config '$dir/$label.json' missing."

    local response
    printf 'Restore jail "%s" to snapshot "%s"? This replaces the current rootfs. [y/N]: ' "$name" "$label"
    read -r response || response="N"
    case "$response" in
        y|Y|yes|YES) ;;
        *) log "Aborted."; return 0 ;;
    esac

    local rootfs="$ROOTS_DIR/$name" tmp
    tmp="$(mktemp -d "$SNAPSHOTS_DIR/.restore.XXXXXX")"
    log "Restoring '$name' from '$label'..."
    if ! tar -xzf "$dir/$label.tar.gz" -C "$tmp" 2>/dev/null; then
        rm -rf "$tmp"
        err "Restore failed: corrupt snapshot archive."
    fi

    rm -rf "$rootfs"
    mv "$tmp/$name" "$rootfs"
    cp "$dir/$label.json" "$CONFIGS_DIR/$name.json"
    rm -rf "$tmp"
    log "Jail '$name' restored to snapshot '$label'."
    record_event "$name" "revert" "restored snapshot '$label'"
}

cmd_rm_snapshot() {
    [ $# -eq 2 ] || err "Usage: jroot rm-snapshot <name> <label>"
    local name="$1" label="$2"
    local dir="$SNAPSHOTS_DIR/$name"
    [ -f "$dir/$label.tar.gz" ] || err "Snapshot '$label' not found for '$name'. Run 'jroot snapshots $name'."
    local response
    printf 'Delete snapshot "%s/%s"? [y/N]: ' "$name" "$label"
    read -r response || response="N"
    case "$response" in
        y|Y|yes|YES) ;;
        *) log "Aborted."; return 0 ;;
    esac
    rm -f "$dir/$label.tar.gz" "$dir/$label.json"
    rmdir "$dir" 2>/dev/null || true
    log "Snapshot '$label' deleted."
    record_event "$name" "rm-snapshot" "$label"
}

help_header() {
    printf '%b%s%b\n\n' "$H" "$1" "$N"
}

help_row() {
    # $1 command-word (green), $2 args (blue), $3 description (aligned)
    local name="$1" args="$2" desc="$3" vis pad
    vis=$(( ${#name} + ${#args} + 1 ))
    pad=$(( 40 - vis ))
    [ "$pad" -lt 2 ] && pad=2
    printf '    %b%s%b %b%s%b%*s%s\n' "$G" "$name" "$N" "$B" "$args" "$N" "$pad" "" "$desc"
}

cmd_help_cmd() {
    local cmd="$1"; shift
    case "$cmd" in
        init)
            printf '%bjroot init%b - create a jail from an Ubuntu or Alpine image\n\n' "$H" "$N"
            printf '    %bjroot init <image> [--name=<n>] [flags]%b\n' "$G" "$N"
            printf '    %bjroot init --list%b\n' "$G" "$N"
            help_row "image" "ubuntu:22.04|20.04|24.04|24.10|alpine:3.20|3.21|3.22|edge" "Linux distribution to use"
            help_row "--list" "" "Show all supported images and versions"
            help_row "--name=<n>" "" "Jail name (default: derived from image)"
            help_row "--user=root|unroot" "" "root=fake root, unroot=non-root jail user"
            help_row "--build-essential=0/1" "" "Install gcc/g++/make (default 1)"
            help_row "--mount-host=0/1" "" "Bind host / to /mnt/host (default 0)"
            help_row "--mount-home=0/1" "" "Bind host \$HOME to /mnt/home (default 0)"
            printf '\n    %bExample:%b jroot init ubuntu:22.04 --name=dev --user=unroot\n' "$G" "$N"
            printf '    %bExample:%b jroot init alpine:3.20 --name=alpine-dev\n' "$G" "$N"
            printf '    %bExample:%b jroot init --list\n' "$G" "$N"
            ;;
        enter)
            printf '%bjroot enter%b - open a shell, or run a command, inside a jail\n\n' "$H" "$N"
            printf '    %bjroot enter <name>%b\n' "$G" "$N"
            printf '    %bjroot enter <name> <cmd...>%b\n' "$G" "$N"
            printf '    %bjroot enter <name> --root <cmd...>%b\n' "$G" "$N"
            printf '\n    Without a command you get an interactive shell. Use --root to act as\n'
            printf '    the admin (root) user.\n'
            ;;
        shell)
            printf '%bjroot shell%b - interactive jroot command shell\n\n' "$H" "$N"
            printf '    %bjroot shell%b\n' "$G" "$N"
            printf '\n    Opens a %bjroot>%b prompt where you run jroot commands without the\n' "$B" "$N"
            printf '    prefix (e.g. %blist%b, %benter dev%b). Type %bexit%b to leave.\n' "$G" "$N" "$G" "$N" "$G" "$N"
            ;;
        clean)
            printf '%bjroot clean%b - free disk space inside a jail\n\n' "$H" "$N"
            printf '    %bjroot clean <name> [more jails...]%b\n' "$G" "$N"
            printf '\n    Removes apt caches, package lists, debconf, and temp files.\n'
            printf '    Also trims /usr/share/doc and /var/log for build-essential jails.\n'
            ;;
        size)
            printf '%bjroot size%b - show disk usage per jail\n\n' "$H" "$N"
            printf '    %bjroot size%b                (all jails)\n' "$G" "$N"
            printf '    %bjroot size <name>%b         (one jail)\n' "$G" "$N"
            printf '\n    Shows rootfs size and total snapshot size per jail.\n'
            ;;
        exec)
            printf '%bjroot exec%b - run a single command inside a jail (no shell)\n\n' "$H" "$N"
            printf '    %bjroot exec <name> [--root] <cmd...>%b\n' "$G" "$N"
            printf '\n    %bExample:%b jroot exec dev --root apt-get update\n' "$G" "$N"
            ;;
        file)
            if [ $# -ge 1 ]; then
                case "$1" in
                    cp) printf '%bjroot file cp%b - copy a file between host and jail\n\n' "$H" "$N"
                        printf '    %bjroot file cp <name> <src> <dst>%b\n' "$G" "$N"
                        printf '\n    One of <src>/<dst> must be a jail path (prefix %b:%b).\n' "$G" "$N"
                        printf '    %bhost -> jail:%b  jroot file cp dev ~/app.tar.gz :/root/app.tar.gz\n' "$G" "$N"
                        printf '    %bjail -> host:%b  jroot file cp dev :/root/log.txt ./log.txt\n' "$G" "$N"
                        ;;
                    mv) printf '%bjroot file mv%b - move a file between host and jail\n\n' "$H" "$N"
                        printf '    %bjroot file mv <name> <src> <dst>%b\n' "$G" "$N"
                        printf '\n    Same rules as %bjroot file cp%b. One path is a jail path (prefix %b:%b).\n' "$G" "$N" "$G" "$N"
                        ;;
                    *)  err "Unknown file subcommand: $1 (try 'jroot help file cp' or 'jroot help file mv')" ;;
                esac
            else
                file_usage
            fi
            ;;
        port)
            port_usage
            ;;
        net)
            net_usage
            ;;
        mnt)
            mnt_usage "<name>"
            ;;
        install)
            printf '%bjroot install%b - install packages inside a jail (apt or apk)\n\n' "$H" "$N"
            printf '    %bjroot install <name> <pkg...>%b\n' "$G" "$N"
            printf '\n    Ubuntu jails use apt-get, Alpine jails use apk, both as root.\n'
            printf '    %bExample:%b jroot install dev git curl\n' "$G" "$N"
            ;;
        config)
            printf '%bjroot config%b - view or change a jail'"'"'s settings\n\n' "$H" "$N"
            printf '    %bjroot config <name>%b\n' "$G" "$N"
            printf '    %bjroot config <name> --show%b\n' "$G" "$N"
            printf '    %bjroot config <name> --mount-host=0/1%b\n' "$G" "$N"
            printf '    %bjroot config <name> --mount-home=0/1%b\n' "$G" "$N"
            printf '    %bjroot config <name> --build-essential=0/1%b\n' "$G" "$N"
            printf '    %bjroot config <name> --user=root|unroot%b\n' "$G" "$N"
            ;;
        list|ls)
            printf '%bjroot list%b - list all jails\n\n' "$H" "$N"
            printf '    %bjroot list%b\n' "$G" "$N"
            printf '    %bjroot list --json%b   (machine-readable output)\n' "$G" "$N"
            ;;
        info)
            printf '%bjroot info%b - show a jail'"'"'s details and disk usage\n\n' "$H" "$N"
            printf '    %bjroot info [name]%b    (no name = all jails)\n' "$G" "$N"
            ;;
        history)
            printf '%bjroot history%b - what has been done to a jail, and when\n\n' "$H" "$N"
            printf '    %bjroot history%b                (all jails, oldest first)\n' "$G" "$N"
            printf '    %bjroot history <name>%b\n' "$G" "$N"
            printf '    %bjroot history <name> --limit=20%b\n' "$G" "$N"
            printf '    %bjroot history <name> --json%b\n' "$G" "$N"
            printf '    %bjroot history <name> --clear%b\n' "$G" "$N"
            printf '\n    Records creation, installs, updates, snapshots, reverts, config\n'
            printf '    changes, renames and cleans. Logs live in %b~/.jroot/history%b.\n' "$G" "$N"
            ;;
        compare|diff)
            printf '%bjroot compare%b - config and package differences between two jails\n\n' "$H" "$N"
            printf '    %bjroot compare <jailA> <jailB>%b\n' "$G" "$N"
            printf '    %bjroot compare <jailA> <jailB> --all%b\n' "$G" "$N"
            printf '\n    Compares image, user mode, mounts, ports and size, then the package\n'
            printf '    lists. By default only explicitly-installed packages are compared\n'
            printf '    (%bapt-mark showmanual%b / %b/etc/apk/world%b); %b--all%b uses every installed\n' "$G" "$N" "$G" "$N" "$G" "$N"
            printf '    package. Useful for "why does it work in one jail but not the other".\n'
            ;;
        which)
            printf '%bjroot which%b - find a program across jails\n\n' "$H" "$N"
            printf '    %bjroot which <program>%b         (search every jail)\n' "$G" "$N"
            printf '    %bjroot which <jail> <program>%b  (search one jail)\n' "$G" "$N"
            printf '    %bjroot which <program> --all%b   (every match, not just the first)\n' "$G" "$N"
            printf '\n    Reads the rootfs directly on the host, so no jail is started.\n'
            printf '    An absolute path is checked as-is inside each jail.\n'
            printf '    %bExample:%b jroot which node\n' "$G" "$N"
            printf '    %bExample:%b jroot which /etc/nginx/nginx.conf\n' "$G" "$N"
            ;;
        snapshot)
            printf '%bjroot snapshot%b - save a full backup of a jail\n\n' "$H" "$N"
            printf '    %bjroot snapshot <name> [label]%b\n' "$G" "$N"
            printf '\n    Saves rootfs + config as a tar.gz. Label defaults to a timestamp.\n'
            ;;
        snapshots)
            printf '%bjroot snapshots%b - list saved snapshots for a jail\n\n' "$H" "$N"
            printf '    %bjroot snapshots <name>%b\n' "$G" "$N"
            ;;
        revert)
            printf '%bjroot revert%b - restore a jail from a snapshot\n\n' "$H" "$N"
            printf '    %bjroot revert <name> [label]%b\n' "$G" "$N"
            printf '\n    Without a label, the latest snapshot is used.\n'
            ;;
        rm-snapshot)
            printf '%bjroot rm-snapshot%b - delete a saved snapshot\n\n' "$H" "$N"
            printf '    %bjroot rm-snapshot <name> <label>%b\n' "$G" "$N"
            ;;
        update)
            printf '%bjroot update%b - update proot + packages in a jail\n\n' "$H" "$N"
            printf '    %bjroot update [name]%b   (no name = all jails)\n' "$G" "$N"
            ;;
        doctor)
            printf '%bjroot doctor%b - check the setup for problems\n\n' "$H" "$N"
            printf '    %bjroot doctor%b\n' "$G" "$N"
            printf '    %bjroot doctor --mute=7d%b   (mute warnings for 7 days)\n' "$G" "$N"
            printf '    %bjroot doctor --mute=forever%b  (mute warnings forever)\n' "$G" "$N"
            printf '    %bjroot doctor --mute=off%b  (unmute warnings)\n' "$G" "$N"
            printf '\n    Mutes gcc/python3 warnings that may not be relevant to your use case.\n'
            ;;
        rm|delete)
            printf '%bjroot rm%b - permanently delete a jail\n\n' "$H" "$N"
            printf '    %bjroot rm <name>%b\n' "$G" "$N"
            printf '\n    Deletes the rootfs, config, and all snapshots for the jail.\n'
            ;;
        rename)
            printf '%bjroot rename%b - rename a jail\n\n' "$H" "$N"
            printf '    %bjroot rename <name> <newname>%b\n' "$G" "$N"
            printf '\n    Moves the rootfs, config, and snapshots to the new name, and\n'
            printf '    updates the jail hostname, /etc/hosts, and shell prompt.\n'
            ;;
        kill|stop)
            printf '%bjroot kill%b - terminate a running jail\n\n' "$H" "$N"
            printf '    %bjroot kill <name>%b\n' "$G" "$N"
            printf '    %bjroot kill <name> --force%b\n' "$G" "$N"
            printf '\n    Kills the jail'"'"'s shell process and all its children.\n'
            printf '    Use %b--force%b for an immediate SIGKILL instead of SIGTERM.\n' "$G" "$N"
            ;;
        ps)
            printf '%bjroot ps%b - list running jails\n\n' "$H" "$N"
            printf '    %bjroot ps%b\n' "$G" "$N"
            printf '\n    Shows the PID and command for each running jail.\n'
            printf '    Stale PID files are automatically cleaned up.\n'
            ;;
        ssh)
            ssh_usage
            ;;
        help)
            printf '%bjroot help%b - show this help\n\n' "$H" "$N"
            printf '    %bjroot help%b            (all commands)\n' "$G" "$N"
            printf '    %bjroot help <command>%b   (one command, e.g. %bjroot help file cp%b)\n' "$G" "$N"
            ;;
        *)  err "Unknown command: $cmd (try '${CMD_HINT}help')" ;;
    esac
}

cmd_help() {
    if [ $# -ge 1 ]; then
        cmd_help_cmd "$@"
        return
    fi
    printf '%bjroot%b %b- rootless Linux jails (no host root required)%b\n\n' "$H" "$N" "$D" "$N"

    printf '%bUSAGE%b\n' "$H" "$N"
    printf '    %b<command>%b %b[arguments...]%b\n\n' "$G" "$N" "$B" "$N"

    printf '%bCREATE & USE%b\n' "$H" "$N"
    help_row "jroot init" "<image> [flags]"        "Create a jail (see FLAGS below)"
    help_row "jroot init" "--list"                 "List available images"
    help_row "jroot enter" "<name>"                "Open a shell inside a jail"
    help_row "jroot shell" ""                      "Interactive jroot command shell (jroot> prompt)"
    help_row "jroot enter" "<name> <cmd...>"       "Run one command inside a jail"
    help_row "jroot enter" "<name> --root <cmd>"   "Run a command as root (admin)"
    help_row "jroot exec" "<name> [--root] <cmd>"  "Run one command inside a jail"
    help_row "jroot file" "cp|mv <name> <src> <dst>" "Copy/move a file in or out of a jail"
    printf '                                      %b (prefix jail paths with %b:%b, e.g. %b:/root/file%b)\n' "$B" "$G" "$N" "$G" "$N"
    help_row "jroot port" "list|add|rm <name>"    "Control which jailed ports may bind publicly"
    help_row "jroot net" "[set <name> auto|off]"  "Per-jail loopback address (no port collisions)"
    help_row "jroot mnt" "<name> <label> <dir>"   "Bind-mount a host directory at /mnt/<label>"
    help_row "jroot ssh" "<name> start|stop|status" "SSH access into a jail (persistent daemon)"
    help_row "jroot install" "<name> <pkg...>"     "Install packages inside a jail (apt/apk)"
    help_row "jroot config" "<name>"               "View or change a jail's settings"
    help_row "jroot list" "[--json]"               "List all jails (JSON with --json)"
    help_row "jroot info" "[name]"                 "Show a jail's details and disk usage"
    help_row "jroot size" "[name]"                 "Show disk usage per jail"
    help_row "jroot history" "[name]"              "Show what was done to a jail, and when"
    help_row "jroot compare" "<jailA> <jailB>"     "Diff two jails (config + packages)"
    help_row "jroot which" "[jail] <program>"      "Find a program across jails"
    printf '\n'

    printf '%bSNAPSHOTS%b\n' "$H" "$N"
    help_row "jroot snapshot" "<name> [label]"      "Save a full backup (rootfs + config)"
    help_row "jroot snapshots" "<name>"             "List saved snapshots"
    help_row "jroot revert" "<name> [label]"        "Restore a jail from a snapshot"
    help_row "jroot rm-snapshot" "<name> <label>"   "Delete a snapshot"
    printf '\n'

    printf '%bMAINTENANCE%b\n' "$H" "$N"
    help_row "jroot update" "[name]"    "Update proot + packages (all jails if no name)"
    help_row "jroot clean" "<name>..."  "Free disk space inside a jail"
    help_row "jroot doctor" "[--mute=7d|forever|off]" "Check setup, or mute warnings"
    help_row "jroot rm" "<name>"        "Permanently delete a jail"
    help_row "jroot rename" "<n> <new>" "Rename a jail (updates hostname/prompt/snapshots)"
    help_row "jroot kill" "<name>"      "Terminate a running jail"
    help_row "jroot ps" ""              "List running jails"
    help_row "jroot ssh" "<name> start|stop|status" "SSH access into a jail (persistent daemon)"
    help_row "jroot help" "[command]"     "Show help (for one command too)"
    printf '\n'

    printf '%bFLAGS for init%b\n' "$H" "$N"
    help_row "--list" ""                  "List available images (ubuntu & alpine versions)"
    help_row "--name=<n>" ""              "Jail name (default: derived from the image)"
    help_row "--user=root|unroot" ""      "root = fake root (default). unroot = daily use"
    printf '                                      %b as the non-root user %bjail%b, root locked;\n' "$B" "$H" "$N"
    printf '                                      %b use %bjroot enter <name> --root%b for admin%b\n' "$B" "$G" "$N" "$N"
    help_row "--build-essential=0/1" ""   "Install gcc/g++/make (default 1)"
    help_row "--mount-host=0/1" ""        "Bind host / to /mnt/host (default 0)"
    help_row "--mount-home=0/1" ""        "Bind host \$HOME to /mnt/home (default 0)"
    printf '\n'

    printf '%bSUPPORTED IMAGES%b\n' "$H" "$N"
    printf '    %bubuntu%b  <version>  Ubuntu versions: 16.04, 18.04, 20.04, 22.04, 24.04, etc.\n' "$G" "$N"
    printf '    %balpine%b  <version>  Alpine versions: 3.18, 3.19, 3.20, 3.21, 3.22, edge\n' "$G" "$N"
    printf '    Run %bjroot init --list%b for the full list.\n' "$G" "$N"
    printf '\n'

    printf '%bSTORAGE (under ~/.jroot)%b\n' "$H" "$N"
    help_row "roots/<name>" ""              "rootfs"
    help_row "configs/<name>.json" ""       "jail config"
    help_row "snapshots/<name>/" ""         "snapshots (tar.gz + config)"
    help_row "history/<name>.log" ""        "what was done to the jail, and when"
    printf '\n'

    printf '%bEXAMPLES%b\n' "$H" "$N"
    printf '    %b$%b %s\n' "$G" "$N" "jroot init ubuntu:22.04 --name=dev --user=unroot"
    printf '    %b$%b %s\n' "$G" "$N" "jroot init alpine:3.20 --name=alpine-dev"
    printf '    %b$%b %s\n' "$G" "$N" "jroot init --list"
    printf '    %b$%b %s\n' "$G" "$N" "jroot enter dev apk add htop  # for Alpine"
    printf '    %b$%b %s\n' "$G" "$N" "jroot enter dev apt-get install htop  # for Ubuntu"
}

jroot_cmd() {
    [ $# -ge 1 ] || { cmd_help; return 0; }
    case "$1" in
        init)          shift; cmd_init "$@" ;;
        enter)         shift; cmd_enter "$@" ;;
        exec)          shift; cmd_exec "$@" ;;
        file)          shift; cmd_file "$@" ;;
        port)          shift; cmd_port "$@" ;;
        net)           shift; cmd_net "$@" ;;
        mnt)           shift; cmd_mnt "$@" ;;
        mount)         shift; cmd_mnt "$@" ;;
        install)       shift; cmd_install "$@" ;;
        config)        shift; cmd_config "$@" ;;
        list|ls)       shift; cmd_list "$@" ;;
        info)          shift; cmd_info "$@" ;;
        history)       shift; cmd_history "$@" ;;
        compare|diff)  shift; cmd_compare "$@" ;;
        which)         shift; cmd_which "$@" ;;
        size)          shift; cmd_size "$@" ;;
        update)        shift; cmd_update "$@" ;;
        clean)         shift; cmd_clean "$@" ;;
        snapshot)      shift; cmd_snapshot "$@" ;;
        snapshots)     shift; cmd_snapshots "$@" ;;
        revert)        shift; cmd_revert "$@" ;;
        rm-snapshot)   shift; cmd_rm_snapshot "$@" ;;
        doctor)        shift; cmd_doctor "$@" ;;
        rm|delete)     shift; cmd_rm "$@" ;;
        rename)        shift; cmd_rename "$@" ;;
        kill|stop)     shift; cmd_kill "$@" ;;
        ps)            shift; cmd_ps "$@" ;;
        ssh)           shift; cmd_ssh "$@" ;;
        help|--help|-h) shift; cmd_help "$@" ;;
        *)             err "Unknown command: $1 (run '${CMD_HINT}help')" ;;
    esac
}

cmd_shell() {
    local line
    CMD_HINT=""
    printf '%bjroot interactive shell%b - run jroot commands without the prefix.\n' "$G" "$N"
    printf '    Type %bhelp%b for commands, %bexit%b to leave.\n\n' "$G" "$N" "$G" "$N"
    while true; do
        read -r -p "jroot> " -a line || { printf 'Bye!\n'; return 0; }
        if [ "${#line[@]}" -eq 0 ]; then
            continue
        fi
        case "${line[0]}" in
            exit|quit|bye|leave|exit\(\)|quit\(\)|:q|q) printf 'Bye!\n'; return 0 ;;
            help|--help|-h) cmd_help "${line[@]:1}" 2>&1 | sed -E 's/jroot ([a-z])/\1/g' ;;
            *)             (jroot_cmd "${line[@]}") || true ;;
        esac
    done
}

main() {
    [ $# -ge 1 ] || { cmd_help; exit 0; }
    case "$1" in
        shell)         shift; cmd_shell "$@" ;;
        *)             jroot_cmd "$@" ;;
    esac
}

main "$@"
