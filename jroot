# ---------------------------------------------------------------------------
# Shell completion
#
# The scripts are printed rather than installed so they can be piped wherever a
# given shell wants them, and regenerated after an upgrade adds a command.
# Everything they need is readable straight off the host - jail names are files
# in configs/, snapshot labels are files in snapshots/<jail>/ - so completing a
# name never starts a jail or shells out to jroot itself.
# ---------------------------------------------------------------------------
completion_usage() {
    printf '%bjroot completion%b - print a shell completion script\n\n' "$H" "$N"
    printf '    %bjroot completion bash%b\n' "$G" "$N"
    printf '    %bjroot completion zsh%b\n' "$G" "$N"
    printf '    %bjroot completion fish%b\n' "$G" "$N"
    printf '\n'
    printf '    Completes commands, jail names, subcommands, snapshot and mount labels,\n'
    printf '    public ports and flags - and paths %binside%b a jail after %b<jail>:%b\n' "$H" "$N" "$G" "$N"
    printf '\n'
    printf '    %bInstall it once:%b\n' "$H" "$N"
    printf '      %bbash%b   jroot completion bash > ~/.local/share/bash-completion/completions/jroot\n' "$G" "$N"
    printf '      %bzsh%b    jroot completion zsh > "${fpath[1]}/_jroot"   %b(then run compinit)%b\n' "$G" "$N" "$D" "$N"
    printf '      %bfish%b   jroot completion fish > ~/.config/fish/completions/jroot.fish\n' "$G" "$N"
    printf '\n'
    printf '    %bJust this shell:%b  eval "$(jroot completion bash)"\n' "$H" "$N"
}

cmd_completion() {
    case "${1:-}" in
        bash)            completion_bash ;;
        zsh)             completion_zsh ;;
        fish)            completion_fish ;;
        ""|-h|--help)    completion_usage ;;
        *)               completion_usage
                         err "Unknown shell '$1'. Use bash, zsh or fish." ;;
    esac
}

completion_bash() {
cat <<'BASH_COMPLETION_EOF'
# jroot completion for bash.   Generated by: jroot completion bash
#
# Arguments are parsed out of COMP_LINE instead of COMP_WORDS on purpose: a jail
# path is written "<jail>:/path", ':' is in COMP_WORDBREAKS, so COMP_WORDS splits
# that one argument into three words and every position test after it is wrong.
# The trade-off is that a quoted argument containing spaces counts as several
# words; jail names, subcommands and flags never contain spaces.

_jroot_home() { printf '%s' "${JROOT_HOME:-$HOME/.jroot}"; }

_jroot_jails() {
    local f n
    for f in "$(_jroot_home)"/configs/*.json; do
        [ -e "$f" ] || continue
        n="${f##*/}"
        printf '%s\n' "${n%.json}"
    done
}

_jroot_snapshots() {
    local f n
    [ -n "$1" ] || return 0
    for f in "$(_jroot_home)"/snapshots/"$1"/*.tar.gz; do
        [ -e "$f" ] || continue
        n="${f##*/}"
        printf '%s\n' "${n%.tar.gz}"
    done
}

_jroot_checkpoints() {
    local f n
    [ -n "$1" ] || return 0
    for f in "$(_jroot_home)"/snapshots/"$1"/checkpoints/*; do
        [ -d "$f" ] || continue
        n="${f##*/}"
        printf '%s\n' "$n"
    done
}

_jroot_plugins() {
    local f n
    for f in "$(_jroot_home)"/plugins/*; do
        [ -e "$f" ] || continue
        n="${f##*/}"
        case "$n" in
            data|logs|status|registry) continue ;;
            *.py|*.sh) n="${n%.*}" ;;
        esac
        printf '%s\n' "$n"
    done
}

# Public ports and mount labels out of the jail config. python3 writes it with
# indent=2, so the file is flattened first rather than read a line at a time -
# and a TAB press has no business forking a python interpreter.
_jroot_cfg_list() {
    local cfg flat rest
    cfg="$(_jroot_home)/configs/$1.json"
    [ -f "$cfg" ] || return 0
    flat="$(tr -d ' \n\t' < "$cfg" 2>/dev/null)" || return 0
    if [ "$2" = "ports" ]; then
        rest="${flat#*\"ports\":[}"
        [ "$rest" != "$flat" ] || return 0
        printf '%s\n' "${rest%%]*}" | tr ',' '\n'
    else
        rest="${flat#*\"mounts\":[}"
        [ "$rest" != "$flat" ] || return 0
        printf '%s\n' "${rest%%]]*}" | grep -o '\["[^"]*"' | sed 's/\["//; s/"$//'
    fi
}

# Complete a path inside a jail's rootfs, read straight off the host.
#   $1 jail   $2 partial absolute path   $3 prefix to keep on every match
_jroot_jail_path() {
    local jail="$1" p="$2" prefix="$3" root dir base e rel had_nullglob=0
    root="$(_jroot_home)/roots/$jail"
    [ -d "$root" ] || return 0
    dir="${p%/*}/"
    base="${p##*/}"
    shopt -q nullglob && had_nullglob=1
    shopt -s nullglob
    COMPREPLY=()
    for e in "$root$dir$base"*; do
        rel="${e#"$root"}"
        if [ -d "$e" ]; then rel="$rel/"; fi
        COMPREPLY+=("$prefix$rel")
    done
    [ "$had_nullglob" = 1 ] || shopt -u nullglob
    # A directory match must not get a space, or the next TAB has nothing to
    # continue from.
    if [ "${#COMPREPLY[@]}" -eq 1 ] && [[ "${COMPREPLY[0]}" == */ ]]; then
        compopt -o nospace 2>/dev/null
    fi
}

# One side of 'jroot file cp|mv': "<jail>:/path", a host path, or ':/path' when
# the legacy form named the jail up front ($2).
_jroot_file_arg() {
    local cur="$1" ctx="$2" jail j list="" njail=0
    local -a fm
    case "$cur" in
        :*)
            [ -n "$ctx" ] || return 0
            _jroot_jail_path "$ctx" "${cur#:}" ":"
            return 0
            ;;
        *:*)
            jail="${cur%%:*}"
            if [ -d "$(_jroot_home)/roots/$jail" ]; then
                _jroot_jail_path "$jail" "${cur#*:}" "$jail:"
                return 0
            fi
            ;;
    esac
    while read -r j; do
        [ -n "$j" ] && list="$list $j:"
    done < <(_jroot_jails)
    COMPREPLY=()
    if [ -n "$list" ]; then
        COMPREPLY=($(compgen -W "$list" -- "$cur"))
        njail="${#COMPREPLY[@]}"
    fi
    fm=($(compgen -f -- "$cur"))
    if [ "${#fm[@]}" -gt 0 ]; then
        COMPREPLY+=("${fm[@]}")
        compopt -o filenames 2>/dev/null
    elif [ "$njail" -ge 1 ]; then
        compopt -o nospace 2>/dev/null
    fi
}

# COMPREPLY is built against our idea of the current word, which may contain ':'
# or '=' - both in COMP_WORDBREAKS, so bash replaces only the text after the last
# break character. Trim off the part bash is keeping.
_jroot_trim() {
    local ours="$1" tail="${COMP_WORDS[COMP_CWORD]}" pre i
    [ "$ours" = "$tail" ] && return 0
    case "$ours" in *"$tail") ;; *) return 0 ;; esac
    pre="${ours%"$tail"}"
    [ -n "$pre" ] || return 0
    for ((i = 0; i < ${#COMPREPLY[@]}; i++)); do
        COMPREPLY[i]="${COMPREPLY[i]#"$pre"}"
    done
}

_jroot() {
    local line cur cmd idx jails ctx
    local -a w
    line="${COMP_LINE:0:COMP_POINT}"
    read -r -a w <<<"$line"
    if [ "${#w[@]}" -eq 0 ] || [[ "$line" =~ [[:space:]]$ ]]; then
        cur=""
        idx="${#w[@]}"
    else
        idx=$(( ${#w[@]} - 1 ))
        cur="${w[$idx]}"
    fi
    COMPREPLY=()

    local cmds="init build enter exec shell install config file sync limit bundle deploy monitor compose
        port net mnt mount ssh list ls info size history logs compare diff which doctor snapshot
        snapshots checkpoint checkpoints revert rm-snapshot rm-checkpoint update clean rename kill
        stop ps rm delete completion completions help plugin"

    if [ "$idx" -le 1 ]; then
        COMPREPLY=($(compgen -W "$cmds" -- "$cur"))
        _jroot_trim "$cur"
        return 0
    fi

    cmd="${w[1]}"
    jails="$(_jroot_jails)"

    case "$cmd" in
        build)
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -W "--file= --tag= --build-arg= --no-cache" -- "$cur"))
                COMPREPLY+=( $(compgen -d -- "$cur") )
                compopt -o filenames 2>/dev/null
            else
                COMPREPLY=($(compgen -W "-f --file= -t --tag= --build-arg= --no-cache" -- "$cur"))
            fi
            ;;
        init)
            # 'jroot init --list' is the authoritative list; these are the ones
            # worth offering without shelling out.
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -W "--list ubuntu:16.04 ubuntu:18.04 ubuntu:20.04
ubuntu:22.04 ubuntu:24.04 ubuntu:24.10 alpine:3.19 alpine:3.20 alpine:3.21
alpine:3.22 alpine:edge" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "--name= --user=root --user=unroot
--build-essential=0 --build-essential=1 --mount-host=0 --mount-host=1
--mount-home=0 --mount-home=1" -- "$cur"))
            fi
            ;;
        enter|exec)
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -W "$jails" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "--root" -- "$cur"))
            fi
            ;;
        install|info|size|snapshots|checkpoints|update|snapshot|rename|rm|delete)
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -W "$jails" -- "$cur"))
            fi
            ;;
        clean)
            COMPREPLY=($(compgen -W "$jails" -- "$cur"))
            ;;
        config)
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -W "$jails" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "--show --user=root --user=unroot
--build-essential=0 --build-essential=1 --mount-host=0 --mount-host=1
--mount-home=0 --mount-home=1" -- "$cur"))
            fi
            ;;
        file)
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -W "cp mv" -- "$cur"))
            else
                ctx=""
                if [ -n "${w[3]:-}" ] && [ -f "$(_jroot_home)/configs/${w[3]}.json" ]; then
                    ctx="${w[3]}"
                fi
                _jroot_file_arg "$cur" "$ctx"
            fi
            ;;
        sync)
            if [ "$idx" -ge 2 ]; then
                local -a sync_flags
                sync_flags=($(compgen -W "--watch --delete --dry-run" -- "$cur"))
                _jroot_file_arg "$cur" ""
                COMPREPLY+=("${sync_flags[@]}")
            fi
            ;;
        limit)
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -W "$jails" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "--mem= --cpu= --nofile=" -- "$cur"))
            fi
            ;;
        bundle)
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -W "$jails" -- "$cur"))
            elif [ "$idx" -eq 3 ]; then
                COMPREPLY=($(compgen -f -- "$cur"))
                compopt -o filenames 2>/dev/null
            fi
            ;;
        deploy)
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -f -- "$cur"))
                compopt -o filenames 2>/dev/null
            fi
            ;;
        monitor)
            # monitor takes no arguments; completing only the command prevents
            # suggesting options the live monitor does not accept.
            ;;
        compose)
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -W "up down status" -- "$cur"))
            elif [ "$idx" -eq 3 ]; then
                COMPREPLY=($(compgen -f -- "$cur"))
                compopt -o filenames 2>/dev/null
            fi
            ;;
        plugin)
            case "$idx" in
                2) COMPREPLY=($(compgen -W "list ls install add verify inspect remove rm uninstall logs service init-sdk sdk help --help -h" -- "$cur")) ;;
                3) case "${w[2]:-}" in
                       install|add) COMPREPLY=($(compgen -f -d -- "$cur")); compopt -o filenames 2>/dev/null ;;
                       verify) COMPREPLY=($(compgen -W "$(_jroot_plugins) all" -- "$cur")) ;;
                       inspect|remove|rm|uninstall|logs) COMPREPLY=($(compgen -W "$(_jroot_plugins)" -- "$cur")) ;;
                       service) COMPREPLY=($(compgen -W "start stop status" -- "$cur")) ;;
                   esac ;;
                4) case "${w[2]:-}" in
                       logs) COMPREPLY=($(compgen -W "--follow" -- "$cur")) ;;
                       service) COMPREPLY=($(compgen -W "$(_jroot_plugins)" -- "$cur")) ;;
                   esac ;;
            esac
            ;;
        port)
            case "$idx" in
                2) COMPREPLY=($(compgen -W "$jails" -- "$cur")) ;;
                3) COMPREPLY=($(compgen -W "list add rm" -- "$cur")) ;;
                4) if [ "${w[3]:-}" = "rm" ]; then
                       COMPREPLY=($(compgen -W "$(_jroot_cfg_list "${w[2]}" ports)" -- "$cur"))
                   fi ;;
            esac
            ;;
        net)
            case "$idx" in
                2) COMPREPLY=($(compgen -W "set list $jails" -- "$cur")) ;;
                3) [ "${w[2]:-}" = "set" ] && COMPREPLY=($(compgen -W "$jails" -- "$cur")) ;;
                4) [ "${w[2]:-}" = "set" ] && COMPREPLY=($(compgen -W "auto off" -- "$cur")) ;;
            esac
            ;;
        mnt|mount)
            case "$idx" in
                2) COMPREPLY=($(compgen -W "$jails" -- "$cur")) ;;
                3) COMPREPLY=($(compgen -W "list set rm $(_jroot_cfg_list "${w[2]}" labels)" -- "$cur")) ;;
                4) case "${w[3]:-}" in
                       set|rm) COMPREPLY=($(compgen -W "$(_jroot_cfg_list "${w[2]}" labels)" -- "$cur")) ;;
                       list)   ;;
                       *)      COMPREPLY=($(compgen -d -- "$cur"))
                               compopt -o filenames 2>/dev/null ;;
                   esac ;;
                5) COMPREPLY=($(compgen -W "rw ro" -- "$cur")) ;;
            esac
            ;;
        ssh)
            case "$idx" in
                2) COMPREPLY=($(compgen -W "$jails" -- "$cur")) ;;
                3) COMPREPLY=($(compgen -W "start stop status passwd log" -- "$cur")) ;;
                *) if [ "${w[3]:-}" = "start" ]; then
                       COMPREPLY=($(compgen -W "--port= --user= --key= --password=
--password-stdin --random-password --ask-password --no-password --permit-root" -- "$cur"))
                   fi ;;
            esac
            ;;
        revert)
            case "$idx" in
                2) COMPREPLY=($(compgen -W "snapshot checkpoint" -- "$cur")) ;;
                3) COMPREPLY=($(compgen -W "$jails" -- "$cur")) ;;
                4) if [ "${w[2]:-}" = "snapshot" ]; then
                       COMPREPLY=($(compgen -W "$(_jroot_snapshots "${w[3]}")" -- "$cur"))
                   else
                       COMPREPLY=($(compgen -W "$(_jroot_checkpoints "${w[3]}")" -- "$cur"))
                   fi ;;
            esac
            ;;
        rm-snapshot)
            case "$idx" in
                2) COMPREPLY=($(compgen -W "$jails" -- "$cur")) ;;
                3) COMPREPLY=($(compgen -W "$(_jroot_snapshots "${w[2]}")" -- "$cur")) ;;
            esac
            ;;
        rm-checkpoint)
            case "$idx" in
                2) COMPREPLY=($(compgen -W "$jails" -- "$cur")) ;;
                3) COMPREPLY=($(compgen -W "$(_jroot_checkpoints "${w[2]}")" -- "$cur")) ;;
            esac
            ;;
        checkpoint)
            case "$idx" in
                2) COMPREPLY=($(compgen -W "diff $jails" -- "$cur")) ;;
                3) [ "${w[2]:-}" = "diff" ] && COMPREPLY=($(compgen -W "$jails" -- "$cur")) ;;
                4) [ "${w[2]:-}" = "diff" ] && COMPREPLY=($(compgen -W "$(_jroot_checkpoints "${w[3]}")" -- "$cur")) ;;
                5) [ "${w[2]:-}" = "diff" ] && COMPREPLY=($(compgen -W "$(_jroot_checkpoints "${w[3]}")" -- "$cur")) ;;
            esac
            ;;
        checkpoints)
            [ "$idx" -eq 2 ] && COMPREPLY=($(compgen -W "$jails" -- "$cur"))
            ;;
        list|ls)
            COMPREPLY=($(compgen -W "--json" -- "$cur"))
            ;;
        history|logs)
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -W "$jails --json --limit= --clear" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "--json --limit= --clear" -- "$cur"))
            fi
            ;;
        compare|diff)
            if [ "$idx" -le 3 ]; then
                COMPREPLY=($(compgen -W "$jails" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "--all" -- "$cur"))
            fi
            ;;
        which)
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -W "$jails" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "--all" -- "$cur"))
            fi
            ;;
        kill|stop)
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -W "$jails" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "--force" -- "$cur"))
            fi
            ;;
        doctor)
            COMPREPLY=($(compgen -W "--fix --mute=7d --mute=forever --mute=off" -- "$cur"))
            ;;
        completion|completions)
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -W "bash zsh fish" -- "$cur"))
            fi
            ;;
        help)
            if [ "$idx" -eq 2 ]; then
                COMPREPLY=($(compgen -W "$cmds" -- "$cur"))
            elif [ "${w[2]:-}" = "file" ]; then
                COMPREPLY=($(compgen -W "cp mv" -- "$cur"))
            fi
            ;;
    esac

    _jroot_trim "$cur"
    return 0
}

complete -F _jroot jroot
BASH_COMPLETION_EOF
}

completion_zsh() {
cat <<'ZSH_COMPLETION_EOF'
#compdef jroot
# jroot completion for zsh.   Generated by: jroot completion zsh
#
# Install:  jroot completion zsh > "${fpath[1]}/_jroot"   (then run compinit)
#
# Positions are numbered the way the bash script numbers them - 2 is the first
# argument after the command - so the two stay easy to compare. zsh words are
# 1-based with words[1]="jroot", hence words[pos+1].

_jroot_home() { print -r -- "${JROOT_HOME:-$HOME/.jroot}" }

_jroot_jails() {
    local -a names
    local f
    for f in $(_jroot_home)/configs/*.json(N); do
        names+=("${f:t:r}")
    done
    (( ${#names} )) || return 1
    _describe -t jails 'jail' names
}

_jroot_snaps() {
    local -a labels
    local f
    [[ -n "$1" ]] || return 1
    for f in $(_jroot_home)/snapshots/$1/*.tar.gz(N); do
        labels+=("${${f:t}%.tar.gz}")
    done
    (( ${#labels} )) || return 1
    _describe -t snapshots 'snapshot' labels
}

_jroot_checkpoints() {
    local -a labels
    local f
    [[ -n "$1" ]] || return 1
    for f in $(_jroot_home)/snapshots/$1/checkpoints/*(N/); do
        labels+=("${f:t}")
    done
    (( ${#labels} )) || return 1
    _describe -t checkpoints 'checkpoint' labels
}

_jroot_plugins() {
    local -a names
    local f n
    for f in $(_jroot_home)/plugins/*(N); do
        n="${f:t}"
        case "$n" in
            data|logs|status|registry) continue ;;
            *.py|*.sh) n="${n%.*}" ;;
        esac
        names+=("$n")
    done
    (( ${#names} )) || return 1
    _describe -t plugins 'plugin' names
}

# Public ports and mount labels out of the jail config, which is written with
# indent=2 - so it gets flattened first rather than read a line at a time.
_jroot_cfg_list() {
    local cfg="$(_jroot_home)/configs/$1.json"
    [[ -f "$cfg" ]] || return 1
    local -a items
    if [[ "$2" == ports ]]; then
        items=(${(f)"$(tr -d ' \n\t' < $cfg | sed -n 's/.*"ports":\[\([^]]*\)\].*/\1/p' | tr ',' '\n')"})
    else
        items=(${(f)"$(tr -d ' \n\t' < $cfg | sed -n 's/.*"mounts":\[\(.*\)\]\].*/\1/p' | grep -o '\["[^"]*"' | sed 's/\["//; s/"$//')"})
    fi
    (( ${#items} )) || return 1
    compadd -- $items
}

# One side of 'jroot file cp|mv'. compset -P strips the "<jail>:" prefix so
# _files completes inside the rootfs and the insertion lands after the colon,
# the same trick scp's completion uses for host:path.
_jroot_file_arg() {
    local cur="${words[CURRENT]}" jail root
    if [[ "$cur" == :* ]]; then
        jail="${words[4]}"
        root="$(_jroot_home)/roots/$jail"
        if [[ -n "$jail" && -d "$root" ]]; then
            compset -P ':'
            _files -W "$root"
            return
        fi
    fi
    if [[ "$cur" == *:* ]]; then
        jail="${cur%%:*}"
        root="$(_jroot_home)/roots/$jail"
        if [[ -d "$root" ]]; then
            compset -P '*:'
            _files -W "$root"
            return
        fi
    fi
    local -a names
    local f
    for f in $(_jroot_home)/configs/*.json(N); do
        names+=("${f:t:r}:")
    done
    (( ${#names} )) && compadd -S '' -- $names
    _files
}

_jroot() {
    local -a cmds
    cmds=(
        'init:create a jail from an Ubuntu or Alpine image'
        'build:build a jail from a JRootfile'
        'enter:open a shell, or run a command, inside a jail'
        'exec:run one command inside a jail'
        'shell:interactive jroot prompt'
        'install:install packages inside a jail'
        'config:view or change jail settings'
        'file:copy or move files between host and jails'
        'sync:synchronize host and jail directory trees'
        'limit:set per-launch resource limits for a jail'
        'bundle:package a jail into a portable archive'
        'deploy:register a jail from a portable archive'
        'monitor:show live telemetry for all jails'
        'compose:operate a multi-jail stack'
        'port:control which jailed ports may bind publicly'
        'net:per-jail loopback address'
        'mnt:bind-mount a host directory into a jail'
        'mount:alias for mnt'
        'ssh:SSH access into a jail'
        'list:list all jails'
        'ls:alias for list'
        'info:show jail details'
        'size:show disk usage per jail'
        'history:what was done to a jail, and when'
        'logs:alias for jail event history'
        'compare:diff two jails'
        'diff:alias for compare'
        'which:find a program across jails'
        'doctor:check the installation'
        'snapshot:save a snapshot'
        'snapshots:list snapshots'
        'checkpoint:save or compare incremental checkpoints'
        'checkpoints:list checkpoints'
        'revert:restore a snapshot or checkpoint'
        'rm-snapshot:delete a snapshot'
        'rm-checkpoint:delete a checkpoint'
        'update:update runtime and jail packages'
        'clean:free disk space inside a jail'
        'rename:rename a jail'
        'kill:terminate a running jail'
        'stop:alias for kill'
        'ps:list running jails'
        'rm:delete a jail'
        'delete:alias for rm'
        'completion:print a shell completion script'
        'completions:alias for completion'
        'plugin:manage installed plugins'
        'help:show help'
    )

    if (( CURRENT == 2 )); then
        _describe -t commands 'jroot command' cmds
        return
    fi

    local cmd="${words[2]}"
    local pos=$(( CURRENT - 1 ))

    case "$cmd" in
        build)
            if (( pos == 2 )); then
                compadd -S '' -- --file= --tag= --build-arg= --no-cache
                _files -/
            else
                compadd -S '' -- -f --file= -t --tag= --build-arg= --no-cache
            fi
            ;;
        init)
            local -a images
            if (( pos == 2 )); then
                images=(--list ubuntu:16.04 ubuntu:18.04 ubuntu:20.04 ubuntu:22.04
                        ubuntu:24.04 ubuntu:24.10 alpine:3.19 alpine:3.20
                        alpine:3.21 alpine:3.22 alpine:edge)
                compadd -- $images
            else
                compadd -S '' -- --name= --user= --build-essential= --mount-host= --mount-home=
            fi
            ;;
        enter|exec)
            if (( pos == 2 )); then _jroot_jails; else compadd -- --root; fi
            ;;
        install|info|size|snapshots|update|snapshot|rename|rm|delete)
            (( pos == 2 )) && _jroot_jails
            ;;
        clean)
            _jroot_jails
            ;;
        config)
            if (( pos == 2 )); then
                _jroot_jails
            else
                compadd -- --show
                compadd -S '' -- --user= --build-essential= --mount-host= --mount-home=
            fi
            ;;
        file)
            if (( pos == 2 )); then compadd -- cp mv; else _jroot_file_arg; fi
            ;;
        sync)
            (( pos >= 2 )) && compadd -- --watch --delete --dry-run
            (( pos >= 2 )) && _jroot_file_arg
            ;;
        limit)
            if (( pos == 2 )); then _jroot_jails; else compadd -S '' -- --mem= --cpu= --nofile=; fi
            ;;
        bundle)
            if (( pos == 2 )); then _jroot_jails; elif (( pos == 3 )); then _files; fi
            ;;
        deploy)
            (( pos == 2 )) && _files
            ;;
        compose)
            if (( pos == 2 )); then compadd -- up down status; elif (( pos == 3 )); then _files; fi
            ;;
        plugin)
            case $pos in
                2) compadd -- list ls install add verify inspect remove rm uninstall logs service init-sdk sdk help --help -h ;;
                3) case "${words[3]}" in
                       install|add) _files ;;
                       verify) _jroot_plugins; compadd -- all ;;
                       inspect|remove|rm|uninstall|logs) _jroot_plugins ;;
                       service) compadd -- start stop status ;;
                   esac ;;
                4) case "${words[3]}" in
                       logs) compadd -- --follow ;;
                       service) _jroot_plugins ;;
                   esac ;;
            esac
            ;;
        port)
            case $pos in
                2) _jroot_jails ;;
                3) compadd -- list add rm ;;
                4) [[ "${words[4]}" == rm ]] && _jroot_cfg_list "${words[3]}" ports ;;
            esac
            ;;
        net)
            case $pos in
                2) compadd -- set list; _jroot_jails ;;
                3) [[ "${words[3]}" == set ]] && _jroot_jails ;;
                4) [[ "${words[3]}" == set ]] && compadd -- auto off ;;
            esac
            ;;
        mnt|mount)
            case $pos in
                2) _jroot_jails ;;
                3) compadd -- list set rm
                   _jroot_cfg_list "${words[3]}" labels ;;
                4) case "${words[4]}" in
                       set|rm) _jroot_cfg_list "${words[3]}" labels ;;
                       list)   ;;
                       *)      _files -/ ;;
                   esac ;;
                5) compadd -- rw ro ;;
            esac
            ;;
        ssh)
            case $pos in
                2) _jroot_jails ;;
                3) compadd -- start stop status passwd log ;;
                *) if [[ "${words[4]}" == start ]]; then
                       compadd -- --password-stdin --random-password --ask-password \
                                  --no-password --permit-root
                       compadd -S '' -- --port= --user= --key= --password=
                   fi ;;
            esac
            ;;
        revert)
            case $pos in
                2) compadd -- snapshot checkpoint ;;
                3) _jroot_jails ;;
                4) if [[ "${words[3]}" == snapshot ]]; then
                       _jroot_snaps "${words[4]}"
                   else
                       _jroot_checkpoints "${words[4]}"
                   fi ;;
            esac
            ;;
        rm-snapshot)
            case $pos in
                2) _jroot_jails ;;
                3) _jroot_snaps "${words[3]}" ;;
            esac
            ;;
        rm-checkpoint)
            case $pos in
                2) _jroot_jails ;;
                3) _jroot_checkpoints "${words[3]}" ;;
            esac
            ;;
        checkpoint)
            case $pos in
                2) compadd -- diff; _jroot_jails ;;
                3) [[ "${words[3]}" == diff ]] && _jroot_jails ;;
                4|5) [[ "${words[3]}" == diff ]] && _jroot_checkpoints "${words[4]}" ;;
            esac
            ;;
        checkpoints)
            (( pos == 2 )) && _jroot_jails
            ;;
        list|ls)      compadd -- --json ;;
        history|logs)
            (( pos == 2 )) && _jroot_jails
            compadd -- --json --clear
            compadd -S '' -- --limit=
            ;;
        compare|diff)
            if (( pos <= 3 )); then _jroot_jails; else compadd -- --all; fi
            ;;
        which)
            (( pos == 2 )) && _jroot_jails
            compadd -- --all
            ;;
        kill|stop)
            if (( pos == 2 )); then _jroot_jails; else compadd -- --force; fi
            ;;
        doctor)       compadd -- --fix --mute=7d --mute=forever --mute=off ;;
        completion|completions) (( pos == 2 )) && compadd -- bash zsh fish ;;
        help)
            if (( pos == 2 )); then
                _describe -t commands 'jroot command' cmds
            elif [[ "${words[3]}" == file ]]; then
                compadd -- cp mv
            fi
            ;;
    esac
}

_jroot "$@"
ZSH_COMPLETION_EOF
}

completion_fish() {
cat <<'FISH_COMPLETION_EOF'
# jroot completion for fish.   Generated by: jroot completion fish
#
# Install:  jroot completion fish > ~/.config/fish/completions/jroot.fish
#
# Positions are numbered the way the bash script numbers them - 2 is the first
# argument after the command. 'commandline -poc' drops the word being typed, so
# the count of tokens is exactly that position.

function __jroot_home
    if set -q JROOT_HOME
        echo $JROOT_HOME
    else
        echo $HOME/.jroot
    end
end

# 'ls' rather than a glob: an unmatched glob is an error in fish, and "no jails
# yet" is a completely normal state.
function __jroot_jails
    set -l dir (__jroot_home)/configs
    test -d $dir; or return
    for f in (command ls $dir 2>/dev/null)
        string match -q '*.json' -- $f; and string replace -r '\.json$' '' -- $f
    end
end

function __jroot_snapshots -a jail
    test -n "$jail"; or return
    set -l dir (__jroot_home)/snapshots/$jail
    test -d $dir; or return
    for f in (command ls $dir 2>/dev/null)
        string match -q '*.tar.gz' -- $f; and string replace -r '\.tar\.gz$' '' -- $f
    end
end

function __jroot_checkpoints -a jail
    test -n "$jail"; or return
    set -l dir (__jroot_home)/snapshots/$jail/checkpoints
    test -d $dir; or return
    for f in (command ls $dir 2>/dev/null)
        test -d $dir/$f; and echo $f
    end
end

function __jroot_plugins
    set -l dir (__jroot_home)/plugins
    test -d $dir; or return
    for f in (command ls $dir 2>/dev/null)
        switch $f
            case data logs status registry
                continue
            case '*.py' '*.sh'
                string replace -r '\.(py|sh)$' '' -- $f
            case '*'
                echo $f
        end
    end
end

function __jroot_cfg_list -a jail kind
    test -n "$jail"; or return
    set -l cfg (__jroot_home)/configs/$jail.json
    test -f $cfg; or return
    # Flattened first: the config is written with indent=2, so nothing useful
    # sits on a single line.
    if test "$kind" = ports
        tr -d ' \n\t' < $cfg | sed -n 's/.*"ports":\[\([^]]*\)\].*/\1/p' | tr ',' '\n'
    else
        tr -d ' \n\t' < $cfg | sed -n 's/.*"mounts":\[\(.*\)\]\].*/\1/p' | grep -o '\["[^"]*"' | sed 's/\["//; s/"$//'
    end
end

function __jroot_pos
    set -l tokens (commandline -poc)
    count $tokens
end

function __jroot_cmd
    set -l tokens (commandline -poc)
    test (count $tokens) -ge 2; or return
    echo $tokens[2]
end

# The argument at <pos>, numbered like the bash script (2 = first after cmd).
function __jroot_arg -a n
    set -l tokens (commandline -poc)
    set -l i (math $n + 1)
    test (count $tokens) -ge $i; or return
    echo $tokens[$i]
end

function __jroot_at -a want
    test (__jroot_pos) -eq $want
end

function __jroot_from -a want
    test (__jroot_pos) -ge $want
end

function __jroot_is
    set -l c (__jroot_cmd)
    test -n "$c"; or return 1
    contains -- $c $argv
end

function __jroot_arg_is
    set -l v (__jroot_arg $argv[1])
    test -n "$v"; or return 1
    contains -- $v $argv[2..-1]
end

function __jroot_jail_paths -a jail rest prefix
    set -l root (__jroot_home)/roots/$jail
    test -d $root; or return
    set -l dir (string replace -r '[^/]*$' '' -- $rest)
    set -l base (string replace -r '^.*/' '' -- $rest)
    test -d "$root$dir"; or return
    for e in (command find "$root$dir" -maxdepth 1 -mindepth 1 -name "$base*" 2>/dev/null | sort)
        set -l rel (string replace -- "$root" '' $e)
        if test -d $e
            printf '%s%s/\n' $prefix $rel
        else
            printf '%s%s\n' $prefix $rel
        end
    end
end

function __jroot_file_arg
    set -l tok (commandline -ct)
    if string match -q ':*' -- $tok
        # Older form: 'jroot file cp <jail> <src> <dst>', where ':' is that jail.
        set -l jail (__jroot_arg 3)
        test -n "$jail"; or return
        __jroot_jail_paths $jail (string sub -s 2 -- $tok) ':'
        return
    end
    if string match -q '*:*' -- $tok
        set -l parts (string split -m1 ':' -- $tok)
        if test -d (__jroot_home)/roots/$parts[1]
            __jroot_jail_paths $parts[1] $parts[2] "$parts[1]:"
            return
        end
    end
    for j in (__jroot_jails)
        printf '%s:\tjail\n' $j
    end
end

