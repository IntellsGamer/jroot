/* audit_open() is libaudit's handle onto the kernel audit netlink socket.
 * Ubuntu builds OpenSSH with --with-audit=linux, and after a SUCCESSFUL
 * password check sshd records the login:
 *     linux_audit_write_entry failed: Unknown error -1
 *     Connection to <host> closed.
 * The session dies at the last moment, which looks like an auth failure but is
 * not - the log shows "Accepted password" immediately before it.
 *
 * Writing audit records needs CAP_AUDIT_WRITE, which a rootless jail does not
 * have, and OpenSSH treats the failure as fatal to avoid an unaudited login.
 * It does, however, have an explicit "this kernel has no audit support" path:
 * audit_open() failing with EINVAL, EPROTONOSUPPORT or EAFNOSUPPORT is accepted
 * and the login continues. Reporting EPROTONOSUPPORT is therefore both honest -
 * this jail genuinely has no usable audit subsystem - and exactly what OpenSSH
 * is already written to cope with.
 *
 * Only ever done under JROOT_FAKE_PRIVSEP, i.e. for the sshd `jroot ssh`
 * starts; every other process keeps the real libaudit. */
typedef int (*audit_open_fn)(void);

int audit_open(void) {
    static audit_open_fn real = NULL;
    if (!real) real = (audit_open_fn)dlsym(RTLD_NEXT, "audit_open");
    if (fake_privsep() || !real) {
        errno = EPROTONOSUPPORT;
        return -1;
    }
    return real();
}

