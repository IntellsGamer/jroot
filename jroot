#!/usr/bin/env bash
# =============================================================================
# jroot - Rootless Linux jails via proot (no root on the host required)
#
# Migrated from fakeroot3.sh. Commands:
#   jroot init <image> [flags]  Create a jail (--name/--user/--build-essential/
#                               --mount-host/--mount-home skip those prompts)
#   jroot enter <name> [cmd...] Enter a jail / run a command (name required)
#   jroot exec <name> [--root] <cmd...>  Run one command, no interactive shell
#   jroot shell                 Interactive "jroot>" prompt (no command prefix)
#   jroot install <name> <pkg...>  apt-get/apk install as root inside a jail
#   jroot file cp|mv <src> <dst>  Move files around ("<jail>:/path" is inside
#                               that jail, anything else is a host path, and
#                               both sides may be jails)
#   jroot port list|add|rm <name> [port]  Ports allowed to bind publicly
#   jroot net [set <name> auto|off|addr]  Per-jail loopback address
#   jroot mnt <name> [label dir [rw|ro]]  Bind a host dir at /mnt/<label>
#   jroot ssh <name> start|stop|status [port]  SSH into a jail (persistent daemon)
#   jroot config <name>         Show / change a jail's settings
#   jroot list [--json]         List all jails (machine-readable with --json)
#   jroot info [name]           Show a jail's details and rootfs size
#   jroot size [name]           Show disk usage per jail
#   jroot history [name]        What was done to a jail, and when
#   jroot logs [name]           Alias for a jail's history/events
#   jroot compare <a> <b>       Diff two jails (config + package lists)
#   jroot which [jail] <prog>   Find a program across jails
#   jroot update [name]         Update runtime + jail packages (all if no name)
#   jroot clean <name>...       Free disk space (apt caches, lists, logs)
#   jroot snapshot <name> [label]  Save rootfs + config (tar.gz)
#   jroot snapshots <name>      List snapshots for a jail
#   jroot revert <name> [label] Restore a jail to a snapshot
#   jroot rm-snapshot <name> <label>  Delete a snapshot
#   jroot doctor [--mute=...]   Check the installation for problems
#   jroot rm <name>             Delete a jail and its config
#   jroot rename <name> <new>   Rename a jail (rootfs, config, snapshots)
#   jroot completion <shell>    Print a bash/zsh/fish completion script
#   jroot help [command]        Show this help, or help for one command
#
# Everything lives under ~/.jroot and works without host root:
#   roots/<name>          rootfs        configs/<name>.json   jail config
#   snapshots/<name>/     snapshots     history/<name>.log    jail provenance
#
# Layers:
#   proot    -> fake rootfs/root, no chroot, no mount, no cgroups needed
#   apt      -> HTTPS mirrors (port 80 often blocked), trusted=yes + gpgv shim
#   seccomp  -> python3 filter refuses the syscalls proot cannot trace:
#               openat2/faccessat2/fchmodat2, the fs-tree family, io_uring
#               (rings bypass ptrace entirely) and pidfd_getfd
#   landlock -> kernel-enforced path allowlist applied by the same launcher;
#               the only layer that also covers musl (Alpine) jails
#   shim     -> LD_PRELOAD libjroot.so gives the jail its own address inside
#               127/8 (so two jails can hold the same port), hides host
#               processes from /proc, and returns EROFS for ro mounts. glibc only.
#
# Per-jail options (set at init, changeable via `jroot config`):
#   user            root (fake root via proot -0) or unroot (installs as root,
#                   then daily enter is the non-root user 'jail', root locked)
#   build_essential install gcc/g++/make during bootstrap
#   mount_host      bind host / to /mnt/host inside the jail
#   mount_home      bind host $HOME to /mnt/home inside the jail
#   ports           ports allowed to bind publicly (see `jroot port`)
#   loopback        this jail's address inside 127/8, or "off" (see `jroot net`)
#   mounts          extra host dirs at /mnt/<label>, rw or ro (see `jroot mnt`)
#
# Env (optional):
#   JROOT_HOME=path        Override storage root (default $HOME/.jroot)
#   JROOT_KERNEL=x.y.z     Kernel release reported inside jails (default 6.8.0)
#   JROOT_LANDLOCK_OFF=1   Skip the Landlock allowlist (debugging only)
#   JROOT_SHOW_ALL_PROCS=1 Let jails see every host process in /proc
#   JROOT_SHIM_OFF=1       Do not load the LD_PRELOAD shim at all
#   JROOT_SKIP_APT=1       Skip the apt bootstrap during init
#   JROOT_SKIP_BOOTSTRAP=1 Same as above
#   NONINTERACTIVE=1       Use all prompt defaults
#   SKIP_BUILD_ESSENTIAL=1 Skip build-essential      (0 = install)
#   MOUNT_HOST=1/0         Enable/disable host / mount
#   MOUNT_HOME=1/0         Enable/disable home mount
# =============================================================================
set -e

# Command prefix shown in error hints / help ("jroot " normally; empty inside
# the interactive "jroot shell" so hints read "run 'help'" instead).
CMD_HINT="jroot "

C_RED='\033[1;31m'; C_GRN='\033[1;32m'; C_YEL='\033[1;33m'; C_NC='\033[0m'
C_CYA='\033[1;36m'; C_BLU='\033[1;34m'; C_BLD='\033[1m'; C_DIM='\033[2m'
log()  { echo -e "${C_GRN}[+]${C_NC} $1"; }
# Warnings go to stderr: several call sites capture a function's stdout
# (set_config_ports, resolve_jail_shim, config helpers), and a warning landing in
# a captured value has silently corrupted config values and the shim mode before.
warn() { echo -e "${C_YEL}[!]${C_NC} $1" >&2; }
err()  { echo -e "${C_RED}[!]${C_NC} $1" >&2; exit 1; }

# Color the help text only when stdout is a terminal (pipes stay plain).
USE_COLOR=0
[ -t 1 ] && USE_COLOR=1
H="$C_CYA"; G="$C_GRN"; B="$C_BLU"; D="$C_DIM"; N="$C_NC"
[ "$USE_COLOR" = 1 ] || { H=""; G=""; B=""; D=""; N=""; }

# run_in_jails HOME=/root (or /home/jail) into this process, so $HOME is
# no longer the host's home after the first jail launch. Capture it once, before
# anything can clobber it: init/update/verify all call run_in_jail more than once
# per run, and the later calls still need the real host home for /mnt/home.
REAL_HOME="$HOME"
# Kept separately from JROOT_HOME so an alternate runtime location can still
# discover the SDK bundled beside a source checkout or launcher.
JROOT_LAUNCHER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
JROOT_LAUNCHER_PATH="$JROOT_LAUNCHER_DIR/$(basename "${BASH_SOURCE[0]}")"
JROOT_HOME="${JROOT_HOME:-$REAL_HOME/.jroot}"
ROOTS_DIR="$JROOT_HOME/roots"
CONFIGS_DIR="$JROOT_HOME/configs"
SNAPSHOTS_DIR="$JROOT_HOME/snapshots"
HISTORY_DIR="$JROOT_HOME/history"
BIN_DIR="$JROOT_HOME/bin"
CACHE_DIR="$JROOT_HOME/.cache"
PROOT_BIN="$BIN_DIR/proot"
SECCOMP_LAUNCHER="$BIN_DIR/seccomp-launcher"
PROOT_VERSION="5.3.0"
# Reported kernel release inside jails. Newer than 5.1.0 so glibc-based apps
# (e.g. code-server) don't die with "FATAL: kernel too old".
PROOT_KERNEL_RELEASE="${JROOT_KERNEL:-6.8.0}"
# LD_PRELOAD shim that rewrites bind() so jailed servers are loopback-only by
# default; ports listed in the jail's config "ports" field are left public.
PORT_SHIM_SRC="$BIN_DIR/libjroot.c"
PORT_SHIM="$BIN_DIR/libjroot.so"
# Build marker for the shim. Bump it whenever libjroot.c changes so existing
# .so files - including ones compiled inside a jail - are replaced.
SHIM_VERSION="jroot-shim-v7"

# Landlock filesystem access masks, used to compose the JROOT_LANDLOCK rule
# list consumed by the seccomp launcher (see write_seccomp_launcher).
#   FULL = every fs bit up to ABI v3 (read/write/exec/create/remove/truncate)
#   RX   = EXECUTE | READ_FILE | READ_DIR - enough to run and read, not write
LANDLOCK_FULL="0x7fff"
LANDLOCK_RX="0xd"
LANDLOCK_RULES=""

landlock_allow() { LANDLOCK_RULES="${LANDLOCK_RULES}${1}"$'\t'"${2}"$'\n'; }
landlock_deny()  { LANDLOCK_RULES="${LANDLOCK_RULES}!${1}"$'\n'; }

ARCH="$(uname -m)"
case "$ARCH" in
    x86_64)  ARCH_STR="x86_64"; ROOTFS_ARCH="amd64" ;;
    aarch64) ARCH_STR="aarch64"; ROOTFS_ARCH="arm64" ;;
    *)       err "Unsupported architecture: $ARCH" ;;
esac

UBUNTU_VERSIONS="16.04:xenial 18.04:bionic 20.04:focal 22.04:jammy 23.04:lunar 23.10:mantic 24.04:noble 24.10:oracular 25.04:plucky 25.10:questing 26.04:resolute"
ALPINE_VERSIONS="3.18 3.19 3.20 3.21 3.22 edge"
SUPPORTED_IMAGES="ubuntu alpine"

version_to_codename() {
    local v c
    for pair in $UBUNTU_VERSIONS; do
        v="${pair%%:*}"; c="${pair##*:}"
        [ "$v" = "$1" ] && { echo "$c"; return 0; }
    done
    return 1
}

codename_to_version() {
    local v c
    for pair in $UBUNTU_VERSIONS; do
        v="${pair%%:*}"; c="${pair##*:}"
        [ "$c" = "$1" ] && { echo "$v"; return 0; }
    done
    return 1
}

alpine_version_exists() {
    local ver
    for ver in $ALPINE_VERSIONS; do
        [ "$ver" = "$1" ] && return 0
    done
    return 1
}

list_images() {
    printf '%bSupported images:%b\n' "$C_CYA" "$C_NC"
    printf '  %bubuntu:<version>%b  - Ubuntu Linux versions:\n' "$C_GRN" "$C_NC"
    printf '    16.04, 18.04, 20.04, 22.04, 23.04, 23.10, 24.04, 24.10, 25.04, 25.10, 26.04\n'
    printf '\n'
    printf '  %balpine:<version>%b  - Alpine Linux versions:\n' "$C_GRN" "$C_NC"
    printf '    3.18, 3.19, 3.20, 3.21, 3.22, edge\n'
    printf '\n'
    printf '%bExamples:%b\n' "$C_CYA" "$C_NC"
    printf '  %bjroot init ubuntu:22.04%b\n' "$C_GRN" "$C_NC"
    printf '  %bjroot init alpine:3.20%b\n' "$C_GRN" "$C_NC"
}

ask() {
    local prompt="$1" default="$2" response
    if [ -n "${NONINTERACTIVE:-}" ]; then
        echo "$default"
        return 0
    fi
    printf '%s' "$prompt" >&2
    read -r response || response="$default"
    echo "${response:-$default}"
}

# $1 prompt, $2 default, $3 cli-provided value (used verbatim if non-empty)
resolve() {
    if [ -n "$3" ]; then
        printf '%s' "$3"
        return 0
    fi
    ask "$1" "$2"
}

json_esc() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# ---------------------------------------------------------------------------
# Jail history: an append-only provenance log per jail, one TSV line per event
#   <epoch>\t<event>\t<detail>
# Written by the commands that change a jail, read back by `jroot history`.
# ---------------------------------------------------------------------------
history_file() {
    printf '%s/%s.log' "$HISTORY_DIR" "$1"
}

# record_event <jail> <event> [detail...]
# Never fails a command: history is a convenience, not a transaction log.
record_event() {
    local name="$1" event="$2"; shift 2 || true
    local detail="$*"
    [ -n "$name" ] && [ -n "$event" ] || return 0
    mkdir -p "$HISTORY_DIR" 2>/dev/null || return 0
    # Tabs and newlines would break the record format.
    detail="$(printf '%s' "$detail" | tr '\t\n' '  ')"
    printf '%s\t%s\t%s\n' "$(date +%s)" "$event" "$detail" \
        >> "$(history_file "$name")" 2>/dev/null || true
    return 0
}

# ---------------------------------------------------------------------------
# Runtime: dirs + seccomp launcher
# ---------------------------------------------------------------------------
write_seccomp_launcher() {
    cat > "$SECCOMP_LAUNCHER" << 'PYEOF'
#!/usr/bin/env python3
import ctypes, platform, sys, os

libc = ctypes.CDLL(None, use_errno=True)

PR_SET_NO_NEW_PRIVS = 38
PR_SET_SECCOMP = 22
SECCOMP_MODE_FILTER = 2

class sock_filter(ctypes.Structure):
    _fields_ = [("code", ctypes.c_ushort), ("jt", ctypes.c_ubyte),
                ("jf", ctypes.c_ubyte), ("k", ctypes.c_uint)]

class sock_fprog(ctypes.Structure):
    _fields_ = [("len", ctypes.c_ushort), ("filter", ctypes.POINTER(sock_filter))]

BPF_LD = 0x00; BPF_W = 0x00; BPF_ABS = 0x20
BPF_JMP = 0x05; BPF_JEQ = 0x10; BPF_JGT = 0x20; BPF_RET = 0x06; BPF_K = 0x00
BPF_STMT = lambda code, k: sock_filter(code, 0, 0, k)
BPF_JUMP = lambda code, k, jt, jf: sock_filter(code, jt, jf, k)

SECCOMP_RET_ERRNO = 0x00050000
SECCOMP_RET_ALLOW = 0x7fff0000
SECCOMP_RET_KILL_PROCESS = 0x80000000

machine = platform.machine()
if machine in ("x86_64", "AMD64"):
    AUDIT_ARCH = 0xC000003E
elif machine in ("aarch64", "arm64"):
    AUDIT_ARCH = 0xC00000B7
else:
    sys.stderr.write("jroot: unsupported arch for seccomp filter: %s\n" % machine)
    sys.exit(1)

ENOSYS = 38
OPENAT2_NR = 437
FACCESSAT2_NR = 439
FCHMODAT2_NR = 452
OPEN_TREE_NR = 428
MOVE_MOUNT_NR = 429
FSOPEN_NR = 430
FSCONFIG_NR = 431
FSMOUNT_NR = 432
FSPICK_NR = 433
MOUNT_SETATTR_NR = 442
# io_uring: submission happens through shared ring buffers, so individual file
# operations are NOT syscalls and proot's ptrace interception never sees them.
IO_URING_SETUP_NR = 425
IO_URING_ENTER_NR = 426
IO_URING_REGISTER_NR = 427
# pidfd_getfd steals a live file descriptor out of another process - including
# proot itself, which holds descriptors outside the jail.
PIDFD_GETFD_NR = 438
OFFSET_ARCH = 4
OFFSET_NR = 0

# jroot-seccomp-v7
# proot 5.3.0 does not trace the modern *at2 family (openat2/faccessat2/fchmodat2)
# or the fs-tree family (open_tree/move_mount/fsopen/fsconfig/fsmount/fspick/
# mount_setattr), so a jailed worker could reach real host paths (e.g. ~/.jroot
# configs) with raw syscalls that skip both proot and the LD_PRELOAD shim. Return
# ENOSYS: for *at2 the caller falls back to the classic variant (which proot
# traces and the shim denies); the fs-tree calls have no fallback but are never
# legitimately needed inside a jail and otherwise only fail with EPERM until the
# jail runs privileged, at which point they become live escapes.
#
# io_uring is a wider hole than openat2 ever was: once a ring is set up, reads,
# writes and openat operations are submitted via mmap'd queues, so ptrace-based
# path translation is bypassed entirely for every operation on that ring. There
# is no way to filter individual ring operations from here, so the ring itself
# is refused. ENOSYS makes liburing and glibc fall back to normal syscalls,
# which proot does trace.
#
# NOTE for anyone extending this list: the filter is installed before execv() of
# proot, so PROOT INHERITS IT TOO. Any syscall proot itself needs (ptrace, wait4,
# process_vm_readv, ...) must stay allowed, which is why only calls proot never
# makes can be denied by number.
program = [
    # idx0: load arch
    BPF_STMT(BPF_LD | BPF_W | BPF_ABS, OFFSET_ARCH),
    # idx1: if arch matches -> idx3, else idx2
    BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, AUDIT_ARCH, 1, 0),
    # idx2: kill (unexpected arch)
    BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS),
    # idx3: load syscall nr
    BPF_STMT(BPF_LD | BPF_W | BPF_ABS, OFFSET_NR),
    # idx4: if nr > 0x3fffffff (x32 ABI) -> idx5, else idx6
    BPF_JUMP(BPF_JMP | BPF_JGT | BPF_K, 0x3fffffff, 0, 1),
    # idx5: kill (x32 ABI)
    BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS),
]

# One "if nr == X: return ENOSYS" pair per entry. jt=0 falls through to the
# ENOSYS return, jf=1 skips it and reaches the next comparison.
DENY_ENOSYS = [
    (OPENAT2_NR, "openat2 -> fallback openat"),
    (FACCESSAT2_NR, "faccessat2 -> fallback faccessat"),
    (FCHMODAT2_NR, "fchmodat2 -> fallback fchmodat"),
    (OPEN_TREE_NR, "open_tree"),
    (MOVE_MOUNT_NR, "move_mount"),
    (FSOPEN_NR, "fsopen"),
    (FSCONFIG_NR, "fsconfig"),
    (FSMOUNT_NR, "fsmount"),
    (FSPICK_NR, "fspick"),
    (MOUNT_SETATTR_NR, "mount_setattr"),
    (IO_URING_SETUP_NR, "io_uring_setup -> fallback to traced syscalls"),
    (IO_URING_ENTER_NR, "io_uring_enter"),
    (IO_URING_REGISTER_NR, "io_uring_register"),
    (PIDFD_GETFD_NR, "pidfd_getfd"),
]

for _nr, _why in DENY_ENOSYS:
    program.append(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, _nr, 0, 1))
    program.append(BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ERRNO | ENOSYS))

# allow everything else
program.append(BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW))

ArrayType = sock_filter * len(program)
arr = ArrayType(*program)
prog = sock_fprog()
prog.len = len(program)
prog.filter = ctypes.cast(arr, ctypes.POINTER(sock_filter))

# Try to enable seccomp. On WSL1 (no seccomp support), PR_SET_SECCOMP
# returns EINVAL (22). Fall back gracefully with a warning.
try:
    if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
        raise OSError(ctypes.get_errno(), "PR_SET_NO_NEW_PRIVS")
    if libc.prctl(PR_SET_SECCOMP, SECCOMP_MODE_FILTER, ctypes.byref(prog)) != 0:
        raise OSError(ctypes.get_errno(), "PR_SET_SECCOMP")
except OSError as e:
    if e.errno == 22:  # EINVAL - WSL1 / kernel without seccomp
        sys.stderr.write("jroot: WARNING: seccomp not supported on this kernel ")
        sys.stderr.write("(WSL1? older kernel?). Skipping seccomp filter.\n")
        sys.stderr.write("jroot: Security reduced - openat2 escape NOT blocked.\n")
        # Continue without seccomp - proot still works
    else:
        raise

# Landlock: kernel-enforced, inode-based filesystem allowlist. This is the
# authoritative defense against syscalls proot does not trace (faccessat2,
# fchmodat2, open_tree, fsopen, ...): any path with no allow rule is refused
# by the kernel with EACCES, regardless of syscall number, and it works the
# same for musl jails where the LD_PRELOAD shim cannot be loaded.
#
# JROOT_LANDLOCK carries one "PATH\tMASK" line per allow and one "!PATH" line
# per deny. Landlock resolves an access against the rule on the file itself or
# its closest parent with a rule, so a deny on ~/.jroot still lets a deeper
# allow on ~/.jroot/roots/<jail> through.
#
# A deny cannot be expressed as a zero mask: landlock_add_rule() rejects an
# empty allowed_access with ENOMSG. LANDLOCK_ACCESS_FS_MAKE_BLOCK (1 << 11) is
# used instead - it is a handled bit in every ABI, and creating a block device
# needs CAP_MKNOD, which a rootless jail never has. So it grants nothing while
# still shadowing the inherited read/write/exec rights of the parent rule.
#
# File type matters: a rule attached to a NON-directory may only carry file
# access rights (EXECUTE, WRITE_FILE, READ_FILE, TRUNCATE, IOCTL_DEV). Passing
# directory rights for a socket or a regular file is rejected with EINVAL, so
# masks are trimmed per inode type below.
#
# Best effort in both directions: if the kernel lacks Landlock, or if any rule
# is rejected, we warn and leave the ruleset unapplied rather than enforcing a
# half-built policy - a partial allowlist breaks proot in ways that look like
# random "Permission denied" failures. JROOT_LANDLOCK_STRICT=1 enforces anyway.
LANDLOCK_DENY_MASK = 0x800   # MAKE_BLOCK only == no usable access
LANDLOCK_FILE_MASK = 0xC007  # EXECUTE|WRITE_FILE|READ_FILE|TRUNCATE|IOCTL_DEV
if os.environ.get("JROOT_LANDLOCK"):
    import stat as statmod
    import struct
    LANDLOCK_RULE_PATH_BENEATH = 1
    strict = bool(os.environ.get("JROOT_LANDLOCK_STRICT"))
    entries = []
    for line in os.environ["JROOT_LANDLOCK"].splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("!"):
            entries.append((line[1:].strip(), LANDLOCK_DENY_MASK))
        else:
            path, _, mask = line.partition("\t")
            entries.append((path, int(mask or "0x7fff", 16)))
    # Do not leak the host path list into the jail's environment.
    os.environ.pop("JROOT_LANDLOCK", None)
    os.environ.pop("JROOT_LANDLOCK_STRICT", None)
    if entries:
        handled = 0
        fd = -1
        for probe in (0x7fff, 0x3fff, 0x1fff):  # ABI v3/v2/v1 fs bits
            attr = ctypes.create_string_buffer(struct.pack("QQ", probe, 0), 16)
            fd = libc.syscall(444, ctypes.byref(attr), 16, 0)  # create_ruleset
            if fd >= 0:
                handled = probe
                break
        if handled == 0:
            sys.stderr.write("jroot: landlock: not supported by this kernel, skipping\n")
        else:
            rejected = 0
            for path, mask in entries:
                mask &= handled
                try:
                    real = os.path.realpath(path)
                    is_dir = statmod.S_ISDIR(os.stat(real).st_mode)
                except OSError:
                    continue
                if not is_dir:
                    mask &= LANDLOCK_FILE_MASK
                    if mask == 0:
                        # Nothing left to express: on a non-directory the only
                        # legal bits are real grants, so a deny would have to
                        # hand out read/write/exec. Skip it - the proot
                        # bind-over of an empty stand-in file covers this.
                        continue
                elif mask == 0:
                    mask = LANDLOCK_DENY_MASK & handled
                try:
                    o = os.open(real, os.O_PATH | os.O_CLOEXEC)
                except OSError:
                    continue
                try:
                    rb = ctypes.create_string_buffer(struct.pack("Q i I", mask, o, 0), 16)
                    if libc.syscall(445, fd, LANDLOCK_RULE_PATH_BENEATH, ctypes.byref(rb), 0) < 0:
                        rejected += 1
                        sys.stderr.write("jroot: landlock: rule %s: %s\n"
                                         % (path, os.strerror(ctypes.get_errno())))
                finally:
                    os.close(o)
            if rejected and not strict:
                sys.stderr.write(
                    "jroot: landlock: %d rule(s) rejected by the kernel - "
                    "continuing WITHOUT the Landlock layer so the jail still "
                    "works (seccomp and proot still apply). Set "
                    "JROOT_LANDLOCK_STRICT=1 to enforce it anyway.\n" % rejected)
                os.close(fd)
            elif libc.syscall(446, fd, 0) < 0:  # restrict_self
                sys.stderr.write("jroot: landlock: restrict_self: %s\n"
                                 % os.strerror(ctypes.get_errno()))
            else:
                os.close(fd)
else:
    os.environ.pop("JROOT_LANDLOCK", None)
    os.environ.pop("JROOT_LANDLOCK_STRICT", None)

# This process is about to BECOME proot: execv keeps the pid, so our pid is the
# one that will trace every guest process. The shim uses it to tell the jail's
# processes apart from the host's when filtering /proc (see JROOT_PROC_ROOT in
# libjroot.c). Set after Landlock, so a failure above never leaves it stale.
os.environ["JROOT_PROC_ROOT"] = str(os.getpid())

os.execv(sys.argv[1], sys.argv[1:])
PYEOF
    chmod +x "$SECCOMP_LAUNCHER"
}

ensure_runtime() {
    mkdir -p "$ROOTS_DIR" "$CONFIGS_DIR" "$SNAPSHOTS_DIR" "$BIN_DIR" "$CACHE_DIR" "$HISTORY_DIR" "$JROOT_HOME/pids"
    mkdir -p "$JROOT_HOME/.denied"; : > "$JROOT_HOME/.deniedbin"
    if [ ! -x "$SECCOMP_LAUNCHER" ] || ! grep -q "jroot-seccomp-v7" "$SECCOMP_LAUNCHER"; then
        write_seccomp_launcher
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        warn "python3 not found on host - jails will enter WITHOUT the seccomp filter (openat2/io_uring escape vectors) and WITHOUT Landlock. Install python3."
    fi
    # Check if warnings should be silenced
    local mute_file="$JROOT_HOME/.mute-warnings"
    local mute_until=""
    if [ -f "$mute_file" ]; then
        mute_until="$(cat "$mute_file" 2>/dev/null || true)"
    fi
    local now="$(date +%s)"
    if [ -n "$mute_until" ] && [ "$mute_until" -gt "$now" ]; then
        build_port_shim 2>/dev/null || true
    else
        build_port_shim || true
    fi
}

build_port_shim() {
    local src="$PORT_SHIM_SRC"
    # Rebuild when the .so is missing/stale, or when this jroot carries a newer
    # shim than the C file on disk. Without the version check an existing .so
    # newer than its source would keep an old shim alive forever after an
    # upgrade (that is how the pre-v2 shim survived jroot updates).
    if [ -f "$src" ] && grep -q "$SHIM_VERSION" "$src" 2>/dev/null; then
        local so_missing=0
        [ -f "$PORT_SHIM" ] || so_missing=1
        if [ "$so_missing" = "0" ] && [ "$PORT_SHIM" -nt "$src" ]; then
            return 0
        fi
    fi
    if ! command -v gcc >/dev/null 2>&1; then
        # Check if warnings are muted
        local mute_file="$JROOT_HOME/.mute-warnings"
        local mute_until=""
        if [ -f "$mute_file" ]; then
            mute_until="$(cat "$mute_file" 2>/dev/null || true)"
        fi
        local now="$(date +%s)"
        if [ -z "$mute_until" ] || [ "$mute_until" -le "$now" ]; then
            warn "gcc not found on host - 'jroot port', per-jail loopback addresses ('jroot net') and /proc process hiding are unavailable. Install gcc to use them."
            warn "Read-only mounts still work when the kernel has Landlock (see 'jroot doctor')."
            warn "To mute this warning for 7 days: jroot doctor --mute=7d"
            warn "To mute forever: jroot doctor --mute=forever"
        fi
        return 1
    fi
    cat > "$src" <<'CEOF'
#define _GNU_SOURCE
#include <sys/socket.h>
#include <sys/types.h>
#include <sys/stat.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>
#include <stdlib.h>
#include <stdio.h>
#include <errno.h>
#include <dlfcn.h>
#include <stdarg.h>
#include <dirent.h>
#include <sys/prctl.h>
#include <grp.h>

/* jroot-shim-v7 */

/* Greppable build marker: jroot compares this against the version it expects,
 * so an upgraded jroot always replaces an older .so (including one built inside
 * a jail). */
const char jroot_shim_version[] = "jroot-shim-v7";

/* Pin dlsym() to the oldest symbol version the platform has. Since glibc 2.34
 * the dl* functions live in libc.so.6 and a plain reference records
 * dlsym@GLIBC_2.34, which a jail on an older glibc cannot satisfy. The base
 * version node (2.2.5 on x86-64, 2.17 on aarch64) exists in every glibc of that
 * architecture, and 2.34+ keeps it as a compat alias, so pinning here is what
 * lets ONE host-built shim load in jails from 16.04 to 26.04.
 * musl has no symbol versioning at all, so the directive must not be emitted
 * when this file is compiled inside an Alpine jail. */
#if defined(__GLIBC__)
# if defined(__aarch64__)
__asm__(".symver dlsym,dlsym@GLIBC_2.17");
# elif defined(__x86_64__)
__asm__(".symver dlsym,dlsym@GLIBC_2.2.5");
# endif
#endif

/* Parse a non-negative decimal. Deliberately hand-rolled: with _GNU_SOURCE on
 * glibc >= 2.38, <stdlib.h> redirects strtol() to __isoc23_strtol(), which
 * stamps a GLIBC_2.38 requirement into this .so. The shim is built on the HOST
 * but loaded inside the JAIL, so one new symbol makes every jail with an older
 * libc fail to exec anything at all:
 *   /bin/bash: libc.so.6: version `GLIBC_2.38' not found (required by libjroot.so)
 * Keeping the symbol set old is what makes one host-built shim work in jails
 * from 16.04 to 26.04. */
static long jnum(const char *s) {
    long n = 0;
    if (!s) return -1;
    while (*s == ' ' || *s == '\t') s++;
    if (*s < '0' || *s > '9') return -1;
    while (*s >= '0' && *s <= '9') {
        n = n * 10 + (*s - '0');
        if (n > 0x7fffffff) return -1;
        s++;
    }
    return n;
}

typedef int (*bind_fn)(int, const struct sockaddr *, socklen_t);
typedef int (*connect_fn)(int, const struct sockaddr *, socklen_t);
typedef ssize_t (*sendto_fn)(int, const void *, size_t, int,
                             const struct sockaddr *, socklen_t);

static bind_fn real_bind = NULL;

static int parse_port(const char *s) {
    int n = 0;
    if (!s) return -1;
    while (*s >= '0' && *s <= '9') {
        n = n * 10 + (*s - '0');
        if (n > 65535) return -1;
        s++;
    }
    return *s ? -1 : n;
}

static int port_is_public(int port) {
    const char *env = getenv("JROOT_PORTS");
    if (!env || !*env) return 0;
    char *dup = strdup(env);
    char *tok, *save = NULL;
    int is_public = 0;
    for (tok = strtok_r(dup, ",", &save); tok; tok = strtok_r(NULL, ",", &save)) {
        if (parse_port(tok) == port) { is_public = 1; break; }
    }
    free(dup);
    return is_public;
}

/* ---- per-jail loopback address ---------------------------------------- *
 * JROOT_LOOPBACK carries this jail's own address inside 127/8 (see
 * `jroot net`). Listeners on non-public ports are pinned to it rather than to
 * 127.0.0.1, so three jails can each run a dev server on port 8080 without
 * colliding, and the host reaches each one at its own address.
 *
 * connect() is rewritten symmetrically: a jailed client asking for 127.0.0.1
 * is redirected to this jail's address, so "localhost" keeps working between
 * processes inside the jail. The side effect is that a jail no longer reaches
 * services on the HOST's 127.0.0.1 - run `jroot net set <name> off` when that
 * is what you want.
 *
 * Port 53 is never rewritten: /etc/resolv.conf may legitimately point at a
 * resolver on host loopback (systemd-resolved, dnsmasq), and silently breaking
 * DNS in every jail would be a bad trade for address tidiness.
 */
static in_addr_t jail_loopback(void) {
    static in_addr_t cached;
    static int done = 0;
    if (!done) {
        const char *e = getenv("JROOT_LOOPBACK");
        struct in_addr a;
        cached = htonl(INADDR_LOOPBACK);
        if (e && *e && inet_pton(AF_INET, e, &a) == 1) cached = a.s_addr;
        done = 1;
    }
    return cached;
}

/* ---- port remapping ---------------------------------------------------- *
 * JROOT_PORT_MAP carries "from=to" pairs, comma separated, e.g. "22=22022".
 *
 * The reason this exists: a rootless jail has fake root, not CAP_NET_BIND_
 * SERVICE, so bind() on any port below 1024 fails with EACCES no matter what
 * getuid() claims. `jroot ssh` still wants sshd to *believe* it owns port 22 -
 * its config says 22, its logs say 22, `ss` inside the jail says 22 - so the
 * shim silently moves the actual socket to a high port and the host-side
 * redirector forwards to that instead. The mapping is applied to bind(),
 * connect() and sendto() symmetrically, so a client inside the jail dialling
 * localhost:22 also lands on the real socket.
 *
 * Deliberately generic rather than hardcoded to 22: the same mechanism lets any
 * privileged-port service (80, 443, 25) run inside a rootless jail unchanged.
 */
static int port_remap(int port) {
    static char *map = NULL;
    static int loaded = 0;
    char *tok, *save = NULL;
    int from, to, result = port;
    if (!loaded) {
        const char *e = getenv("JROOT_PORT_MAP");
        map = (e && *e) ? strdup(e) : NULL;
        loaded = 1;
    }
    if (!map) return port;
    {
        char *dup = strdup(map);
        if (!dup) return port;
        for (tok = strtok_r(dup, ",", &save); tok; tok = strtok_r(NULL, ",", &save)) {
            char *eq = strchr(tok, '=');
            if (!eq) continue;
            *eq = 0;
            from = parse_port(tok);
            to = parse_port(eq + 1);
            if (from == port && to > 0) { result = to; break; }
        }
        free(dup);
    }
    return result;
}

int bind(int fd, const struct sockaddr *addr, socklen_t len) {
    if (!real_bind) real_bind = (bind_fn)dlsym(RTLD_NEXT, "bind");
    if (!addr) return real_bind(fd, addr, len);

    if (addr->sa_family == AF_INET && len >= sizeof(struct sockaddr_in)) {
        struct sockaddr_in a = *((struct sockaddr_in *)addr);
        int port = ntohs(a.sin_port);
        int mapped = port_remap(port);
        /* Publicness is decided on the port the application ASKED for, not the
         * one it ends up on: `jroot port add 22` must keep meaning "22". */
        if (!port_is_public(port)) {
            a.sin_addr.s_addr = jail_loopback();  /* this jail's own 127.x.y.z */
        }
        if (mapped != port) a.sin_port = htons((unsigned short)mapped);
        return real_bind(fd, (struct sockaddr *)&a, sizeof(a));
    }
    if (addr->sa_family == AF_INET6 && len >= sizeof(struct sockaddr_in6)) {
        struct sockaddr_in6 a = *((struct sockaddr_in6 *)addr);
        int port = ntohs(a.sin6_port);
        int mapped = port_remap(port);
        if (!port_is_public(port)) {
            /* IPv6 has exactly one loopback address, so v6-only listeners
             * cannot be separated per jail the way v4 ones can. */
            memset(&a.sin6_addr, 0, sizeof(a.sin6_addr));
            a.sin6_addr.s6_addr[15] = 1; /* force ::1 */
        }
        if (mapped != port) a.sin6_port = htons((unsigned short)mapped);
        return real_bind(fd, (struct sockaddr *)&a, sizeof(a));
    }
    return real_bind(fd, addr, len);
}

int connect(int fd, const struct sockaddr *addr, socklen_t len) {
    static connect_fn real = NULL;
    if (!real) real = (connect_fn)dlsym(RTLD_NEXT, "connect");
    if (addr && addr->sa_family == AF_INET && len >= sizeof(struct sockaddr_in)) {
        struct sockaddr_in a = *((struct sockaddr_in *)addr);
        int port = ntohs(a.sin_port);
        int mapped = port_remap(port);
        int loop = (a.sin_addr.s_addr == htonl(INADDR_LOOPBACK)
                    && port != 53
                    && jail_loopback() != htonl(INADDR_LOOPBACK));
        if (loop || mapped != port) {
            if (loop) a.sin_addr.s_addr = jail_loopback();
            if (mapped != port) a.sin_port = htons((unsigned short)mapped);
            return real(fd, (struct sockaddr *)&a, sizeof(a));
        }
    }
    return real(fd, addr, len);
}

ssize_t sendto(int fd, const void *buf, size_t n, int flags,
               const struct sockaddr *addr, socklen_t len) {
    static sendto_fn real = NULL;
    if (!real) real = (sendto_fn)dlsym(RTLD_NEXT, "sendto");
    if (addr && addr->sa_family == AF_INET && len >= sizeof(struct sockaddr_in)) {
        struct sockaddr_in a = *((struct sockaddr_in *)addr);
        int port = ntohs(a.sin_port);
        int mapped = port_remap(port);
        int loop = (a.sin_addr.s_addr == htonl(INADDR_LOOPBACK)
                    && port != 53
                    && jail_loopback() != htonl(INADDR_LOOPBACK));
        if (loop || mapped != port) {
            if (loop) a.sin_addr.s_addr = jail_loopback();
            if (mapped != port) a.sin_port = htons((unsigned short)mapped);
            return real(fd, buf, n, flags, (struct sockaddr *)&a, sizeof(a));
        }
    }
    return real(fd, buf, n, flags, addr, len);
}

/* ---- read-only mounts ------------------------------------------------ */

/* Lexically normalize a path (collapse . and .., no fs access needed). */
static void norm_path(const char *in, char *out, size_t outsz) {
    char *copy = strdup(in);
    char *segs[1024];
    int n = 0;
    char *p = copy;
    while (*p) {
        while (*p == '/') p++;
        if (!*p) break;
        char *seg = p;
        while (*p && *p != '/') p++;
        if (*p) *p++ = 0;
        int len = (int)strlen(seg);
        if (len == 1 && seg[0] == '.') continue;
        if (len == 2 && seg[0] == '.' && seg[1] == '.') {
            if (n > 0) n--;
            continue;
        }
        if (n < (int)(sizeof(segs) / sizeof(segs[0]))) segs[n++] = seg;
    }
    size_t used = 0;
    if (n == 0) {
        out[0] = '/';
        out[1] = 0;
    } else {
        int i;
        for (i = 0; i < n; i++) {
            size_t sl = strlen(segs[i]);
            if (used + sl + 2 > outsz) break;
            out[used++] = '/';
            memcpy(out + used, segs[i], sl);
            used += sl;
        }
        out[used] = 0;
    }
    free(copy);
}

static int path_is_ro(const char *path) {
    const char *ro = getenv("JROOT_RO_MOUNTS");
    if (!ro || !*ro) return 0;
    char abs[8192];
    if (path[0] != '/') {
        char cwd[8192];
        if (!getcwd(cwd, sizeof(cwd))) return 0;
        snprintf(abs, sizeof(abs), "%s/%s", cwd, path);
    } else {
        snprintf(abs, sizeof(abs), "%s", path);
    }
    char norm[8192];
    norm_path(abs, norm, sizeof(norm));
    char *dup = strdup(ro);
    char *tok, *save = NULL;
    int blocked = 0;
    for (tok = strtok_r(dup, ":", &save); tok; tok = strtok_r(NULL, ":", &save)) {
        if (!*tok) continue;
        size_t tl = strlen(tok);
        if (strncmp(norm, tok, tl) == 0 && (norm[tl] == 0 || norm[tl] == '/')) {
            blocked = 1;
            break;
        }
    }
    free(dup);
    return blocked;
}

static int want_write(int flags) {
    return (flags & (O_WRONLY | O_RDWR | O_CREAT | O_TRUNC | O_APPEND)) != 0;
}

static int blocked_errno(void) {
    errno = EROFS;
    return -1;
}

/* Resolve a dirfd+path pair to an absolute path (/proc/self/fd for dirfds). */
static int resolve_at(int dirfd, const char *path, char *out, size_t outsz) {
    if (path[0] == '/') {
        snprintf(out, outsz, "%s", path);
        return 1;
    }
    if (dirfd == AT_FDCWD) {
        char cwd[8192];
        if (!getcwd(cwd, sizeof(cwd))) return 0;
        snprintf(out, outsz, "%s/%s", cwd, path);
        return 1;
    }
    char fdpath[64];
    snprintf(fdpath, sizeof(fdpath), "/proc/self/fd/%d", dirfd);
    ssize_t l = readlink(fdpath, out, outsz - 1);
    if (l < 0) return 0;
    out[l] = 0;
    size_t bl = strlen(out);
    if (bl + strlen(path) + 2 > outsz) return 0;
    out[bl] = '/';
    strcpy(out + bl + 1, path);
    return 1;
}

static int at_is_ro(int dirfd, const char *path) {
    if (!path || !*path) return 0;
    char abs[8192];
    if (!resolve_at(dirfd, path, abs, sizeof(abs))) return 0;
    return path_is_ro(abs);
}

/* ---- deny layer: jroot internals look non-existent ---------------------- */

static int denied_errno(void) {
    errno = ENOENT;
    return -1;
}

/* Forward declarations for the /proc filter, which lives further down next to
 * the readdir hooks. path_is_denied() below needs it: hiding a foreign
 * /proc/<pid> is the same operation as hiding ~/.jroot, so both are decided in
 * one place, but the pid-membership logic belongs with the rest of the /proc
 * code rather than up here. */
static int jp_enabled(void);
static int jp_member(pid_t pid);

/* Re-entrancy guard. jp_member() answers "does this pid belong to my jail?" by
 * READING /proc/<pid>/status and /proc/<pid>/stat - through open(), which is
 * itself one of our shims, which calls path_is_denied(), which asks jp_member()
 * again. That recursion overflows the stack and the process dies with SIGSEGV.
 * While a membership lookup is in flight, the /proc check is therefore skipped
 * so the lookup's own reads go straight through. */
static __thread int jp_in_lookup = 0;

/* A path inside the ~/.jroot config/rootfs tree, or the installed jroot
 * binary itself, must look NON-EXISTENT from inside every jail - regardless
 * of how host directories are bind-mounted in (custom mounts, / at /mnt/host,
 * or $HOME at /mnt/home). Otherwise a jailed user could edit a jail's config
 * (switch themselves to root, open public ports) or replace the jroot binary
 * for the next run. Applied to BOTH read and write syscalls. */
static int path_is_denied(const char *path) {
    if (!path || !*path) return 0;
    char abs[8192];
    if (path[0] != '/') {
        char cwd[8192];
        if (!getcwd(cwd, sizeof(cwd))) return 0;
        snprintf(abs, sizeof(abs), "%s/%s", cwd, path);
    } else {
        snprintf(abs, sizeof(abs), "%s", path);
    }
    char norm[8192];
    norm_path(abs, norm, sizeof(norm));
    {
        char *dup = strdup(norm);
        char *tok, *save = NULL;
        int denied = 0;
        for (tok = strtok_r(dup, "/", &save); tok; tok = strtok_r(NULL, "/", &save)) {
            if (strcmp(tok, ".jroot") == 0) { denied = 1; break; }
        }
        free(dup);
        if (denied) return 1;
    }
    {
        static const char bin[] = "/.local/bin/jroot";
        size_t nl = strlen(norm);
        size_t bl = sizeof(bin) - 1;
        if (nl >= bl && strcmp(norm + nl - bl, bin) == 0) return 1;
    }
    /* /proc process hiding: make /proc/<foreign_pid> and everything under it
     * look non-existent. This blocks open(), stat(), access(), readlink() etc.
     * on paths like /proc/1234/cmdline when pid 1234 is not part of this jail.
     * Combined with the readdir() filter above, host processes become fully
     * invisible to glibc-linked programs inside the jail.
     * jp_in_lookup keeps jp_member's own /proc reads from recursing back here. */
    if (!jp_in_lookup && jp_enabled() && strncmp(norm, "/proc/", 6) == 0) {
        const char *after = norm + 6;
        if (*after >= '0' && *after <= '9') {
            long pid = 0;
            const char *p = after;
            while (*p >= '0' && *p <= '9') {
                pid = pid * 10 + (*p - '0');
                if (pid > 0x7fffffff) goto proc_pass;
                p++;
            }
            if (*p == '\0' || *p == '/') {
                if (!jp_member((pid_t)pid)) return 1;
            }
        }
    }
proc_pass:
    return 0;
}

static int at_is_denied(int dirfd, const char *path) {
    if (!path || !*path) return 0;
    char abs[8192];
    if (!resolve_at(dirfd, path, abs, sizeof(abs))) return 0;
    return path_is_denied(abs);
}

#define DENY_OR_RO(p) \
    do { if (path_is_denied(p)) return denied_errno(); \
         if (path_is_ro(p)) return blocked_errno(); } while (0)

#define DENY_OR_RO_AT(fd, p) \
    do { if (at_is_denied((fd), (p))) return denied_errno(); \
         if (at_is_ro((fd), (p))) return blocked_errno(); } while (0)


