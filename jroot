}

jroot_cmd() {
    [ $# -ge 1 ] || { cmd_help; return 0; }
    case "$1" in
        init)          shift; cmd_init "$@" ;;
        build)         shift; cmd_build "$@" ;;
        enter)         shift; cmd_enter "$@" ;;
        exec)          shift; cmd_exec "$@" ;;
        file)          shift; cmd_file "$@" ;;
        sync)          shift; cmd_sync "$@" ;;
        limit)         shift; cmd_limit "$@" ;;
        bundle)        shift; cmd_bundle "$@" ;;

        deploy)        shift; cmd_deploy "$@" ;;
        monitor)       shift; cmd_monitor "$@" ;;
        compose)       shift; cmd_compose "$@" ;;
        port)          shift; cmd_port "$@" ;;
        net)           shift; cmd_net "$@" ;;
        mnt)           shift; cmd_mnt "$@" ;;
        mount)         shift; cmd_mnt "$@" ;;
        install)       shift; cmd_install "$@" ;;
        config)        shift; cmd_config "$@" ;;
        list|ls)       shift; cmd_list "$@" ;;
        info)          shift; cmd_info "$@" ;;
        history|logs)  shift; cmd_history "$@" ;;
        compare|diff)  shift; cmd_compare "$@" ;;
        which)         shift; cmd_which "$@" ;;
        size)          shift; cmd_size "$@" ;;
        update)        shift; cmd_update "$@" ;;
        clean)         shift; cmd_clean "$@" ;;
        snapshot)      shift; cmd_snapshot "$@" ;;
        snapshots)     shift; cmd_snapshots "$@" ;;
        checkpoint)    shift; cmd_checkpoint "$@" ;;
        checkpoints)   shift; cmd_checkpoints "$@" ;;
        revert)        shift; cmd_revert "$@" ;;
        rm-snapshot)   shift; cmd_rm_snapshot "$@" ;;
        rm-checkpoint) shift; cmd_rm_checkpoint "$@" ;;
        doctor)        shift; cmd_doctor "$@" ;;
        rm|delete)     shift; cmd_rm "$@" ;;
        rename)        shift; cmd_rename "$@" ;;
        kill|stop)     shift; cmd_kill "$@" ;;
        ps)            shift; cmd_ps "$@" ;;
        ssh)           shift; cmd_ssh "$@" ;;
        completion|completions) shift; cmd_completion "$@" ;;
        plugin)        shift; cmd_plugin "$@" ;;
        help|--help|-h) shift; cmd_help "$@" ;;
        *)
            if run_plugin "$1" "$@"; then
                exit 0
            else
                err "Unknown command: $1 (run '${CMD_HINT}help')"
            fi
            ;;
    esac
}

cmd_shell() {
    local line
    CMD_HINT=""
    printf '%bjroot interactive shell%b - run jroot commands without the prefix.\n' "$G" "$N"
    printf '    Type %bhelp%b for commands, %bexit%b to leave.\n\n' "$G" "$N" "$G" "$N"
    while true; do
        read -r -p "jroot> " -a line || { printf 'Bye!\n'; return 0; }
        if [ "${#line[@]}" -eq 0 ]; then
            continue
        fi
        case "${line[0]}" in
            exit|quit|bye|leave|exit\(\)|quit\(\)|:q|q) printf 'Bye!\n'; return 0 ;;
            help|--help|-h) cmd_help "${line[@]:1}" 2>&1 | sed -E 's/jroot ([a-z])/\1/g' ;;
            *)             (jroot_cmd "${line[@]}") || true ;;
        esac
    done
}

main() {
    [ $# -ge 1 ] || { cmd_help; exit 0; }
    case "$1" in
        shell)         shift; cmd_shell "$@" ;;
        *)             jroot_cmd "$@" ;;
    esac
}

main "$@"
