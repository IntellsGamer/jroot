/* ---- /proc: hide processes that do not belong to this jail -------------- *
 * proot binds the host /proc, so without this a jailed `ps aux` lists every
 * process on the machine, complete with command lines, and `pkill` inside a
 * jail can match host processes by accident.
 *
 * JROOT_PROC_ROOT carries the pid that owns this jail: the seccomp launcher,
 * which *becomes* proot after execv (execv keeps the pid). A pid belongs to
 * the jail when it is traced by the same proot that traces us - true for every
 * guest process, including daemons that double-forked and got reparented to
 * host pid 1 - or when its parent chain leads back to JROOT_PROC_ROOT, which
 * covers the no-python fallback path where the root is jroot's own shell.
 *
 * When the variable is missing the filter falls back to "whoever is tracing me",
 * which inside a jail is always proot. That matters for sessions jroot did not
 * launch directly: sshd builds a clean environment for each login and drops
 * LD_PRELOAD and every JROOT_* variable, so an SSH session used to end up with
 * no filtering at all. `jroot ssh` restores the environment through a
 * ForceCommand wrapper, and this fallback is the second line of defence for any
 * process that still slips through.
 *
 * Coverage: glibc's readdir() path (ls, ps, htop, python's os.listdir) and
 * direct path access (open/stat/access/readlink on /proc/<pid>/...). A program
 * issuing getdents64() itself - statically linked tools, Go binaries - still
 * sees every pid, and Alpine (musl) jails never load this shim. Set
 * JROOT_SHOW_ALL_PROCS=1 to disable.
 */
#define JP_DIRS 64
static void *jp_dirs[JP_DIRS];
static int jp_cache_pid[256];
static char jp_cache_val[256];

/* Read TracerPid from /proc/self/status. Used both as the identity of "my
 * proot" and, when JROOT_PROC_ROOT is absent, as the jail root itself. */
static pid_t jp_self_tracer_raw(void) {
    char buf[4096], *p;
    int fd;
    ssize_t n;
    fd = open("/proc/self/status", O_RDONLY);
    if (fd < 0) return -1;
    n = read(fd, buf, sizeof(buf) - 1);
    close(fd);
    if (n <= 0) return -1;
    buf[n] = 0;
    p = strstr(buf, "TracerPid:");
    if (!p) return -1;
    return (pid_t)jnum(p + 10);
}

static int jp_enabled(void) {
    static int e = -1;
    if (e < 0) {
        const char *r = getenv("JROOT_PROC_ROOT");
        if (getenv("JROOT_SHOW_ALL_PROCS")) {
            e = 0;
        } else if (r && *r) {
            e = 1;
        } else {
            /* No variable: enable only if something is tracing us, which inside
             * a jail is proot. Outside a jail nothing traces us and the filter
             * stays off, so preloading this shim by hand is still harmless.
             *
             * Reading TracerPid means calling open(), which is one of our own
             * shims and would ask this function again. Publish a provisional
             * "off" and raise jp_in_lookup so that nested call answers straight
             * away instead of recursing until the stack runs out. */
            pid_t t;
            e = 0;
            jp_in_lookup++;
            t = jp_self_tracer_raw();
            jp_in_lookup--;
            e = (t > 0) ? 1 : 0;
        }
    }
    return e;
}

static pid_t jp_root(void) {
    static pid_t r = -1;
    if (r < 0) {
        const char *e = getenv("JROOT_PROC_ROOT");
        long v = (e && *e) ? jnum(e) : -1;
        if (v > 0) {
            r = (pid_t)v;
        } else {
            /* Fall back to our tracer: inside a jail that is proot, which is
             * exactly the pid the variable would have carried. */
            pid_t t = jp_self_tracer_raw();
            r = (t > 0) ? t : 0;
        }
    }
    return r;
}

static int jp_all_digits(const char *s) {
    if (!s || !*s) return 0;
    for (; *s; s++) if (*s < '0' || *s > '9') return 0;
    return 1;
}

/* Field 4 of /proc/<pid>/stat is the ppid. comm (field 2) is parenthesised and
 * may itself contain spaces and parens, so scan from the LAST ')'. */
static pid_t jp_ppid(pid_t pid) {
    char path[64], buf[1024], *p;
    int fd;
    ssize_t n;
    snprintf(path, sizeof(path), "/proc/%d/stat", (int)pid);
    fd = open(path, O_RDONLY);
    if (fd < 0) return -1;
    n = read(fd, buf, sizeof(buf) - 1);
    close(fd);
    if (n <= 0) return -1;
    buf[n] = 0;
    p = strrchr(buf, ')');
    if (!p) return -1;
    p++;
    while (*p == ' ') p++;
    while (*p && *p != ' ') p++;      /* state */
    while (*p == ' ') p++;
    if (!*p) return -1;
    return (pid_t)jnum(p);
}

static pid_t jp_tracer(pid_t pid) {
    char path[64], buf[4096], *p;
    int fd;
    ssize_t n;
    snprintf(path, sizeof(path), "/proc/%d/status", (int)pid);
    fd = open(path, O_RDONLY);
    if (fd < 0) return -1;
    n = read(fd, buf, sizeof(buf) - 1);
    close(fd);
    if (n <= 0) return -1;
    buf[n] = 0;
    p = strstr(buf, "TracerPid:");
    if (!p) return -1;
    return (pid_t)jnum(p + 10);
}

/* Our own tracer is proot (it ptraces every guest process), so "same tracer as
 * me" identifies siblings in this jail without needing to know proot's pid.
 * 0 when we are not traced, e.g. the shim loaded outside a jail. */
static pid_t jp_my_tracer(void) {
    static pid_t t = -1;
    if (t < 0) {
        t = jp_tracer(getpid());
        if (t < 0) t = 0;
    }
    return t;
}

static int jp_member(pid_t pid) {
    pid_t root, mine, cur;
    int slot, depth, verdict = 0;

    /* Everything below reads /proc, and those reads must not come back through
     * the /proc filter - see jp_in_lookup. The guard goes up here rather than
     * lower down because jp_root() itself may read /proc/self/status. */
    jp_in_lookup++;
    root = jp_root();
    if (root <= 0) { jp_in_lookup--; return 1; }
    if (pid == root) { jp_in_lookup--; return 1; }
    slot = (int)(pid & 255);
    if (jp_cache_pid[slot] == (int)pid) { jp_in_lookup--; return jp_cache_val[slot]; }

    mine = jp_my_tracer();
    if (pid == mine) {
        verdict = 1;
    } else if (mine > 0 && jp_tracer(pid) == mine) {
        /* Traced by the same proot: a jail process, even if it double-forked
         * and got reparented to host pid 1. */
        verdict = 1;
    } else {
        cur = pid;
        for (depth = 0; depth < 128; depth++) {
            if (cur == root) { verdict = 1; break; }
            if (cur <= 1) break;
            cur = jp_ppid(cur);
            if (cur < 0) break;
        }
    }
    jp_in_lookup--;

    jp_cache_pid[slot] = (int)pid;
    jp_cache_val[slot] = (char)verdict;
    return verdict;
}

static void jp_dir_add(void *d) {
    int i;
    for (i = 0; i < JP_DIRS; i++) if (!jp_dirs[i]) { jp_dirs[i] = d; return; }
}

static int jp_dir_is_proc(void *d) {
    int i;
    for (i = 0; i < JP_DIRS; i++) if (jp_dirs[i] == d) return 1;
    return 0;
}

static void jp_dir_del(void *d) {
    int i;
    for (i = 0; i < JP_DIRS; i++) if (jp_dirs[i] == d) { jp_dirs[i] = NULL; return; }
}

static int jp_path_is_proc(const char *path) {
    char abs[8192], norm[8192];
    if (!path || !*path) return 0;
    if (path[0] != '/') {
        char cwd[8192];
        if (!getcwd(cwd, sizeof(cwd))) return 0;
        snprintf(abs, sizeof(abs), "%s/%s", cwd, path);
    } else {
        snprintf(abs, sizeof(abs), "%s", path);
    }
    norm_path(abs, norm, sizeof(norm));
    return strcmp(norm, "/proc") == 0;
}

/* Hide denied entries from directory listings. glibc's readdir() calls the
 * getdents64 SYSCALL directly (bypassing the exported symbol), so interpose
 * at the readdir level: skip any entry named ".jroot", and - when the stream
 * is the host /proc - any pid that is not part of this jail. */
