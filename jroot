/* ---- privilege-separation compatibility (opt-in) ----------------------- *
 * Some daemons harden themselves using operations a rootless jail simply
 * cannot perform, and they treat failure as fatal. OpenSSH is the clearest
 * example: its pre-auth child calls
 *     chroot("/run/sshd")
 * and dies with
 *     chroot("/run/sshd"): Operation not permitted [preauth]
 * closing every connection before the version banner. chroot(2) needs
 * CAP_SYS_CHROOT, which fake root does not provide, and OpenSSH removed
 * UsePrivilegeSeparation in 7.5, so there is no way to configure it off.
 *
 * When JROOT_FAKE_PRIVSEP is set, this shim reports success for exactly those
 * self-confinement steps:
 *     chroot()                 -> 0   (proot already confines the filesystem)
 *     prctl(PR_SET_SECCOMP)    -> 0   (jroot installed its own filter already)
 *     setgroups()/initgroups() -> 0   (no supplementary groups to drop)
 *
 * This is a deliberate, scoped trade: it removes a layer of the daemon's OWN
 * defence in depth, not any layer of the jail. The rootfs boundary still comes
 * from proot, the syscall filter from jroot's seccomp launcher, and the path
 * allowlist from Landlock - all of which remain in force. `jroot ssh` turns
 * this on for the sshd it starts; nothing else does.
 */
static int fake_privsep(void) {
    static int e = -1;
    if (e < 0) e = getenv("JROOT_FAKE_PRIVSEP") ? 1 : 0;
    return e;
}

typedef int (*chroot_fn)(const char *);

int chroot(const char *path) {
    static chroot_fn real = NULL;
    if (!real) real = (chroot_fn)dlsym(RTLD_NEXT, "chroot");
    if (fake_privsep()) return 0;
    if (!real) { errno = ENOSYS; return -1; }
    return real(path);
}

/* PR_SET_SECCOMP is 22 and PR_SET_NO_NEW_PRIVS is 38; only the former is
 * faked, because NO_NEW_PRIVS costs nothing and genuinely works. Four vararg
 * slots are always read: on the SysV ABIs jroot supports the register slots
 * exist whether or not the caller filled them, and unfilled ones are never
 * used because the option decides how many matter. */
typedef int (*prctl_fn)(int, unsigned long, unsigned long, unsigned long, unsigned long);

int prctl(int option, ...) {
    static prctl_fn real = NULL;
    unsigned long a1, a2, a3, a4;
    va_list ap;
    if (!real) real = (prctl_fn)dlsym(RTLD_NEXT, "prctl");
    va_start(ap, option);
    a1 = va_arg(ap, unsigned long);
    a2 = va_arg(ap, unsigned long);
    a3 = va_arg(ap, unsigned long);
    a4 = va_arg(ap, unsigned long);
    va_end(ap);
    if (option == PR_SET_SECCOMP && fake_privsep()) return 0;
    if (!real) { errno = ENOSYS; return -1; }
    return real(option, a1, a2, a3, a4);
}

