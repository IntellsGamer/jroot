#define SHIM_OPEN(name, sym)                                            \
int name(const char *path, int flags, ...) {                            \
    static open_fn real = NULL;                                         \
    if (!real) real = (open_fn)dlsym(RTLD_NEXT, sym);                   \
    if (path_is_denied(path)) return denied_errno();                    \
    if (want_write(flags) && path_is_ro(path)) return blocked_errno();  \
    va_list ap; va_start(ap, flags); mode_t mode = 0;                   \
    if (flags & O_CREAT) mode = va_arg(ap, mode_t);                     \
    va_end(ap);                                                         \
    if (flags & O_CREAT) return real(path, flags, mode);                \
    return real(path, flags);                                           \
}

SHIM_OPEN(open, "open")
SHIM_OPEN(open64, "open64")

#define SHIM_OPENAT(name, sym)                                          \
int name(int dirfd, const char *path, int flags, ...) {                 \
    static openat_fn real = NULL;                                       \
    if (!real) real = (openat_fn)dlsym(RTLD_NEXT, sym);                 \
    if (at_is_denied(dirfd, path)) return denied_errno();               \
    if (want_write(flags) && at_is_ro(dirfd, path)) return blocked_errno(); \
    va_list ap; va_start(ap, flags); mode_t mode = 0;                   \
    if (flags & O_CREAT) mode = va_arg(ap, mode_t);                     \
    va_end(ap);                                                         \
    if (flags & O_CREAT) return real(dirfd, path, flags, mode);         \
    return real(dirfd, path, flags);                                    \
}

SHIM_OPENAT(openat, "openat")
SHIM_OPENAT(openat64, "openat64")

#define SHIM_CREAT(name, sym)                                           \
int name(const char *path, mode_t mode) {                               \
    static creat_fn real = NULL;                                        \
    if (!real) real = (creat_fn)dlsym(RTLD_NEXT, sym);                  \
    DENY_OR_RO(path);                                                   \
    return real(path, mode);                                            \
