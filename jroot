#define SHIM_PATH(name, sym)                                            \
int name(const char *path) {                                            \
    static path_fn real = NULL;                                         \
    if (!real) real = (path_fn)dlsym(RTLD_NEXT, sym);                   \
    DENY_OR_RO(path);                                                   \
    return real(path);                                                  \
}

SHIM_PATH(rmdir, "rmdir")
SHIM_PATH(unlink, "unlink")

typedef int (*symlink_fn)(const char *, const char *);

int symlink(const char *target, const char *linkpath) {
    static symlink_fn real = NULL;
    if (!real) real = (symlink_fn)dlsym(RTLD_NEXT, "symlink");
    if (path_is_denied(linkpath)) return denied_errno();
    if (path_is_ro(linkpath)) return blocked_errno();
    return real(target, linkpath);
}

#define SHIM_MKDIR(name, sym)                                           \
int name(const char *path, mode_t mode) {                               \
    static path_mode_fn real = NULL;                                    \
    if (!real) real = (path_mode_fn)dlsym(RTLD_NEXT, sym);              \
    DENY_OR_RO(path);                                                   \
    return real(path, mode);                                            \
}

SHIM_MKDIR(mkdir, "mkdir")

typedef int (*mknod_fn)(const char *, mode_t, dev_t);

int mknod(const char *path, mode_t mode, dev_t dev) {
    static mknod_fn real = NULL;
    if (!real) real = (mknod_fn)dlsym(RTLD_NEXT, "mknod");
    if (path_is_denied(path)) return denied_errno();
    if (path_is_ro(path)) return blocked_errno();
    return real(path, mode, dev);
}

int rename(const char *oldpath, const char *newpath) {
    static rename_fn real = NULL;
    if (!real) real = (rename_fn)dlsym(RTLD_NEXT, "rename");
    if (path_is_denied(oldpath) || path_is_denied(newpath)) return denied_errno();
    if (path_is_ro(oldpath) || path_is_ro(newpath)) return blocked_errno();
    return real(oldpath, newpath);
}

int renameat(int od, const char *op, int nd, const char *np) {
